;;;; JSON: a writer into a foreign arena, and a strict parser over foreign memory that
;;;; finds a few named top-level fields without building any Lisp objects.
(in-package #:feed)

(declaim (optimize (speed 3) (safety 0) (debug 0)))

;;; ---- Writer ----------------------------------------------------------------------------
;;; The response arena: the body is written from +hdr-room+ on, then the header is written
;;; right-aligned just before it, so one send() covers header and body.

(defconstant +hdr-room+ 256)
(defconstant +arena-size+ (* 4 1024 1024))

(sb-ext:defglobal **w** 0)
(sb-ext:defglobal **wp** 0)
(declaim (type addr **w**) (type fixnum **wp**))

(declaim (inline w-byte w-octets))
(defun w-byte (b)
  (declare (type u8 b))
  (setf (a-ref-8 **w** **wp**) b)
  (incf **wp**))

(defun w-octets (v)
  (declare (type octets v))
  ;; An element loop, not copy-ub8-to-system-area: that call boxes a SAP (16 bytes) per use.
  (let ((n (length v)) (base (+ **w** **wp**)))
    (declare (type fixnum n) (type addr base))
    (dotimes (i n)
      (setf (a-ref-8 base i) (aref v i)))
    (incf **wp** n)))

(defmacro w-lit (s)
  `(w-octets (load-time-value (octets ,s) t)))

(defun w-sap (src n)
  "Raw copy of N bytes from foreign memory."
  (declare (type addr src) (type fixnum n))
  (%memmove (a+ **w** **wp**) src n)
  (incf **wp** n))

(defun w-int (n)
  (declare (type (signed-byte 64) n))
  (when (< n 0)
    (w-byte 45)
    (setf n (- n)))
  (if (< n 10)
      (w-byte (+ 48 n))
      (let ((digits 1) (p 10))
        (declare (type fixnum digits) (type (unsigned-byte 64) p))
        ;; digit count by comparison with powers of ten (no divide loop)
        (loop while (and (>= n p) (< digits 19))
              do (incf digits) (setf p (* p 10)))
        (let ((end (+ **wp** digits)) (m n))
          (declare (type fixnum end) (type (unsigned-byte 64) m))
          (setf **wp** end)
          (loop for i of-type fixnum from (1- end) downto (- end digits)
                do (multiple-value-bind (q r) (floor m 10)
                     (setf (a-ref-8 **w** i) (+ 48 r))
                     (setf m q)))))))

(declaim (inline word-clean-p))
(defun word-clean-p (x)
  "True when none of the 8 bytes of X is below 32, a double quote or a backslash (exact existence test)."
  (declare (type (unsigned-byte 64) x))
  (let* ((ones #x0101010101010101) (hi #x8080808080808080) (all #xFFFFFFFFFFFFFFFF)
         (lt32 (logand (ldb (byte 64 0) (- x (* ones 32))) (logxor x all)))
         (q (logxor x (* ones 34)))
         (b (logxor x (* ones 92)))
         (zq (logand (ldb (byte 64 0) (- q ones)) (logxor q all)))
         (zb (logand (ldb (byte 64 0) (- b ones)) (logxor b all))))
    (declare (type (unsigned-byte 64) lt32 q b zq zb))
    (zerop (logand (logior lt32 zq zb) hi))))

(defun w-json-string-body (src n)
  "N bytes of UTF-8 at SRC as the inside of a JSON string (JSON.stringify escaping)."
  (declare (type addr src) (type fixnum n))
  (let ((hex (load-time-value (the octets (octets "0123456789abcdef")) t))
        (start 0) (i 0))
    (declare (type fixnum start i))
    ;; runs of bytes that need no escape are copied with one memmove; clean words are skipped 8 at a time
    (loop
      (loop while (and (<= (+ i 8) n) (word-clean-p (a-ref-64 src i))) do (incf i 8))
      (when (>= i n) (return))
      (let ((b (ref src i)))
        (unless (and (>= b 32) (/= b 34) (/= b 92))
          (when (> i start) (w-sap (a+ src start) (- i start)))
          (setf start (1+ i))
          (cond ((= b 34) (w-byte 92) (w-byte 34))
                ((= b 92) (w-byte 92) (w-byte 92))
                ((= b 10) (w-byte 92) (w-byte (bc #\n)))
                ((= b 13) (w-byte 92) (w-byte (bc #\r)))
                ((= b 9) (w-byte 92) (w-byte (bc #\t)))
                ((= b 8) (w-byte 92) (w-byte (bc #\b)))
                ((= b 12) (w-byte 92) (w-byte (bc #\f)))
                (t (w-lit "\\u00") (w-byte (aref hex (ash b -4))) (w-byte (aref hex (logand b 15)))))))
      (incf i))
    (when (> n start) (w-sap (a+ src start) (- n start)))))

;;; ---- Parser ----------------------------------------------------------------------------

(declaim (inline hex-value))
(defun hex-value (b)
  (declare (type fixnum b))
  (cond ((<= 48 b 57) (- b 48))
        ((<= 97 b 102) (- b 87))
        ((<= 65 b 70) (- b 55))
        (t -1)))

(declaim (inline digit-p))
(defun digit-p (b) (declare (type fixnum b)) (<= 48 b 57))

(defun jskip-ws (sap pos end)
  (declare (type addr sap) (type fixnum pos end))
  (loop while (and (< pos end)
                   (let ((b (ref sap pos))) (or (= b 32) (= b 9) (= b 10) (= b 13))))
        do (incf pos))
  pos)

(defun jskip-string (sap pos end)
  "POS is at the opening quote. Returns the position after the closing quote, or -1."
  (declare (type addr sap) (type fixnum pos end))
  (incf pos)
  (loop
    (when (>= pos end) (return -1))
    (let ((b (ref sap pos)))
      (cond ((= b 34) (return (1+ pos)))
            ((< b 32) (return -1))
            ((= b 92)
             (incf pos)
             (when (>= pos end) (return -1))
             (let ((e (ref sap pos)))
               (cond ((= e (bc #\u))
                      (when (> (+ pos 5) end) (return -1))
                      (dotimes (k 4)
                        (when (< (hex-value (ref sap (+ pos 1 k))) 0) (return-from jskip-string -1)))
                      (incf pos 5))
                     ((member e '#.(mapcar #'char-code '(#\" #\\ #\/ #\b #\f #\n #\r #\t)))
                      (incf pos))
                     (t (return -1)))))
            (t (incf pos))))))

(defun jskip-number (sap pos end)
  (declare (type addr sap) (type fixnum pos end))
  (when (and (< pos end) (= (ref sap pos) 45)) (incf pos))
  (when (>= pos end) (return-from jskip-number -1))
  (let ((b (ref sap pos)))
    (cond ((= b 48) (incf pos))
          ((<= 49 b 57) (loop while (and (< pos end) (digit-p (ref sap pos))) do (incf pos)))
          (t (return-from jskip-number -1))))
  (when (and (< pos end) (= (ref sap pos) 46))
    (incf pos)
    (unless (and (< pos end) (digit-p (ref sap pos))) (return-from jskip-number -1))
    (loop while (and (< pos end) (digit-p (ref sap pos))) do (incf pos)))
  (when (and (< pos end) (or (= (ref sap pos) (bc #\e)) (= (ref sap pos) (bc #\E))))
    (incf pos)
    (when (and (< pos end) (or (= (ref sap pos) 43) (= (ref sap pos) 45))) (incf pos))
    (unless (and (< pos end) (digit-p (ref sap pos))) (return-from jskip-number -1))
    (loop while (and (< pos end) (digit-p (ref sap pos))) do (incf pos)))
  pos)

(defun jskip-literal (sap pos end lit)
  (declare (type addr sap) (type fixnum pos end) (type simple-string lit))
  (let ((n (length lit)))
    (if (and (<= (+ pos n) end)
             (dotimes (i n t) (unless (= (ref sap (+ pos i)) (char-code (char lit i))) (return nil))))
        (+ pos n)
        -1)))

(defun jskip-value (sap pos end depth)
  "Validates one JSON value starting at POS (after optional whitespace). Returns the position
after it, or -1 when it is malformed."
  (declare (type addr sap) (type fixnum pos end depth))
  (when (> depth 64) (return-from jskip-value -1))
  (setf pos (jskip-ws sap pos end))
  (when (>= pos end) (return-from jskip-value -1))
  (let ((b (ref sap pos)))
    (cond ((= b 34) (jskip-string sap pos end))
          ((= b 123)
           (setf pos (jskip-ws sap (1+ pos) end))
           (when (and (< pos end) (= (ref sap pos) 125)) (return-from jskip-value (1+ pos)))
           (loop
             (setf pos (jskip-ws sap pos end))
             (unless (and (< pos end) (= (ref sap pos) 34)) (return -1))
             (setf pos (jskip-string sap pos end))
             (when (< pos 0) (return -1))
             (setf pos (jskip-ws sap pos end))
             (unless (and (< pos end) (= (ref sap pos) 58)) (return -1))
             (setf pos (jskip-value sap (1+ pos) end (1+ depth)))
             (when (< pos 0) (return -1))
             (setf pos (jskip-ws sap pos end))
             (when (>= pos end) (return -1))
             (let ((c (ref sap pos)))
               (cond ((= c 44) (incf pos))
                     ((= c 125) (return (1+ pos)))
                     (t (return -1))))))
          ((= b 91)
           (setf pos (jskip-ws sap (1+ pos) end))
           (when (and (< pos end) (= (ref sap pos) 93)) (return-from jskip-value (1+ pos)))
           (loop
             (setf pos (jskip-value sap pos end (1+ depth)))
             (when (< pos 0) (return -1))
             (setf pos (jskip-ws sap pos end))
             (when (>= pos end) (return -1))
             (let ((c (ref sap pos)))
               (cond ((= c 44) (incf pos))
                     ((= c 93) (return (1+ pos)))
                     (t (return -1))))))
          ((= b (bc #\t)) (jskip-literal sap pos end "true"))
          ((= b (bc #\f)) (jskip-literal sap pos end "false"))
          ((= b (bc #\n)) (jskip-literal sap pos end "null"))
          ((or (= b 45) (digit-p b)) (jskip-number sap pos end))
          (t -1))))

;;; Field extraction: the caller sets **json-names** (a vector of octet vectors); after
;;; JSON-FIND-FIELDS, slot i of **jf-type** says what "name i" was (0 absent, 1 string, 2 number,
;;; 3 anything else) and **jf-start**/**jf-end** give its value (string contents without quotes,
;;; still escaped). The last duplicate key wins.

(defconstant +max-fields+ 8)
(sb-ext:defglobal **json-names** (vector))
(sb-ext:defglobal **jf-type** (make-array +max-fields+ :element-type 'fixnum :initial-element 0))
(sb-ext:defglobal **jf-start** (make-array +max-fields+ :element-type 'fixnum :initial-element 0))
(sb-ext:defglobal **jf-end** (make-array +max-fields+ :element-type 'fixnum :initial-element 0))
(declaim (type simple-vector **json-names**)
         (type (simple-array fixnum (*)) **jf-type** **jf-start** **jf-end**))

(defun key-matches-p (sap start end name)
  (declare (type addr sap) (type fixnum start end) (type octets name))
  (and (= (- end start) (length name))
       (dotimes (i (length name) t)
         (unless (= (ref sap (+ start i)) (aref name i)) (return nil)))))

(defun json-find-fields (sap len)
  "0 = ok (top level is an object), 1 = malformed JSON, 2 = valid JSON that is not an object."
  (declare (type addr sap) (type fixnum len))
  (fill **jf-type** 0)
  (let ((pos (jskip-ws sap 0 len)))
    (declare (type fixnum pos))
    (when (>= pos len) (return-from json-find-fields 1))
    (unless (= (ref sap pos) 123)
      (let ((e (jskip-value sap pos len 0)))
        (return-from json-find-fields
          (if (and (>= e 0) (= (jskip-ws sap e len) len)) 2 1))))
    (incf pos)
    (setf pos (jskip-ws sap pos len))
    (if (and (< pos len) (= (ref sap pos) 125))
        (incf pos)
        (loop
          (setf pos (jskip-ws sap pos len))
          (unless (and (< pos len) (= (ref sap pos) 34)) (return-from json-find-fields 1))
          (let ((kstart (1+ pos)))
            (setf pos (jskip-string sap pos len))
            (when (< pos 0) (return-from json-find-fields 1))
            (let ((kend (1- pos)))
              (setf pos (jskip-ws sap pos len))
              (unless (and (< pos len) (= (ref sap pos) 58)) (return-from json-find-fields 1))
              (setf pos (jskip-ws sap (1+ pos) len))
              (when (>= pos len) (return-from json-find-fields 1))
              (let* ((vstart pos)
                     (vend (jskip-value sap pos len 1)))
                (declare (type fixnum vstart vend))
                (when (< vend 0) (return-from json-find-fields 1))
                (dotimes (i (length **json-names**))
                  (when (key-matches-p sap kstart kend (svref **json-names** i))
                    (let ((b (ref sap vstart)))
                      (cond ((= b 34)
                             (setf (aref **jf-type** i) 1
                                   (aref **jf-start** i) (1+ vstart)
                                   (aref **jf-end** i) (1- vend)))
                            (t
                             (setf (aref **jf-type** i) (if (or (= b 45) (digit-p b)) 2 3)
                                   (aref **jf-start** i) vstart
                                   (aref **jf-end** i) vend)))))
                  )
                (setf pos (jskip-ws sap vend len))
                (when (>= pos len) (return-from json-find-fields 1))
                (let ((c (ref sap pos)))
                  (cond ((= c 44) (incf pos))
                        ((= c 125) (incf pos) (return))
                        (t (return-from json-find-fields 1)))))))))
    (if (= (jskip-ws sap pos len) len) 0 1)))

;;; ---- String unescaping -----------------------------------------------------------------

(defun utf8-encode (cp dst o)
  (declare (type addr dst) (type fixnum cp o))
  (flet ((put (b) (setf (a-ref-8 dst o) b) (incf o)))
    (cond ((< cp #x80) (put cp))
          ((< cp #x800) (put (logior #xC0 (ash cp -6))) (put (logior #x80 (logand cp #x3F))))
          ((< cp #x10000) (put (logior #xE0 (ash cp -12)))
           (put (logior #x80 (logand (ash cp -6) #x3F))) (put (logior #x80 (logand cp #x3F))))
          (t (put (logior #xF0 (ash cp -18))) (put (logior #x80 (logand (ash cp -12) #x3F)))
             (put (logior #x80 (logand (ash cp -6) #x3F))) (put (logior #x80 (logand cp #x3F))))))
  o)

(defun hex4 (sap i)
  (declare (type addr sap) (type fixnum i))
  (logior (ash (hex-value (ref sap i)) 12) (ash (hex-value (ref sap (+ i 1))) 8)
          (ash (hex-value (ref sap (+ i 2))) 4) (hex-value (ref sap (+ i 3)))))

(defun json-unescape (sap start end dst)
  "Decodes the (already validated) string contents SAP[START,END) into DST. Returns the length."
  (declare (type addr sap dst) (type fixnum start end))
  (let ((i start) (o 0))
    (declare (type fixnum i o))
    (loop while (< i end)
          do (let ((b (ref sap i)))
               (cond
                 ((/= b 92) (setf (a-ref-8 dst o) b) (incf o) (incf i))
                 (t
                  (let ((e (ref sap (1+ i))))
                    (incf i 2)
                    (flet ((put (x) (setf (a-ref-8 dst o) x) (incf o)))
                      (cond ((= e (bc #\n)) (put 10))
                            ((= e (bc #\t)) (put 9))
                            ((= e (bc #\r)) (put 13))
                            ((= e (bc #\b)) (put 8))
                            ((= e (bc #\f)) (put 12))
                            ((= e (bc #\u))
                             (let ((cp (hex4 sap i)))
                               (declare (type fixnum cp))
                               (incf i 4)
                               (cond ((<= #xD800 cp #xDBFF)
                                      (let ((lo (and (<= (+ i 6) end) (= (ref sap i) 92) (= (ref sap (1+ i)) (bc #\u))
                                                     (hex4 sap (+ i 2)))))
                                        (cond ((and lo (<= #xDC00 lo #xDFFF))
                                               (incf i 6)
                                               (setf cp (+ #x10000 (ash (- cp #xD800) 10) (- lo #xDC00))))
                                              (t (setf cp #xFFFD)))))
                                     ((<= #xDC00 cp #xDFFF) (setf cp #xFFFD)))
                               (setf o (utf8-encode cp dst o))))
                            (t (put e)))))))))
    o))
