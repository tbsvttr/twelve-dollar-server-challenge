;;;; Routing and handlers. Fixed error responses are complete octet vectors built at compile time;
;;;; check order on authenticated routes is auth, then id, then body.
(in-package #:feed)

(declaim (optimize (speed 3) (safety 0) (debug 0)))

(defresponse +r-not-found+ 404 "not found")
(defresponse +r-invalid-id+ 400 "invalid post id")
(defresponse +r-post-not-found+ 404 "post not found")
(defresponse +r-missing-token+ 401 "missing bearer token")
(defresponse +r-invalid-token+ 401 "invalid or expired token")
(defresponse +r-invalid-payload+ 401 "invalid token payload")
(defresponse +r-malformed+ 400 "malformed JSON body")
(defresponse +r-body-required+ 400 "body is required")
(defresponse +r-body-too-long+ 400 "body must be at most 500 characters")
(defresponse +r-internal+ 500 "internal server error")
(defresponse +r-bad-request+ 400 "bad request")
(defresponse +r-too-large+ 413 "request too large")
(defraw-response +r-continue+
  #.(concatenate 'string "HTTP/1.1 100 Continue" (crlf) (crlf)))

(sb-ext:defglobal **now** 0)              ; unix seconds, refreshed once per loop wake-up
(sb-ext:defglobal **started** 0)
(declaim (type fixnum **now** **started**))

(defmacro path-is (buf ps pe lit)
  `(and (= (- ,pe ,ps) ,(length lit))
        ,@(loop for i from 0 below (length lit)
                collect `(= (ref ,buf (+ ,ps ,i)) ,(char-code (char lit i))))))

(defmacro path-starts (buf ps pe lit)
  `(and (>= (- ,pe ,ps) ,(length lit))
        ,@(loop for i from 0 below (length lit)
                collect `(= (ref ,buf (+ ,ps ,i)) ,(char-code (char lit i))))))

(defun parse-id (buf s e)
  "Positive integer from digits only: the id; 0 for a syntactically invalid id; -1 when it is a
valid number too large to exist."
  (declare (type addr buf) (type fixnum s e))
  (when (= s e) (return-from parse-id 0))
  (loop for i of-type fixnum from s below e
        do (unless (digit-p (ref buf i)) (return-from parse-id 0)))
  (if (> (- e s) 18)
      (if (loop for i of-type fixnum from s below e always (= (ref buf i) 48)) 0 -1)
      (parse-uint buf s e)))

(defun reply-db-result (rc status)
  (declare (type fixnum rc))
  (cond ((= rc +db-ok+) (finish-dynamic-from-status status))
        ((= rc +db-missing+) (respond-fixed +r-post-not-found+))
        (t (respond-fixed +r-internal+))))

(defun finish-dynamic-from-status (status)
  (declare (type fixnum status))
  (case status
    (200 (finish-dynamic 200))
    (201 (finish-dynamic 201))
    (t (finish-dynamic 200))))

(defun auth-failure (uid)
  (declare (type fixnum uid))
  (cond ((= uid +auth-missing+) (respond-fixed +r-missing-token+))
        ((= uid +auth-invalid+) (respond-fixed +r-invalid-token+))
        (t (respond-fixed +r-invalid-payload+))))

(defun trim-bounds (buf n)
  "Bounds (values start end) of BUF[0,N) after trimming JS-style whitespace."
  (declare (type addr buf) (type fixnum n))
  (let ((s 0) (e n))
    (declare (type fixnum s e))
    (flet ((ws-at (i)
             ;; length of the whitespace character starting at I, or 0
             (let ((b (ref buf i)))
               (cond ((or (= b 32) (<= 9 b 13)) 1)
                     ((and (= b #xC2) (< (+ i 1) e) (= (ref buf (+ i 1)) #xA0)) 2)
                     ((and (= b #xEF) (< (+ i 2) e) (= (ref buf (+ i 1)) #xBB) (= (ref buf (+ i 2)) #xBF)) 3)
                     ((and (= b #xE2) (< (+ i 2) e))
                      (let ((b1 (ref buf (+ i 1))) (b2 (ref buf (+ i 2))))
                        (cond ((and (= b1 #x80) (or (<= #x80 b2 #x8A) (= b2 #xA8) (= b2 #xA9) (= b2 #xAF))) 3)
                              ((and (= b1 #x81) (= b2 #x9F)) 3)
                              (t 0))))
                     ((and (= b #xE3) (< (+ i 2) e) (= (ref buf (+ i 1)) #x80) (= (ref buf (+ i 2)) #x80)) 3)
                     ((and (= b #xE1) (< (+ i 2) e) (= (ref buf (+ i 1)) #x9A) (= (ref buf (+ i 2)) #x80)) 3)
                     (t 0)))))
      (loop (let ((k (if (< s e) (ws-at s) 0))) (if (> k 0) (incf s k) (return))))
      ;; trailing: try each possible start of a whitespace character ending exactly at E
      (loop
        (let ((k 0))
          (declare (type fixnum k))
          (loop for len of-type fixnum from 1 to 3
                do (let ((i (- e len)))
                     (when (and (>= i s) (= (let ((save e)) (declare (ignorable save)) (ws-at i)) len))
                       (setf k len) (return))))
          (if (> k 0) (decf e k) (return)))))
    (values s e)))

(defun count-chars (buf s e)
  (declare (type addr buf) (type fixnum s e))
  (let ((n 0))
    (declare (type fixnum n))
    (loop for i of-type fixnum from s below e
          do (when (/= (logand (ref buf i) #xC0) #x80) (incf n)))
    n))

(sb-ext:defglobal **names-body** (vector (octets "body")))
(declaim (type simple-vector **names-body**))

(defun route-create-post (buf)
  (declare (type addr buf))
  (let ((uid (authenticate **req-auth-s** **req-auth-e** buf **now**)))
    (declare (type fixnum uid))
    (when (<= uid 0) (return-from route-create-post (auth-failure uid)))
    (let* ((body (a+ buf **req-head**))
           (n **req-clen**))
      (setf **json-names** **names-body**)
      (let ((rc (json-find-fields body n)))
        (declare (type fixnum rc))
        (cond ((= rc 1) (respond-fixed +r-malformed+))
              ((or (= rc 2) (/= (aref **jf-type** 0) 1)) (respond-fixed +r-body-required+))
              (t
               (let ((len (json-unescape body (aref **jf-start** 0) (aref **jf-end** 0) **body-buf**)))
                 (declare (type fixnum len))
                 (multiple-value-bind (s e) (trim-bounds **body-buf** len)
                   (declare (type fixnum s e))
                   (cond ((= s e) (respond-fixed +r-body-required+))
                         ((> (count-chars **body-buf** s e) 500) (respond-fixed +r-body-too-long+))
                         (t
                          (setf **wp** +hdr-room+)
                          (let ((rc (db-insert-post uid (a+ **body-buf** s) (- e s))))
                            (if (= rc +db-ok+)
                                (finish-dynamic 201)
                                (respond-fixed +r-internal+)))))))))))))

(defun route-like (buf id-s id-e)
  (declare (type addr buf) (type fixnum id-s id-e))
  (let ((uid (authenticate **req-auth-s** **req-auth-e** buf **now**)))
    (declare (type fixnum uid))
    (when (<= uid 0) (return-from route-like (auth-failure uid)))
    (let ((id (parse-id buf id-s id-e)))
      (declare (type fixnum id))
      (cond ((= id 0) (respond-fixed +r-invalid-id+))
            ((< id 0) (respond-fixed +r-post-not-found+))
            (t
             (let ((ex (db-post-exists id)))
               (cond ((= ex +db-missing+) (respond-fixed +r-post-not-found+))
                     ((/= ex +db-ok+) (respond-fixed +r-internal+))
                     (t
                      (let ((r (db-like uid id)))
                        (declare (type fixnum r))
                        (cond ((= r +db-error+) (respond-fixed +r-internal+))
                              (t
                               (setf **wp** +hdr-room+)
                               (if (= r 1)
                                   (w-lit "{\"liked\":true,\"already_liked\":false,\"post_id\":")
                                   (w-lit "{\"liked\":true,\"already_liked\":true,\"post_id\":"))
                               (w-int id)
                               (w-byte (bc #\}))
                               (if (= r 1) (finish-dynamic 201) (finish-dynamic 200)))))))))))))

(defun route-health ()
  (setf **wp** +hdr-room+)
  (cond ((= (db-health) +db-ok+)
         (w-lit "{\"status\":\"ok\",\"db\":\"ok\",\"uptime_s\":")
         (w-int (max 0 (- **now** **started**)))
         (w-byte (bc #\}))
         (finish-dynamic 200))
        (t (finish-dynamic 503))))

(defun handle-request (buf)
  "Routes the request that PARSE-REQUEST just parsed at BUF; leaves the response in **out-addr/len**."
  (declare (type addr buf))
  (let ((m **req-method**) (ps **req-ps**) (pe **req-pe**))
    (declare (type fixnum m ps pe))
    (cond
      ((path-is buf ps pe "/health")
       (if (= m 0) (route-health) (respond-fixed +r-not-found+)))
      ((path-is buf ps pe "/feed")
       (cond ((= m 0)
              (setf **wp** +hdr-room+)
              (if (= (db-feed) +db-ok+) (finish-dynamic 200) (respond-fixed +r-internal+)))
             (t (respond-fixed +r-not-found+))))
      ((path-is buf ps pe "/posts")
       (if (= m 1) (route-create-post buf) (respond-fixed +r-not-found+)))
      ((path-starts buf ps pe "/posts/")
       (let* ((id-s (+ ps 7)) (id-e id-s))
         (declare (type fixnum id-s id-e))
         (loop while (and (< id-e pe) (/= (ref buf id-e) 47)) do (incf id-e))
         (cond
           ((= id-e id-s) (respond-fixed +r-not-found+))
           ((= id-e pe)
            (if (= m 0)
                (let ((id (parse-id buf id-s id-e)))
                  (declare (type fixnum id))
                  (cond ((= id 0) (respond-fixed +r-invalid-id+))
                        ((< id 0) (respond-fixed +r-post-not-found+))
                        (t (setf **wp** +hdr-room+)
                           (reply-db-result (db-get-post id) 200))))
                (respond-fixed +r-not-found+)))
           ((and (= m 1) (path-is buf id-e pe "/like"))
            (route-like buf id-s id-e))
           (t (respond-fixed +r-not-found+)))))
      (t (respond-fixed +r-not-found+)))))
