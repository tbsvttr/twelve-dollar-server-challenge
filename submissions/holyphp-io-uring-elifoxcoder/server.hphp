<?php
/* server.hphp — the twelve-dollar feed API, written in HolyPHP.
 *
 * Everything the challenge measures lives in this file:
 *
 *   - the HTTP/1.1 keep-alive loop on top of the runtime's non-blocking
 *     socket primitives (stream_ready / stream_recv / stream_send),
 *   - request parsing and routing,
 *   - HS256 JWT verification (hash_hmac + hash_equals, on every request),
 *   - strict JSON request validation (the runtime's json_decode is lenient,
 *     so POST bodies go through the small parser below),
 *   - all SQL, including the SQLite JSON1 calls that render the response
 *     bodies inside the query,
 *   - the write policy: writes are collected during one poll cycle, applied
 *     in a single BEGIN IMMEDIATE … COMMIT (group commit), and only then is
 *     a 2xx sent.
 *
 * The native side is deliberately generic: sockets, HMAC, and a plain
 * SQLite binding. There is no challenge-specific C code.
 *
 * Config comes from the four SPEC.md variables:
 *   SQLITE_PATH, JWT_SECRET, HOST, PORT
 */

/* Strict RFC 8259 parser, used for POST /posts bodies. */
class Json {
    pub string $s;
    pub int $n;
    pub int $i;
    pub bool $ok;
    pub int $depth;
    pub $root = null;

    public function __construct(string $s) {
        $this->s = $s;
        $this->n = strlen($s);
        $this->i = 0;
        $this->ok = true;
        $this->depth = 0;
    }

    public function parse(): bool {
        $this->root = $this->value();
        if (!$this->ok) { return false; }
        $this->ws();
        return $this->i == $this->n;
    }

    public function ws(): void {
        while ($this->i < $this->n) {
            $c = $this->s[$this->i];
            if ($c == " " || $c == "\t" || $c == "\n" || $c == "\r") {
                $this->i = $this->i + 1;
            } else {
                return;
            }
        }
    }

    public function value() {
        $this->ws();
        if ($this->i >= $this->n) { $this->ok = false; return null; }
        $c = $this->s[$this->i];
        if ($c == "{") { return $this->object(); }
        if ($c == "[") { return $this->arr(); }
        if ($c == "\"") { return $this->str(); }
        if ($c == "t") { if ($this->lit("true")) { return true; } $this->ok = false; return null; }
        if ($c == "f") { if ($this->lit("false")) { return false; } $this->ok = false; return null; }
        if ($c == "n") { if ($this->lit("null")) { return null; } $this->ok = false; return null; }
        if ($c == "-" || ($c >= "0" && $c <= "9")) { return $this->num(); }
        $this->ok = false;
        return null;
    }

    public function lit(string $w): bool {
        $l = strlen($w);
        if ($this->i + $l > $this->n) { return false; }
        if (substr($this->s, $this->i, $l) != $w) { return false; }
        $this->i = $this->i + $l;
        return true;
    }

    public function object() {
        $this->depth = $this->depth + 1;
        if ($this->depth > 64) { $this->ok = false; return []; }
        $this->i = $this->i + 1;
        $out = [];
        $this->ws();
        if ($this->i < $this->n && $this->s[$this->i] == "}") {
            $this->i = $this->i + 1;
            $this->depth = $this->depth - 1;
            return $out;
        }
        while (true) {
            $this->ws();
            if ($this->i >= $this->n || $this->s[$this->i] != "\"") { $this->ok = false; return $out; }
            $k = $this->str();
            if (!$this->ok) { return $out; }
            $this->ws();
            if ($this->i >= $this->n || $this->s[$this->i] != ":") { $this->ok = false; return $out; }
            $this->i = $this->i + 1;
            $v = $this->value();
            if (!$this->ok) { return $out; }
            $out[$k] = $v;
            $this->ws();
            if ($this->i >= $this->n) { $this->ok = false; return $out; }
            $c = $this->s[$this->i];
            if ($c == ",") { $this->i = $this->i + 1; continue; }
            if ($c == "}") {
                $this->i = $this->i + 1;
                $this->depth = $this->depth - 1;
                return $out;
            }
            $this->ok = false;
            return $out;
        }
    }

    public function arr() {
        $this->depth = $this->depth + 1;
        if ($this->depth > 64) { $this->ok = false; return []; }
        $this->i = $this->i + 1;
        $out = [];
        $this->ws();
        if ($this->i < $this->n && $this->s[$this->i] == "]") {
            $this->i = $this->i + 1;
            $this->depth = $this->depth - 1;
            return $out;
        }
        while (true) {
            $v = $this->value();
            if (!$this->ok) { return $out; }
            $out[] = $v;
            $this->ws();
            if ($this->i >= $this->n) { $this->ok = false; return $out; }
            $c = $this->s[$this->i];
            if ($c == ",") { $this->i = $this->i + 1; continue; }
            if ($c == "]") {
                $this->i = $this->i + 1;
                $this->depth = $this->depth - 1;
                return $out;
            }
            $this->ok = false;
            return $out;
        }
    }

    public function str() {
        if ($this->i >= $this->n || $this->s[$this->i] != "\"") { $this->ok = false; return ""; }
        $this->i = $this->i + 1;
        $out = "";
        while ($this->i < $this->n) {
            $c = $this->s[$this->i];
            $this->i = $this->i + 1;
            if ($c == "\"") { return $out; }
            if ($c == chr(92)) {
                if ($this->i >= $this->n) { $this->ok = false; return ""; }
                $e = $this->s[$this->i];
                $this->i = $this->i + 1;
                if ($e == "\"") { $out .= "\""; }
                else if ($e == chr(92)) { $out .= chr(92); }
                else if ($e == "/") { $out .= "/"; }
                else if ($e == "b") { $out .= chr(8); }
                else if ($e == "f") { $out .= chr(12); }
                else if ($e == "n") { $out .= "\n"; }
                else if ($e == "r") { $out .= "\r"; }
                else if ($e == "t") { $out .= "\t"; }
                else if ($e == "u") {
                    $cp = $this->hex4();
                    if (!$this->ok) { return ""; }
                    if ($cp >= 55296 && $cp <= 56319) {
                        if ($this->i + 1 < $this->n
                            && $this->s[$this->i] == chr(92) && $this->s[$this->i + 1] == "u") {
                            $this->i = $this->i + 2;
                            $lo = $this->hex4();
                            if (!$this->ok || $lo < 56320 || $lo > 57343) { $this->ok = false; return ""; }
                            $cp = 65536 + (($cp - 55296) << 10) + ($lo - 56320);
                        } else {
                            $this->ok = false;
                            return "";
                        }
                    } else if ($cp >= 56320 && $cp <= 57343) {
                        $this->ok = false;
                        return "";
                    }
                    $out .= $this->utf8($cp);
                } else {
                    $this->ok = false;
                    return "";
                }
            } else if (ord($c) < 32) {
                $this->ok = false;
                return "";
            } else {
                $out .= $c;
            }
        }
        $this->ok = false;
        return "";
    }

    public function hex4(): int {
        if ($this->i + 4 > $this->n) { $this->ok = false; return 0; }
        $v = 0;
        for ($k = 0; $k < 4; $k++) {
            $c = $this->s[$this->i + $k];
            $d = -1;
            if ($c >= "0" && $c <= "9") { $d = ord($c) - 48; }
            else if ($c >= "a" && $c <= "f") { $d = ord($c) - 87; }
            else if ($c >= "A" && $c <= "F") { $d = ord($c) - 55; }
            if ($d < 0) { $this->ok = false; return 0; }
            $v = $v * 16 + $d;
        }
        $this->i = $this->i + 4;
        return $v;
    }

    public function utf8(int $cp): string {
        if ($cp < 128) { return chr($cp); }
        if ($cp < 2048) {
            return chr(192 + ($cp >> 6)) . chr(128 + ($cp & 63));
        }
        if ($cp < 65536) {
            return chr(224 + ($cp >> 12)) . chr(128 + (($cp >> 6) & 63)) . chr(128 + ($cp & 63));
        }
        return chr(240 + ($cp >> 18)) . chr(128 + (($cp >> 12) & 63))
             . chr(128 + (($cp >> 6) & 63)) . chr(128 + ($cp & 63));
    }

    public function num() {
        if ($this->i < $this->n && $this->s[$this->i] == "-") { $this->i = $this->i + 1; }
        if ($this->i >= $this->n) { $this->ok = false; return 0; }
        $c = $this->s[$this->i];
        if ($c == "0") {
            $this->i = $this->i + 1;
        } else if ($c >= "1" && $c <= "9") {
            while ($this->i < $this->n) {
                $c = $this->s[$this->i];
                if ($c >= "0" && $c <= "9") { $this->i = $this->i + 1; } else { break; }
            }
        } else {
            $this->ok = false;
            return 0;
        }
        if ($this->i < $this->n && $this->s[$this->i] == ".") {
            $this->i = $this->i + 1;
            $d = 0;
            while ($this->i < $this->n) {
                $c = $this->s[$this->i];
                if ($c >= "0" && $c <= "9") { $this->i = $this->i + 1; $d = $d + 1; } else { break; }
            }
            if ($d == 0) { $this->ok = false; return 0; }
        }
        if ($this->i < $this->n && ($this->s[$this->i] == "e" || $this->s[$this->i] == "E")) {
            $this->i = $this->i + 1;
            if ($this->i < $this->n && ($this->s[$this->i] == "+" || $this->s[$this->i] == "-")) {
                $this->i = $this->i + 1;
            }
            $d = 0;
            while ($this->i < $this->n) {
                $c = $this->s[$this->i];
                if ($c >= "0" && $c <= "9") { $this->i = $this->i + 1; $d = $d + 1; } else { break; }
            }
            if ($d == 0) { $this->ok = false; return 0; }
        }
        return 0;
    }
}

/* --------------------------------------------------------------- server */

class Server {
    pub int $srv = 0;
    pub int $db = 0;
    pub string $secret = "";
    pub string $jwtVerifier = "";
    pub int $start = 0;
    pub int $sweep = 0;
    pub bool $bgCheckpoint = false;

    /* per-connection state, keyed by socket fd. socks/lasts are fixed-size
     * int64 arrays indexed by fd (8 bytes a slot, one pointer add) instead of
     * hash maps of boxed hvals: at 15k connections the maps' cache footprint
     * was the floor's biggest cost. 0 means "absent". */
    pub int $socks = 0;
    pub int $lasts = 0;
    pub int $nconn = 0;
    pub array $bufs = [];

    /* deferred writes for the current poll cycle */
    pub array $pending = [];

    /* ready list, kept between rounds so a round allocates no array */
    pub array $ready = [];
    pub int $readyIds = 0;
    pub int $writableIds = 0;
    pub bool $fdArrays = false;

    /* response header prefixes per status code, built once */
    pub array $hdr = [];

    /* B-tree cursors for the feed fast path (0 when unavailable) */
    pub int $btPosts = 0;
    pub int $btFeed = 0;
    pub int $btLikes = 0;
    pub int $btUsers = 0;

    /* Connection shedding: computed from the process's real fd limit */
    pub int $shedAt = 58000;
    pub int $paused = 0;
    pub int $idleTimeout = 90;
    pub int $idleSweep = 0;

    /* Responses that did not fit into the socket buffer: the rest is written
     * when epoll reports EPOLLOUT instead of sleeping in the loop. */
    pub array $out = [];
    pub array $closing = [];
    pub array $writable = [];

    /* Idle sweep, a slice per cycle instead of one O(n) pass */
    pub array $sockList = [];
    pub int $sweepPos = 0;

    pub int $feed = 0;
    pub int $post = 0;
    pub int $health = 0;
    pub int $likecnt = 0;
    pub int $insPost = 0;
    pub int $insLike = 0;
    pub int $hasPost = 0;
    /* prepared transaction control: sqlite3_exec re-parses the SQL text on
     * every group commit, which showed up in the write profile */
    pub int $beginTx = 0;
    pub int $commitTx = 0;
    pub int $rollbackTx = 0;

    /* Operator introspection: leapfrogged only when HPHP_STATS=1 (the run
     * scripts never set it, so bench requests pay exactly zero for this). */
    pub bool $statsmode = false;
    pub bool $ring = false;
    pub bool $feedjson = false;
    pub bool $feedBatchAuthors = false;
    pub bool $feedBatchUsers = false;
    pub bool $postSendBuilder = false;
    pub bool $sparseBufs = false;
    pub int $reqs = 0;
    pub int $reqsBase = 0;

    /* ------------------------------------------------------- setup */

    public function open_bt_cursors(): void {
        if ($this->btPosts == 0) { $this->btPosts = bt_open($this->db, "posts", 0); }
        if ($this->btFeed == 0) { $this->btFeed = bt_open($this->db, "posts_created_at_id_idx", 1); }
        if ($this->btLikes == 0) { $this->btLikes = bt_open($this->db, "likes_post_id_idx", 1); }
        if ($this->btUsers == 0) { $this->btUsers = bt_open($this->db, "users", 0); }
    }

    public function close_bt_cursors(): void {
        if ($this->btPosts != 0) { bt_close($this->btPosts); $this->btPosts = 0; }
        if ($this->btFeed != 0) { bt_close($this->btFeed); $this->btFeed = 0; }
        if ($this->btLikes != 0) { bt_close($this->btLikes); $this->btLikes = 0; }
        if ($this->btUsers != 0) { bt_close($this->btUsers); $this->btUsers = 0; }
    }

    public function open(string $host, int $port): bool {
        $path = getenv("SQLITE_PATH");
        if ($path === false || $path == "") { $path = "feed.db"; }
        $sec = getenv("JWT_SECRET");
        if ($sec === false || $sec == "") { $sec = "twelve-dollar-challenge"; }
        $this->secret = $sec;
        $this->jwtVerifier = jwt_verifier_new($sec);
        $this->postSendBuilder = (getenv("HPHP_POST_SB") == "1");
        if (getenv("HPHP_STATS") == "1") { $this->statsmode = true; }
        $idleEnv = getenv("HPHP_IDLE_TIMEOUT");
        if ($idleEnv != "") {
            $idleSecs = intval($idleEnv);
            if ($idleSecs >= 1 && $idleSecs <= 3600) { $this->idleTimeout = $idleSecs; }
        }

        $bgCheckpoint = getenv("HPHP_BG_CHECKPOINT") == "1";
        $this->bgCheckpoint = $bgCheckpoint;
        $db = sqlite_open($path);
        if ($db == 0) {
            echo "fatal: cannot open sqlite database " . $path . "\n";
            return false;
        }
        $this->db = $db;
        sqlite_busy_timeout($db, 5000);
        sqlite_exec($db, "PRAGMA journal_mode=WAL");
        sqlite_exec($db, "PRAGMA synchronous=NORMAL");
        /* Both connections use SQLite's default unix VFS so they see the same
         * shared WAL index. The unix-excl VFS is for single-connection use. */
        if (!$bgCheckpoint) { sqlite_exec($db, "PRAGMA locking_mode=EXCLUSIVE"); }
        sqlite_exec($db, "PRAGMA temp_store=MEMORY");
        sqlite_exec($db, "PRAGMA cache_size=-65536");
        if (getenv("HPHP_MMAP") == "1") { sqlite_exec($db, "PRAGMA mmap_size=268435456"); }
        else { sqlite_exec($db, "PRAGMA mmap_size=0"); }
        sqlite_exec($db, "PRAGMA foreign_keys=OFF");
        if ($bgCheckpoint) {
            sqlite_exec($db, "PRAGMA wal_autocheckpoint=0");
            if (!sqlite_bg_checkpoint_start($db, $path, 4096, 250)) {
                echo "fatal: cannot start SQLite background checkpoint worker\n";
                return false;
            }
        } else {
            /* Keep occasional checkpoints in the event loop when the optional
             * worker is disabled. */
            sqlite_exec($db, "PRAGMA wal_autocheckpoint=4000");
        }

        /* The response bodies are rendered by SQLite's JSON1 functions, in
         * the exact key order the spec wants. The feed's ordering comes from
         * the input subquery; json_group_array appends rows in that order, so
         * no second sort inside the aggregate is needed.
         * (INSERT ... RETURNING needs SQLite >= 3.35; Ubuntu 24.04 has 3.45.) */
        $q = "SELECT '{' || '\"posts\":' || json_group_array(json_object("
           . "'id', p.id, 'body', p.body, 'created_at', p.created_at, "
           . "'author', p.author, "
           . "'like_count', (SELECT count(*) FROM likes l WHERE l.post_id = p.id)"
           . ") ) || '}' "
           . "FROM (SELECT p.id, p.body, p.created_at, u.username AS author "
           . "FROM posts p JOIN users u ON u.id = p.user_id "
           . "ORDER BY p.created_at DESC, p.id DESC LIMIT 20) p";
        $this->feed = sqlite_prepare($db, $q);
        if ($this->feed == 0) {
            echo "fatal: feed query: " . sqlite_errmsg($db) . "\n";
            return false;
        }

        $q = "SELECT json_object('post', json_object("
           . "'id', p.id, 'body', p.body, 'created_at', p.created_at, "
           . "'author', (SELECT username FROM users u WHERE u.id = p.user_id), "
           . "'like_count', (SELECT count(*) FROM likes l WHERE l.post_id = p.id)"
           . ")) FROM posts p WHERE p.id = ?1";
        $this->post = sqlite_prepare($db, $q);
        if ($this->post == 0) {
            echo "fatal: post query: " . sqlite_errmsg($db) . "\n";
            return false;
        }

        $this->health = sqlite_prepare($db, "SELECT 1");
        if ($this->health == 0) {
            echo "fatal: health query: " . sqlite_errmsg($db) . "\n";
            return false;
        }
        /* transaction control prepared once: sqlite3_exec re-parses the text
         * on every group commit (it showed up in the write profile) */
        $this->beginTx = sqlite_prepare($db, "BEGIN IMMEDIATE");
        $this->commitTx = sqlite_prepare($db, "COMMIT");
        $this->rollbackTx = sqlite_prepare($db, "ROLLBACK");

        /* one post's like count for the B-tree post path (index range scan) */
        $this->likecnt = sqlite_prepare($db, "SELECT count(*) FROM likes WHERE post_id = ?1");
        if ($this->likecnt == 0) {
            echo "fatal: like count query: " . sqlite_errmsg($db) . "\n";
            return false;
        }

        $q = "INSERT INTO posts (user_id, body) VALUES (?1, ?2) "
           . "RETURNING id, created_at";
        $this->insPost = sqlite_prepare($db, $q);
        if ($this->insPost == 0) {
            echo "fatal: insert post: " . sqlite_errmsg($db) . "\n";
            return false;
        }

        $q = "INSERT INTO likes (user_id, post_id) "
           . "SELECT ?1, ?2 WHERE EXISTS (SELECT 1 FROM posts WHERE id = ?2) "
           . "ON CONFLICT (user_id, post_id) DO NOTHING";
        $this->insLike = sqlite_prepare($db, $q);
        if ($this->insLike == 0) {
            echo "fatal: insert like: " . sqlite_errmsg($db) . "\n";
            return false;
        }

        $this->hasPost = sqlite_prepare($db, "SELECT 1 FROM posts WHERE id = ?1 LIMIT 1");
        if ($this->hasPost == 0) {
            echo "fatal: post exists query: " . sqlite_errmsg($db) . "\n";
            return false;
        }

        $addr = "tcp://" . $host . ":" . $port;
        $srv = stream_socket_server($addr);
        if ($srv === false || intval($srv) <= 0) {
            /* Direct mode failed (typically because Nginx already owns :80).
             * Fall back to the Nginx upstream address instead of dying, so
             * the service always comes up. */
            $addr = "tcp://127.0.0.1:3000";
            $srv = stream_socket_server($addr);
            if ($srv === false || intval($srv) <= 0) {
                echo "fatal: cannot listen on " . $host . ":" . $port . " or 127.0.0.1:3000\n";
                return false;
            }
        }
        $this->srv = intval($srv);
        /* TCP_NODELAY is inherited by accepted sockets on Linux, so set it
         * once on the listener instead of paying a setsockopt per accepted
         * connection (tens of thousands per second in the shed regime). */
        stream_set_nodelay($srv);
        epoll_add($this->srv);
        /* Handles are either real fds (< 65536) or direct-descriptor handles
         * (65536 + ring * 65536 + slot). The runtime supports eight rings;
         * reserve the full handle range even when fewer rings start. */
        $this->socks = iarr_new(655360);
        $this->idleSweep = 1;
        if (getenv("HPHP_IDLE_SWEEP") == "0") { $this->idleSweep = 0; }
        if ($this->idleSweep == 1) { $this->lasts = iarr_new(655360); }

        /* Shed only when the process is really near its descriptor limit.
         * The box sets LimitNOFILE; a hard 58,000 would close every response
         * once more than 58,000 users are connected. */
        $lim = nofile_limit();
        if (uring_direct()) {
            /* Ring-owned descriptors are not limited by RLIMIT_NOFILE and
             * one multishot recv per connection stays in flight, so neither
             * the fd limit nor the 28k armed-SQE ceiling applies. Shed just
             * below the registered table (which the kernel caps at NOFILE). */
            $this->shedAt = intval(uring_direct_slots()) - 1024;
            if ($this->shedAt < 1024) { $this->shedAt = 1024; }
        } elseif ($lim > 0) {
            $this->shedAt = $lim - 4096;
            if ($this->shedAt < 32000) { $this->shedAt = 32000; }
            if ($this->shedAt > $lim) { $this->shedAt = $lim; }
            /* The runtime flushes submitted SQEs as needed; multishot receives
             * do not reserve one SQ slot for each live connection. The real
             * descriptor limit, with this reserve, is the applicable cap. */
        }
        /* Operator override (tests, capacity experiments): the shed regime is
         * the churn regime, so being able to force it locally is how the
         * accept/close path gets measured without 28k live sockets. */
        $shedEnv = getenv("HPHP_SHED_AT");
        if ($shedEnv != "") {
            $sv = intval($shedEnv);
            if ($sv > 0) { $this->shedAt = $sv; }
        }

        $codes = [200, 201, 400, 401, 404, 500, 503];
        $texts = ["OK", "Created", "Bad Request", "Unauthorized",
                  "Not Found", "Internal Server Error", "Service Unavailable"];
        $this->ring = uring_active();
        $this->fdArrays = (getenv("HPHP_FD_ARRAYS") == "1");
        if ($this->fdArrays) {
            $this->readyIds = iarr_new(262144);
            $this->writableIds = iarr_new(262144);
        }
        /* A/B knob: HPHP_FEED=json forces the native JSON1 feed query instead
         * of the VM B-tree walk (operator measurement, unset in the bench). */
        $this->feedjson = (getenv("HPHP_FEED") == "json");
        $this->feedBatchAuthors = (getenv("HPHP_FEED_BATCH_AUTHORS") == "1");
        $this->feedBatchUsers = (getenv("HPHP_FEED_BATCH_USERS") == "1");
        /* The hot path does not need one empty PHP-array entry per idle
         * connection. Keep it opt-out so direct binary launches get the same
         * sparse receive-state layout as start.sh. */
        $this->sparseBufs = (getenv("HPHP_SPARSE_BUFS") != "0");
        for ($i = 0; $i < 7; $i++) {
            $this->hdr[$codes[$i]] = "HTTP/1.1 " . $codes[$i] . " " . $texts[$i]
                . "\r\nContent-Type: application/json\r\nContent-Encoding: identity"
                . "\r\nContent-Length: ";
        }
        $this->start = time();
        $this->sweep = $this->start;
        return true;
    }

    /* -------------------------------------------------------- main loop */

    public function handle_ready(): void {
        if ($this->fdArrays) {
            $i = 0; $n = iarr_len($this->writableIds);
            while ($i < $n) {
                $fd = iarr_get($this->writableIds, $i);
                if (isset($this->out[$fd])) { $this->flush_fd($fd); }
                $i = $i + 1;
            }
            $i = 0; $n = iarr_len($this->readyIds);
            while ($i < $n) {
                $fd = iarr_get($this->readyIds, $i);
                if ($fd == $this->srv) { $this->accept_all(); $i = $i + 1; continue; }
                if (!(iarr_get($this->socks, $fd) != 0)) { $i = $i + 1; continue; }
                if (isset($this->out[$fd])) { $i = $i + 1; continue; }
                $this->read_fd($fd);
                $i = $i + 1;
            }
            return;
        }
        /* finish pending responses before reading new requests */
        foreach ($this->writable as $w) {
            $fd = intval($w);
            if (isset($this->out[$fd])) { $this->flush_fd($fd); }
        }
        foreach ($this->ready as $h) {
            $fd = intval($h);
            if ($fd == $this->srv) { $this->accept_all(); continue; }
            if (!(iarr_get($this->socks, $fd) != 0)) { continue; }
            if (isset($this->out[$fd])) { continue; }   /* write still pending */
            $this->read_fd($fd);
        }
    }

    /* Write as much of the pending response as the socket takes; the rest
     * stays buffered until epoll reports the socket writable again. */
    public function flush_fd(int $fd): void {
        $data = $this->out[$fd];
        $sent = stream_send_nb($fd, $data);
        if ($sent == -2) { $this->close_fd($fd); return; }
        /* -1 is EAGAIN, not an error: the peer's window is momentarily full.
         * Keep the buffer and wait for the next EPOLLOUT. Closing here is what
         * made a slice of connections lose their response under load. */
        if ($sent < 0) { return; }
        if ($sent < strlen($data)) {
            $this->out[$fd] = substr($data, $sent);
            return;
        }
        unset($this->out[$fd]);
        if (isset($this->closing[$fd])) { $this->close_fd($fd); return; }
        if (!epoll_mod($fd, 1)) { $this->close_fd($fd); }
    }

    public function run(): void {
        while (true) {
            /* Everything allocated while serving this poll cycle is released
             * by scope_end(): no per-request malloc survives the round. */
            scope_begin();

            if ($this->fdArrays) { epoll_wait_iarr2($this->readyIds, $this->writableIds, 50); }
            else { epoll_wait2($this->ready, $this->writable, 50); }
            $this->handle_ready();
            /* A transaction has a fixed cost; when only a few writes are
             * pending, wait up to a millisecond for more requests before
             * committing. That batches them without hurting the tail much. */
            $n = count($this->pending);
            if ($n > 0 && $n < 32) {
                if ($this->fdArrays) { epoll_wait_iarr2($this->readyIds, $this->writableIds, 1); }
                else { epoll_wait2($this->ready, $this->writable, 1); }
                $this->handle_ready();
            }
            $this->execute_writes();
            /* Idle sweep: a bounded slice per cycle, so 110k sockets never
             * turn into one long stall. */
            if ($this->idleSweep == 1) { $this->expire(time()); }

            /* Match Rust's batch-scoped B-tree snapshot and release the read
             * transaction before the next poll/checkpoint opportunity. */
            $this->close_bt_cursors();

            scope_end();
        }
    }

    public function accept_all(): void {
        while (true) {
            $s = stream_socket_accept2($this->srv, 0);
            if ($s === false) {
                /* Only a real descriptor shortage may pause the listener. An
                 * accept that simply finds the queue empty (EAGAIN) must not:
                 * at the shedding threshold that stalled every reconnect. */
                if ($this->paused == 0 && accept_emfile()) {
                    epoll_del($this->srv);
                    $this->paused = 1;
                }
                return;
            }
            $fd = intval($s);
            if ($fd <= 0) { return; }
            iarr_set($this->socks, $fd, $fd);
            if (!$this->sparseBufs) { $this->bufs[$fd] = ""; }
            if ($this->idleSweep == 1) { iarr_set($this->lasts, $fd, time()); }
            $this->nconn = $this->nconn + 1;
            if ($this->idleSweep == 1) { $this->sockList[] = $fd; }
            epoll_add($fd);
        }
    }

    /* Nginx keeps idle upstream connections for up to 60 s and the spec asks
     * us to hold them for at least 65 s, so only drop after 90 s of silence.
     * The sweep is rate-limited to a slice per second (below): a per-cycle
     * slice would walk ~20M entries/s at the benchmark's request rate. */
    public function expire(int $now): void {
        /* Sweep at most once a second. The loop runs ~10k cycles/s when
         * requests are spread out (think times), so a per-cycle slice burns
         * the core for nothing; a full pass only needs to finish inside the
         * 90 s idle window (2048/s over 15k sockets = 8 s). */
        if ($now < $this->sweep + 1) { return; }
        $this->sweep = $now;
        $n = count($this->sockList);
        if ($n == 0) { return; }
        $budget = 2048;
        while ($budget > 0 && $this->sweepPos < $n) {
            $fd = $this->sockList[$this->sweepPos];
            $this->sweepPos = $this->sweepPos + 1;
            $budget = $budget - 1;
            if (!(iarr_get($this->socks, $fd) != 0)) { continue; }
            if ($now - iarr_get($this->lasts, $fd) >= $this->idleTimeout) { $this->close_fd($fd); }
        }
        if ($this->sweepPos >= $n) {
            $this->sweepPos = 0;
            /* compact once the list is mostly tombstones */
            if ($n > $this->nconn * 2 + 1024) {
                $this->sockList = [];
                $k = 0;
                while ($k < 655360) {
                    if (iarr_get($this->socks, $k) != 0) { $this->sockList[] = $k; }
                    $k = $k + 1;
                }
            }
        }
    }

    public function close_fd(int $fd): void {
        if (iarr_get($this->socks, $fd) != 0) { $this->nconn = $this->nconn - 1; }
        iarr_set($this->socks, $fd, 0);
        unset($this->bufs[$fd]);
        if ($this->idleSweep == 1) { iarr_set($this->lasts, $fd, 0); }
        unset($this->out[$fd]);
        unset($this->closing[$fd]);
        epoll_del($fd);
        stream_close($fd);
        /* room again: watch the listener */
        if ($this->paused == 1 && $this->nconn < $this->shedAt) {
            $this->paused = 0;
            epoll_add($this->srv);
        }
    }

    /* -------------------------------------------------------- read side */

    public function read_fd(int $fd): void {
        $chunk = stream_recv($fd, 4096);
        if ($chunk == "") {
            if (stream_eof($fd)) { $this->close_fd($fd); }
            return;
        }
        /* $this->bufs[$fd] is "" (static) or a heap copy of a partial
         * request; the concatenation lives in the request scope and is
         * either consumed here or copied back with str_persist(). */
        if ($this->idleSweep == 1) { iarr_set($this->lasts, $fd, time()); }
        if ($this->sparseBufs && !isset($this->bufs[$fd])) {
            $this->parse($fd, $chunk);
            stream_recv_release($fd);
            return;
        }
        $old = $this->bufs[$fd];
        if ($old == "") {
            /* the common case: a whole request in one recv, no copy at all */
            $this->parse($fd, $chunk);
            stream_recv_release($fd);
        } else {
            $buf = $old . $chunk;
            str_free($old);
            if ($this->sparseBufs) { unset($this->bufs[$fd]); }
            else { $this->bufs[$fd] = ""; }
            $this->parse($fd, $buf);
            stream_recv_release($fd);
        }
    }

    public function parse(int $fd, string $in): void {
        if ($this->statsmode) { $this->reqs++; }
        $buf = $in;
        while (true) {
            $bufLen = strlen($buf);
            $he = strpos($buf, "\r\n\r\n");
            if ($he === false) {
                if ($bufLen > 131072) {
                    $this->close_fd($fd);
                    return;
                }
                if ($bufLen == 0) {
                    if ($this->sparseBufs) { unset($this->bufs[$fd]); }
                    else { $this->bufs[$fd] = ""; }
                } else {
                    $this->bufs[$fd] = str_persist($buf);
                }
                return;
            }
            /* request line: METHOD SP PATH SP VERSION — compare in place, no
             * substrings for the hot GET routes */
            $sp1 = strpos($buf, " ");
            if ($sp1 === false) { $this->close_fd($fd); return; }
            if ($sp1 > $he) { $this->close_fd($fd); return; }
            $sp2 = strpos($buf, " ", $sp1 + 1);
            if ($sp2 === false) { $this->close_fd($fd); return; }
            if ($sp2 > $he) { $this->close_fd($fd); return; }
            $ps = intval($sp1) + 1;
            $pl = intval($sp2) - $ps;

            if (str_at_eq($buf, 0, 3, "GET")) {
                if ($pl == 5 && str_at_eq($buf, $ps, 5, "/feed")) {
                    $this->on_feed($fd);
                } else if ($pl == 7 && str_at_eq($buf, $ps, 7, "/health")) {
                    $this->on_health($fd);
                } else if ($this->statsmode && $pl == 6 && str_at_eq($buf, $ps, 6, "/stats")) {
                    $this->on_stats($fd);
                } else if ($pl > 7 && str_at_eq($buf, $ps, 6, "/posts") && $buf[$ps + 6] == "/") {
                    $this->on_post($fd, substr($buf, $ps + 7, $pl - 7));
                } else {
                    $this->send_json($fd, 404, '{"error":"not found"}');
                }
                if (!(iarr_get($this->socks, $fd) != 0)) { return; }
                $np = $he + 4;                          /* EXPERIMENT R */
                if ($np == $bufLen) { return; }          /* no substr for the
                                                           last request in
                                                           the packet */
                $buf = substr($buf, $np);
                if ($buf == "") { return; }
                continue;
            }

            $method = substr($buf, 0, $sp1);
            $path = substr($buf, $ps, $pl);

            $cl = 0;
            $auth = "";
            if (true) {
                /* scan the request buffer itself, bounded by the end of the
                 * header: no substr($buf, 0, $he) copy per request */
                $k = str_pos_ci($buf, "\r\ncontent-length:", 0);
                if ($k !== false && intval($k) < $he) {
                    $e = strpos($buf, "\r\n", intval($k) + 2);
                    if ($e === false || intval($e) > $he) { $e = $he; }
                    $cl = str_int_range($buf, intval($k) + 17, intval($e));
                }
                $ak = str_pos_ci($buf, "\r\nauthorization:", 0);
                if ($ak !== false && intval($ak) < $he) {
                    $ae = strpos($buf, "\r\n", intval($ak) + 2);
                    if ($ae === false || intval($ae) > $he) { $ae = $he; }
                    $auth = str_trim_range($buf, intval($ak) + 16, intval($ae));
                }
            }
            if ($cl < 0 || $cl > 1048576) {                $this->close_fd($fd);
                return;
            }

            $start = $he + 4;
            if ($bufLen - $start < $cl) {
                $this->bufs[$fd] = str_persist($buf);
                return;
            }
            $body = "";
            if ($cl > 0) { $body = substr($buf, $start, $cl); }
            $buf = substr($buf, $start + $cl);

            $this->dispatch($fd, $method, $path, $auth, $body);
            if (!(iarr_get($this->socks, $fd) != 0)) { return; }
        }
    }

    /* --------------------------------------------------------- routing */

    public function dispatch(int $fd, string $method, string $path, string $auth, string $body): void {
        if ($path == "/health") { $this->on_health($fd); return; }
        if ($path == "/feed") { $this->on_feed($fd); return; }
        if ($path == "/posts") {
            if ($method == "POST") { $this->on_create($fd, $auth, $body); return; }
            $this->send_json($fd, 404, '{"error":"not found"}');
            return;
        }
        if (str_starts_with($path, "/posts/")) {
            $rest = substr($path, 7);
            $n = strlen($rest);
            if ($n > 5 && str_ends_with($rest, "/like")) {
                if ($method == "POST") {
                    $this->on_like($fd, $auth, substr($rest, 0, $n - 5));
                    return;
                }
            }
            $this->on_post($fd, $rest);
            return;
        }
        $this->send_json($fd, 404, '{"error":"not found"}');
    }

    public function on_feed(int $fd): void {
        if (!$this->feedjson && $this->btFeed == 0) { $this->open_bt_cursors(); }
        if (!$this->feedjson && $this->btPosts != 0 && $this->btFeed != 0 && $this->btLikes != 0 && $this->btUsers != 0) {
            $this->on_feed_bt($fd);
            return;
        }
        $rc = sqlite_step($this->feed);
        if ($rc == 100) {
            $b = sqlite_column_text($this->feed, 0);
        } else {
            $b = '{"posts":[]}';
        }
        sqlite_reset($this->feed);
        $this->send_json($fd, 200, $b);
    }

    /* Collect the newest feed IDs and their like histogram, then read and
     * render each post directly into the response builder without row objects. */



    public function on_feed_bt(int $fd): void {
        if ($this->feedBatchUsers && $this->on_feed_bt_batch_users($fd)) { return; }
        if ($this->feedBatchAuthors && $this->on_feed_bt_batch_authors($fd)) { return; }
        $this->on_feed_bt_legacy($fd);
    }

    /* Mirror the leader's batched author lookup with the generic B-tree APIs:
     * collect the user rowids while scanning posts, descend the users tree for
     * all of them together, then render in feed order from the pinned pages.
     * Every hit is released before returning; this is per-request work, not a
     * cross-request result cache. */
    public function on_feed_bt_batch_authors(int $fd): bool {
        $ids = iarr_new(20);
        $uids = iarr_new(20);
        $hits = iarr_new(60);       /* found, payload pointer, payload size */
        $postHits = iarr_new(60);   /* found, payload pointer, payload size */
        $postMeta = iarr_new(80); /* body offset/len and created offset/len */
        $counts = iarr_new(256);
        $r = bt_first($this->btFeed);
        $n = 0;
        $ok = true;
        while ($r == 1 && $n < 20) {
            if (bt_cols($this->btFeed) < 2) { $ok = false; break; }
            iarr_set($ids, $n, bt_col_int(1));
            $n = $n + 1;
            $r = bt_next($this->btFeed);
        }
        if (!$ok) {
            iarr_release($ids); iarr_release($uids); iarr_release($hits);
            iarr_release($postHits); iarr_release($postMeta);
            iarr_release($counts);
            return false;
        }
        if ($n == 0) {
            iarr_release($ids); iarr_release($uids); iarr_release($hits);
            iarr_release($postHits); iarr_release($postMeta);
            iarr_release($counts);
            $this->send_json($fd, 200, '{"posts":[]}');
            return true;
        }

        $lo = iarr_get($ids, 0);
        $hi = $lo;
        $i = 1;
        while ($i < $n) {
            $id = iarr_get($ids, $i);
            if ($id < $lo) { $lo = $id; }
            if ($id > $hi) { $hi = $id; }
            $i = $i + 1;
        }
        if ($hi - $lo >= 256 || bt_count_range($this->btLikes, $lo, $hi, $counts) != 0) {
            iarr_release($ids); iarr_release($uids); iarr_release($hits);
            iarr_release($postHits); iarr_release($postMeta);
            iarr_release($counts);
            return false;
        }

        /* Batch the post rowid lookups too. This avoids a PHP/runtime cursor
         * call for every row and keeps each payload page pinned through JSON
         * rendering. The generic B-tree primitive returns raw SQLite records;
         * HolyPHP still owns the feed ordering and response logic. */
        $postMulti = bt_multi_seek($this->btPosts, $ids, $n);
        if ($postMulti == 0 || !bt_multi_payloads($postMulti, $postHits)) { $ok = false; }
        $i = 0;
        while ($ok && $i < $n) {
            if (iarr_get($postHits, $i * 3) == 0) { $ok = false; break; }
            $pp = iarr_get($postHits, $i * 3 + 1);
            $ps = iarr_get($postHits, $i * 3 + 2);
            $uid: int = 0;
            $bo: int = 0;
            $bl: int = 0;
            $co: int = 0;
            $cl: int = 0;
            $parsed: bool = false;
            unsafe {
                $q = $pp as *u8;
                if ($ps >= 5) {
                    $hdr = *$q & 255;
                    $st1 = *($q + 2) & 255;
                    $st2 = *($q + 3) & 255;
                    $k = 4;
                    $valid = true;
                    if ($st2 >= 128) {
                        if ($k >= $ps) { $valid = false; }
                        else { $st2 = (($st2 & 127) << 7) | (*($q + $k) & 255); $k = $k + 1; }
                    }
                    if ($valid && $k < $ps) {
                        $st3 = *($q + $k) & 255;
                        $ul = 0;
                        if ($st1 >= 1 && $st1 <= 4) { $ul = $st1; }
                        else if ($st1 == 5) { $ul = 6; }
                        else if ($st1 == 6) { $ul = 8; }
                        else if ($st1 == 9) { $uid = 1; }
                        if (($st2 >= 13 && ($st2 & 1) == 1) && ($st3 >= 13 && ($st3 & 1) == 1)) {
                            $bl = ($st2 - 13) >> 1;
                            $cl = ($st3 - 13) >> 1;
                            $bo = $hdr + $ul;
                            $co = $bo + $bl;
                            if ($hdr > 0 && $hdr <= $ps && $co + $cl <= $ps) {
                                $j = 0;
                                while ($j < $ul) { $uid = ($uid << 8) | (*($q + $hdr + $j) & 255); $j = $j + 1; }
                                $parsed = true;
                            }
                        }
                    }
                }
            }
            if (!$parsed || $uid <= 0) { $ok = false; break; }
            iarr_set($uids, $i, $uid);
            iarr_set($postMeta, $i * 4, $bo);
            iarr_set($postMeta, $i * 4 + 1, $bl);
            iarr_set($postMeta, $i * 4 + 2, $co);
            iarr_set($postMeta, $i * 4 + 3, $cl);
            $i = $i + 1;
        }
        if (!$ok) {
            if ($postMulti != 0) { bt_multi_release($postMulti); }
            iarr_release($ids); iarr_release($uids); iarr_release($hits);
            iarr_release($postHits); iarr_release($postMeta);
            iarr_release($counts);
            return false;
        }

        $multi = bt_multi_seek($this->btUsers, $uids, $n);
        if ($multi == 0 || !bt_multi_payloads($multi, $hits)) {
            if ($multi != 0) { bt_multi_release($multi); }
            bt_multi_release($postMulti);
            iarr_release($ids); iarr_release($uids); iarr_release($hits);
            iarr_release($postHits); iarr_release($postMeta);
            iarr_release($counts);
            return false;
        }
        $i = 0;
        while ($i < $n) {
            if (iarr_get($hits, $i * 3) == 0) { $ok = false; break; }
            $i = $i + 1;
        }

        $sb = 0;
        if ($ok) {
            $sb = sb_new();
            sb_reserve($sb, 12288);
            sb_put($sb, '{"posts":[');
            $i = 0;
            while ($ok && $i < $n) {
                $id = iarr_get($ids, $i);
                $p = iarr_get($postHits, $i * 3 + 1);
                $bo = iarr_get($postMeta, $i * 4);
                $bl = iarr_get($postMeta, $i * 4 + 1);
                $co = iarr_get($postMeta, $i * 4 + 2);
                $cl = iarr_get($postMeta, $i * 4 + 3);
                $up = iarr_get($hits, $i * 3 + 1);
                $us = iarr_get($hits, $i * 3 + 2);
                $uh: int = 0;
                $al: int = 0;
                $a: int = 0;
                unsafe {
                    $uq = $up as *u8;
                    $uh = *$uq & 255;
                    $st: int = *($uq + 2) & 255;
                    if ($st >= 128) { $st = (($st & 127) << 8) | (*($uq + 3) & 255); }
                    if ($st >= 13 && ($st & 1) == 1) { $al = ($st - 13) >> 1; }
                    else { $ok = false; }
                    if ($uh <= 0 || $uh + $al > $us) { $ok = false; }
                    $a = $up + $uh;
                }
                if (!$ok) { break; }

                if ($i > 0) { sb_put($sb, ","); }
                sb_put($sb, '{"id":');
                sb_int($sb, $id);
                sb_put($sb, ',"body":');
                sb_json($sb, $p + $bo, $bl);
                sb_put($sb, ',"created_at":');
                sb_json($sb, $p + $co, $cl);
                sb_put($sb, ',"author":');
                sb_json($sb, $a, $al);
                sb_put($sb, ',"like_count":');
                sb_int($sb, iarr_get($counts, $id - $lo));
                sb_put($sb, "}");
                $i = $i + 1;
            }
        }

        if (!$ok) {
            if ($sb != 0) { sb_discard($sb); }
            bt_multi_release($multi);
            bt_multi_release($postMulti);
            iarr_release($ids); iarr_release($uids); iarr_release($hits);
            iarr_release($postHits); iarr_release($postMeta);
            iarr_release($counts);
            return false;
        }
        sb_put($sb, "]}");
        $blen = sb_len($sb);
        $shed = $this->nconn >= $this->shedAt;
        if ($shed) {
            sb_prepend($sb, $this->hdr[200] . $blen . "\r\nConnection: close\r\n\r\n");
        } else {
            sb_prepend($sb, $this->hdr[200] . $blen . "\r\nConnection: keep-alive\r\n\r\n");
        }
        bt_multi_release($multi);
        bt_multi_release($postMulti);
        iarr_release($ids); iarr_release($uids); iarr_release($hits);
        iarr_release($postHits); iarr_release($postMeta);
        iarr_release($counts);
        $sent = stream_send_sb($fd, $sb);
        if ($sent == -2) { $this->close_fd($fd); return true; }
        if ($shed) { $this->close_fd($fd); }
        return true;
    }

    /* Like the legacy path, walk posts and likes with their live cursors. Pin
     * each post's page, then resolve all authors in one sorted B-tree descent.
     * This removes the per-post users-table seek while keeping row selection,
     * output order, and JSON rendering in HolyPHP. */
    public function on_feed_bt_batch_users(int $fd): bool {
        $rows = iarr_new(240);      /* 12 integers per post */
        $uids = iarr_new(20);
        $hits = iarr_new(60);       /* found, payload pointer, payload size */
        $lr = bt_last($this->btLikes);
        $lpid = -1;
        $r = bt_last($this->btPosts);
        $n = 0;
        $pinned = 0;
        $ok = true;

        while ($r == 1 && $n < 20) {
            $base = $n * 12;
            $id = bt_rowid($this->btPosts);
            $p = bt_payload_ptr($this->btPosts);
            if ($p == 0 || bt_cols($this->btPosts) < 4) { $ok = false; break; }
            $uid = bt_col_int(1);
            $bo = bt_col_off(2);
            $bl = bt_col_len(2);
            $co = bt_col_off(3);
            $cl = bt_col_len(3);
            $pin = bt_payload_pin($this->btPosts);
            if ($pin == 0) { $ok = false; break; }

            $cnt = 0;
            while ($lr == 1) {
                if ($lpid < 0) {
                    if (bt_cols($this->btLikes) < 1) { break; }
                    $lpid = bt_col_int(0);
                }
                if ($lpid != $id) { break; }
                $cnt = $cnt + 1;
                $lpid = -1;
                $lr = bt_prev($this->btLikes);
            }

            iarr_set($rows, $base, $id);
            iarr_set($rows, $base + 1, $uid);
            iarr_set($rows, $base + 2, $p);
            iarr_set($rows, $base + 3, bt_payload_size($this->btPosts));
            iarr_set($rows, $base + 4, $bo);
            iarr_set($rows, $base + 5, $bl);
            iarr_set($rows, $base + 6, $co);
            iarr_set($rows, $base + 7, $cl);
            iarr_set($rows, $base + 8, $cnt);
            iarr_set($rows, $base + 9, $pin);
            iarr_set($uids, $n, $uid);
            $pinned = $pinned + 1;
            $n = $n + 1;
            $r = bt_prev($this->btPosts);
        }
        if (!$ok) {
            $i = 0;
            while ($i < $pinned) { bt_page_release(iarr_get($rows, $i * 12 + 9)); $i = $i + 1; }
            iarr_release($rows); iarr_release($uids); iarr_release($hits);
            return false;
        }
        if ($n == 0) {
            iarr_release($rows); iarr_release($uids); iarr_release($hits);
            $this->send_json($fd, 200, '{"posts":[]}');
            return true;
        }

        $multi = bt_multi_seek($this->btUsers, $uids, $n);
        if ($multi == 0 || !bt_multi_payloads($multi, $hits)) { $ok = false; }
        $i = 0;
        while ($ok && $i < $n) {
            $base = $i * 12;
            if (iarr_get($hits, $i * 3) == 0) { $ok = false; break; }
            $up = iarr_get($hits, $i * 3 + 1);
            $us = iarr_get($hits, $i * 3 + 2);
            $al = 0;
            $a = 0;
            unsafe {
                $uq = $up as *u8;
                $uh = *$uq & 255;
                $st = *($uq + 2) & 255;
                if ($st >= 128 && $us > 3) { $st = (($st & 127) << 8) | (*($uq + 3) & 255); }
                if ($st >= 13 && ($st & 1) == 1) { $al = ($st - 13) >> 1; }
                else { $ok = false; }
                if ($uh <= 0 || $uh + $al > $us) { $ok = false; }
                $a = $up + $uh;
            }
            iarr_set($rows, $base + 10, $a);
            iarr_set($rows, $base + 11, $al);
            $i = $i + 1;
        }
        if (!$ok) {
            if ($multi != 0) { bt_multi_release($multi); }
            $i = 0;
            while ($i < $pinned) { bt_page_release(iarr_get($rows, $i * 12 + 9)); $i = $i + 1; }
            iarr_release($rows); iarr_release($uids); iarr_release($hits);
            return false;
        }

        $sb = sb_new();
        sb_reserve($sb, 12288);
        sb_put($sb, '{"posts":[');
        $i = 0;
        while ($i < $n) {
            $base = $i * 12;
            if ($i > 0) { sb_put($sb, ','); }
            sb_put($sb, '{"id":');
            sb_int($sb, iarr_get($rows, $base));
            sb_put($sb, ',"body":');
            sb_json($sb, iarr_get($rows, $base + 2) + iarr_get($rows, $base + 4), iarr_get($rows, $base + 5));
            sb_put($sb, ',"created_at":');
            sb_json($sb, iarr_get($rows, $base + 2) + iarr_get($rows, $base + 6), iarr_get($rows, $base + 7));
            sb_put($sb, ',"author":');
            sb_json($sb, iarr_get($rows, $base + 10), iarr_get($rows, $base + 11));
            sb_put($sb, ',"like_count":');
            sb_int($sb, iarr_get($rows, $base + 8));
            sb_put($sb, '}');
            $i = $i + 1;
        }
        sb_put($sb, ']}');
        $blen = sb_len($sb);
        $shed = $this->nconn >= $this->shedAt;
        if ($shed) {
            sb_prepend($sb, $this->hdr[200] . $blen . "\r\nConnection: close\r\n\r\n");
        } else {
            sb_prepend($sb, $this->hdr[200] . $blen . "\r\nConnection: keep-alive\r\n\r\n");
        }
        bt_multi_release($multi);
        $i = 0;
        while ($i < $pinned) { bt_page_release(iarr_get($rows, $i * 12 + 9)); $i = $i + 1; }
        iarr_release($rows); iarr_release($uids); iarr_release($hits);
        $sent = stream_send_sb($fd, $sb);
        if ($sent == -2) { $this->close_fd($fd); return true; }
        if ($shed) { $this->close_fd($fd); }
        return true;
    }

    public function on_feed_bt_legacy(int $fd): void {
        $sb = sb_new();
        sb_reserve($sb, 12288);
        sb_put($sb, '{"posts":[');

        $lr = bt_last($this->btLikes);
        $lpid = -1;          /* -1: the current like entry is not decoded yet */
        $r = bt_last($this->btPosts);
        $i = 0;
        while ($r == 1 && $i < 20) {
            $id = bt_rowid($this->btPosts);
            $p: int = 0;
            $uid: int = 0;
            $bo: int = 0;
            $bl: int = 0;
            $co: int = 0;
            $cl: int = 0;
            $p = bt_payload_ptr($this->btPosts);
            if (bt_cols($this->btPosts) < 4) { break; }
            $uid = bt_col_int(1);
            $bo = bt_col_off(2);
            $bl = bt_col_len(2);
            $co = bt_col_off(3);
            $cl = bt_col_len(3);

            /* every like whose post id equals this one: they are contiguous */
            $cnt = 0;
            while ($lr == 1) {
                if ($lpid < 0) {
                    if (bt_cols($this->btLikes) < 1) { break; }
                    $lpid = bt_col_int(0);
                }
                if ($lpid != $id) { break; }
                $cnt = $cnt + 1;
                $lpid = -1;
                $lr = bt_prev($this->btLikes);
            }

            $a = 0;
            $al = 0;
            if (bt_seek($this->btUsers, $uid) == 1) {
                $up = bt_payload_ptr($this->btUsers);
                if (bt_cols($this->btUsers) >= 2) {
                    $al = bt_col_len(1);
                    $a = $up + bt_col_off(1);
                }
            }

            if ($i > 0) { sb_put($sb, ","); }
            sb_put($sb, '{"id":');
            sb_int($sb, $id);
            sb_put($sb, ',"body":');
            sb_json($sb, $p + $bo, $bl);
            sb_put($sb, ',"created_at":');
            sb_json($sb, $p + $co, $cl);
            sb_put($sb, ',"author":');
            sb_json($sb, $a, $al);
            sb_put($sb, ',"like_count":');
            sb_int($sb, $cnt);
            sb_put($sb, "}");
            $i = $i + 1;
            $r = bt_prev($this->btPosts);
        }
        sb_put($sb, "]}");
        /* the response header is prepended into the same buffer and the
         * buffer becomes the send chunk: no body copy, no extra hstr */
        $blen = sb_len($sb);
        $shed = $this->nconn >= $this->shedAt;
        if ($shed) {
            sb_prepend($sb, $this->hdr[200] . $blen . "\r\nConnection: close\r\n\r\n");
        } else {
            sb_prepend($sb, $this->hdr[200] . $blen . "\r\nConnection: keep-alive\r\n\r\n");
        }
        $sent = stream_send_sb($fd, $sb);
        if ($sent == -2) { $this->close_fd($fd); return; }
        if ($shed) { $this->close_fd($fd); }
    }

    /* One post through the same cursors the feed uses: a rowid seek in posts,
     * a rowid seek in users, and the like count from the index. The record is
     * decoded and escaped in place, like a feed row. */
    public function on_post_bt(int $fd, string $ids): void {
        $id = $this->parse_id($ids);
        if ($id <= 0) {
            $this->send_json($fd, 400, '{"error":"invalid post id"}');
            return;
        }
        if (bt_seek($this->btPosts, $id) != 1) {
            $this->send_json($fd, 404, '{"error":"post not found"}');
            return;
        }
        $p: int = 0;
        $uid: int = 0;
        $bo: int = 0;
        $bl: int = 0;
        $co: int = 0;
        $cl: int = 0;
        $p = bt_payload_ptr($this->btPosts);
        unsafe {
            $q = $p as *u8;
            $hdr = *$q & 255;
            /* byte 1 is the rowid alias serial type (always 0/NULL) */
            $k = 2;
            $st1 = *($q + $k) & 255;
            $k = $k + 1;
            $st2 = *($q + $k) & 255;
            $k = $k + 1;
            if ($st2 >= 128) { $st2 = (($st2 & 127) << 7) | (*($q + $k) & 255); $k = $k + 1; }
            $st3 = *($q + $k) & 255;
            $l1 = 0;
            if ($st1 >= 1 && $st1 <= 4) { $l1 = $st1; }
            else if ($st1 == 5) { $l1 = 6; }
            else if ($st1 == 6 || $st1 == 7) { $l1 = 8; }
            else if ($st1 == 9) { $uid = 1; }
            $o1 = $hdr;
            $bl = ($st2 - 13) >> 1;
            $bo = $o1 + $l1;
            $cl = ($st3 - 13) >> 1;
            $co = $bo + $bl;
            $j = 0;
            while ($j < $l1) { $uid = ($uid << 8) | (*($q + $o1 + $j) & 255); $j = $j + 1; }
        }
        $a = 0;
        $al: int = 0;
        if (bt_seek($this->btUsers, $uid) == 1) {
            $up = bt_payload_ptr($this->btUsers);
            unsafe {
                $q = $up as *u8;
                $hdr: int = *$q & 255;
                $st1: int = *($q + 2) & 255;
                if ($st1 >= 128) { $st1 = (($st1 & 127) << 7) | (*($q + 3) & 255); }
                $al = ($st1 - 13) >> 1;
                $a = $up + $hdr;
            }
        }
        /* like_count from the index itself: seek to the post's range and
         * walk the matching entries backwards. The SQL count runs the VDBE
         * and measured several microseconds per request. */
        $n = -1;
        if ($this->btLikes != 0) { $n = bt_count_key($this->btLikes, $id); }
        if ($n < 0) {
            sqlite_bind_int($this->likecnt, 1, $id);
            $n = 0;
            if (sqlite_step($this->likecnt) == 100) {
                $n = sqlite_column_int($this->likecnt, 0);
            }
            sqlite_reset($this->likecnt);
            sqlite_clear_bindings($this->likecnt);
        }

        $sb = sb_new();
        sb_reserve($sb, 1024);
        sb_put($sb, '{"post":{"id":');
        sb_int($sb, $id);
        sb_put($sb, ',"body":');
        sb_json($sb, $p + $bo, $bl);
        sb_put($sb, ',"created_at":');
        sb_json($sb, $p + $co, $cl);
        sb_put($sb, ',"author":');
        sb_json($sb, $a, $al);
        sb_put($sb, ',"like_count":');
        sb_int($sb, $n);
        sb_put($sb, "}}");
        if ($this->postSendBuilder) {
            $blen = sb_len($sb);
            $shed = $this->nconn >= $this->shedAt;
            if ($shed) {
                sb_prepend($sb, $this->hdr[200] . $blen . "\r\nConnection: close\r\n\r\n");
            } else {
                sb_prepend($sb, $this->hdr[200] . $blen . "\r\nConnection: keep-alive\r\n\r\n");
            }
            $sent = stream_send_sb($fd, $sb);
            if ($sent == -2) { $this->close_fd($fd); return; }
            if ($shed) { $this->close_fd($fd); }
            return;
        }
        $this->send_json($fd, 200, sb_take($sb));
    }

    public function on_post(int $fd, string $ids): void {
        if ($this->btPosts == 0) { $this->open_bt_cursors(); }
        if ($this->btPosts != 0 && $this->btUsers != 0 && $this->likecnt != 0) {
            $this->on_post_bt($fd, $ids);
            return;
        }
        $id = $this->parse_id($ids);
        if ($id <= 0) {
            $this->send_json($fd, 400, '{"error":"invalid post id"}');
            return;
        }
        sqlite_bind_int($this->post, 1, $id);
        $rc = sqlite_step($this->post);
        if ($rc == 100) {
            $b = sqlite_column_text($this->post, 0);
            sqlite_reset($this->post);
            sqlite_clear_bindings($this->post);
            $this->send_json($fd, 200, $b);
        } else {
            sqlite_reset($this->post);
            sqlite_clear_bindings($this->post);
            $this->send_json($fd, 404, '{"error":"post not found"}');
        }
    }

    public function on_health(int $fd): void {
        $rc = sqlite_step($this->health);
        if ($rc == 100) {
            sqlite_reset($this->health);
            if ($this->ring) { $this->on_health_fast($fd); return; }
            $b = '{"status":"ok","db":"ok","uptime_s":' . (time() - $this->start) . '}';
            $this->send_json($fd, 200, $b);
        } else {
            $e = sqlite_errmsg($this->db);
            sqlite_reset($this->health);
            $b = '{"status":"degraded","db":"unreachable","error":' . json_encode($e) . '}';
            $this->send_json($fd, 503, $b);
        }
    }

    /* The hot /health response built straight into the send buffer: header
     * and body leave in one buffer, `int_digits` sizes the Content-Length
     * without a throwaway string, and stream_send_sb hands the buffer to
     * the ring send chunk -- no hstr for the payload, no memcpy into the
     * send chain (write_response's classic path builds the same bytes with
     * concatenations, a send-payload copy, and a throwaway hstr). The shed
     * contract matches write_response exactly: at shedAt the tail says
     * Connection: close and the fd is queued for close after the drain
     * (closed connections still answer health checks correctly, once). */
    public function on_health_fast(int $fd): void {
        $up = time() - $this->start;
        $shed = $this->nconn >= $this->shedAt;
        $sb = sb_new();
        sb_reserve($sb, 208);
        sb_put($sb, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Encoding: identity\r\nContent-Length: ");
        sb_int($sb, 37 + int_digits($up));
        if ($shed) {
            sb_put($sb, "\r\nConnection: close\r\n\r\n{\"status\":\"ok\",\"db\":\"ok\",\"uptime_s\":");
        } else {
            sb_put($sb, "\r\nConnection: keep-alive\r\n\r\n{\"status\":\"ok\",\"db\":\"ok\",\"uptime_s\":");
        }
        sb_int($sb, $up);
        sb_put($sb, "}");
        $sent = stream_send_sb($fd, $sb);
        if ($sent == -2) { $this->close_fd($fd); return; }
        if ($shed) { $this->close_fd($fd); }
    }

    /* Operator introspection (HPHP_STATS=1 only): the runtime counters are
     * cumulative, so the response carries the delta since the previous call
     * of this endpoint and the raw snapshot. A polling client chooses the
     * interval and divides. */
    public function on_stats(int $fd): void {
        $rt = runtime_stats();
        $body = '{"interval":{"reqs":' . ($this->reqs - $this->reqsBase)
              . '},"runtime":' . $rt . '}';
        $this->reqsBase = $this->reqs;
        $this->send_json($fd, 200, $body);
    }

    public function on_create(int $fd, string $auth, string $body): void {
        $a = $this->authenticate($auth);
        if ($a[0] == 1) { arr_free($a); $this->send_json($fd, 401, '{"error":"missing bearer token"}'); return; }
        if ($a[0] == 2) { arr_free($a); $this->send_json($fd, 401, '{"error":"invalid or expired token"}'); return; }
        if ($a[0] == 3) { arr_free($a); $this->send_json($fd, 401, '{"error":"invalid token payload"}'); return; }
        $uid = $a[1];
        $uname = $a[2];
        arr_free($a);

        $j = new Json($body);
        if (!$j->parse()) {
            $this->send_json($fd, 400, '{"error":"malformed JSON body"}');
            return;
        }
        $v = $j->root;
        if (!is_array($v) || !isset($v["body"]) || !is_string($v["body"])) {
            arr_free($v);
            $this->send_json($fd, 400, '{"error":"body is required"}');
            return;
        }
        $text = trim($v["body"]);
        arr_free($v);
        if ($text == "") {
            $this->send_json($fd, 400, '{"error":"body is required"}');
            return;
        }
        if ($this->cp_len($text) > 500) {
            $this->send_json($fd, 400, '{"error":"body must be at most 500 characters"}');
            return;
        }
        $r = [];
        $r["kind"] = 1;
        $r["fd"] = $fd;
        $r["code"] = 0;
        $r["body"] = "";
        $r["uid"] = $uid;
        $r["pid"] = 0;
        $r["text"] = $text;
        $r["name"] = $uname;
        $this->pending[] = $r;
    }

    public function on_like(int $fd, string $auth, string $ids): void {
        $a = $this->authenticate($auth);
        if ($a[0] == 1) { arr_free($a); $this->send_json($fd, 401, '{"error":"missing bearer token"}'); return; }
        if ($a[0] == 2) { arr_free($a); $this->send_json($fd, 401, '{"error":"invalid or expired token"}'); return; }
        if ($a[0] == 3) { arr_free($a); $this->send_json($fd, 401, '{"error":"invalid token payload"}'); return; }
        $uid = $a[1];
        arr_free($a);

        $id = $this->parse_id($ids);
        if ($id <= 0) {
            $this->send_json($fd, 400, '{"error":"invalid post id"}');
            return;
        }
        $r = [];
        $r["kind"] = 2;
        $r["fd"] = $fd;
        $r["code"] = 0;
        $r["body"] = "";
        $r["uid"] = $uid;
        $r["pid"] = $id;
        $r["text"] = "";
        $r["name"] = "";
        $this->pending[] = $r;
    }

    /* --------------------------------------------------------- auth */

    /* returns [0, uid, username] | [1] missing | [2] bad token | [3] bad payload */
    public function authenticate(string $hdr) {
        if ($hdr == "" || strlen($hdr) < 7) { return [1]; }
        if (!str_prefix_ci($hdr, "bearer ")) { return [1]; }
        $tok = trim(substr($hdr, 7));
        if ($tok == "") { return [1]; }

        /* native HS256 check: the split, the alg field, the constant-time
         * signature compare and exp are all verified in the runtime without
         * building intermediate strings (the PHP version allocated ~20). */
        $pj = jwt_verify_prepared($tok, $this->jwtVerifier, time());
        if ($pj == "") { return [2]; }

        $sub = json_str_field($pj, "sub");
        if ($sub == "") { return [3]; }
        $uid = $this->parse_id($sub);
        if ($uid <= 0) { return [3]; }

        $name = json_str_field($pj, "username");
        if ($name == "") { return [3]; }
        return [0, $uid, $name];
    }

    /* string value of "key" in a flat JSON object, "" when absent or not a
     * string. One strpos scan and one substr: building the value character by
     * character reallocated the string per byte and dominated the auth cost. */
    public function json_str(string $j, string $key): string {
        $k = "\"" . $key . "\"";
        $p = strpos($j, $k);
        if ($p === false) { return ""; }
        $c = strpos($j, ":", intval($p) + strlen($k));
        if ($c === false) { return ""; }
        $q = strpos($j, "\"", intval($c) + 1);
        if ($q === false) { return ""; }
        $e = strpos($j, "\"", intval($q) + 1);
        if ($e === false) { return ""; }
        $v = substr($j, intval($q) + 1, intval($e) - intval($q) - 1);
        if (strpos($v, "\\") === false) { return $v; }
        /* escaped value: unescape into a new string */
        $out = "";
        $i = 0;
        $n = strlen($v);
        while ($i < $n) {
            $ch = $v[$i];
            if ($ch == chr(92) && $i + 1 < $n) {
                $i = $i + 1;
                $out .= $v[$i];
            } else {
                $out .= $ch;
            }
            $i = $i + 1;
        }
        return $out;
    }

    /* integer value of "key", -1 when absent or not a number */
    public function json_num(string $j, string $key) {
        $n = strlen($j);
        $k = "\"" . $key . "\"";
        $p = strpos($j, $k);
        if ($p === false) { return -1; }
        $i = intval($p) + strlen($k);
        while ($i < $n && $j[$i] != ":") {
            $c = $j[$i];
            if ($c != " " && $c != "\t" && $c != "\n" && $c != "\r") { return -1; }
            $i++;
        }
        if ($i >= $n) { return -1; }
        $i++;
        while ($i < $n) {
            $c = $j[$i];
            if ($c != " " && $c != "\t" && $c != "\n" && $c != "\r") { break; }
            $i++;
        }
        $neg = false;
        if ($i < $n && $j[$i] == "-") { $neg = true; $i++; }
        $v = 0;
        $digits = 0;
        while ($i < $n) {
            $c = $j[$i];
            if ($c < "0" || $c > "9") { break; }
            $v = $v * 10 + (ord($c) - 48);
            $digits++;
            $i++;
        }
        if ($digits == 0) { return -1; }
        return $neg ? -$v : $v;
    }

    public function b64url(string $s): string {
        /* base64url is decoded natively: '-' and '_' are part of the
         * alphabet and missing padding is fine, so no replacement strings. */
        return base64_decode($s);
    }

    public function parse_id($s) {
        /* str_to_int() does the digit validation and range check in C; the
         * per-character loop here measured ~0.5 us per id before. */
        return str_to_int($s);
    }

    public function cp_len(string $s): int {
        $n = strlen($s);
        $c = 0;
        for ($i = 0; $i < $n; $i++) {
            if ((ord($s[$i]) & 192) != 128) { $c = $c + 1; }
        }
        return $c;
    }

    /* -------------------------------------------------- write + commit */

    /* prepared transaction control: one step+reset instead of sqlite3_exec
     * re-parsing the statement text on every group commit */
    public function txn(int $stmt): bool {
        if ($stmt == 0) { return false; }
        $rc = sqlite_step($stmt);
        sqlite_reset($stmt);
        return $rc == 101;
    }

    public function execute_writes(): void {
        if ($this->bgCheckpoint && sqlite_bg_checkpoint_hold($this->db)) { return; }
        $n = count($this->pending);
        if ($n == 0) { return; }

        /* Close low-level cursors before SQLite writes; reopen after commit or
         * rollback so no cursor position is retained across mutations. */
        $this->close_bt_cursors();
        if (!$this->txn($this->beginTx)) {
            $this->fail_writes();
            $this->flush();
            return;
        }

        $ok = true;
        $i = 0;
        while ($i < $n) {
            $r = $this->pending[$i];
            if ($r["kind"] == 1) {
                sqlite_bind_int($this->insPost, 1, $r["uid"]);
                sqlite_bind_text($this->insPost, 2, $r["text"]);
                $rc = sqlite_step($this->insPost);
                if ($rc != 100) {
                    /* sqlite3_step errors leave the statement active until it
                     * is reset; do that before rolling back the batch. */
                    sqlite_reset($this->insPost);
                    sqlite_clear_bindings($this->insPost);
                    $ok = false;
                    break;
                }
                $pid = sqlite_column_int($this->insPost, 0);
                $cat = sqlite_column_text($this->insPost, 1);
                $done = sqlite_step($this->insPost);
                sqlite_reset($this->insPost);
                sqlite_clear_bindings($this->insPost);
                if ($done != 101) { $ok = false; break; }
                /* build the body here instead of asking SQLite's JSON
                 * functions to format it inside the statement */
                $sb = sb_new();
                sb_reserve($sb, 256);
                sb_put($sb, '{"post":{"id":');
                sb_int($sb, $pid);
                sb_put($sb, ',"body":');
                sb_json_str($sb, $r["text"]);
                sb_put($sb, ',"created_at":');
                sb_json_str($sb, $cat);
                sb_put($sb, ',"author":');
                sb_json_str($sb, $r["name"]);
                sb_put($sb, ',"like_count":0}}');
                $r["body"] = sb_take($sb);
                $r["code"] = 201;
                $this->pending[$i] = $r;
            } else if ($r["kind"] == 2) {
                /* One statement for the common case: insert only when the
                 * post exists. changes() == 0 then means "already liked" or
                 * "no such post", and only that case pays for a lookup. */
                sqlite_bind_int($this->insLike, 1, $r["uid"]);
                sqlite_bind_int($this->insLike, 2, $r["pid"]);
                $rc = sqlite_step($this->insLike);
                $ch = sqlite_changes($this->db);
                sqlite_reset($this->insLike);
                sqlite_clear_bindings($this->insLike);
                if ($rc != 101 && $rc != 100) { $ok = false; break; }
                if ($ch > 0) {
                    $r["code"] = 201;
                    $r["body"] = '{"liked":true,"already_liked":false,"post_id":' . $r["pid"] . '}';
                } else {
                    sqlite_bind_int($this->hasPost, 1, $r["pid"]);
                    $hc = sqlite_step($this->hasPost);
                    sqlite_reset($this->hasPost);
                    sqlite_clear_bindings($this->hasPost);
                    if ($hc != 100) {
                        $r["code"] = 404;
                        $r["body"] = '{"error":"post not found"}';
                    } else {
                        $r["code"] = 200;
                        $r["body"] = '{"liked":true,"already_liked":true,"post_id":' . $r["pid"] . '}';
                    }
                }
                $this->pending[$i] = $r;
            }
            $i = $i + 1;
        }

        if ($ok && !$this->txn($this->commitTx)) { $ok = false; }
        if (!$ok) {
            $this->txn($this->rollbackTx);
            $this->fail_writes();
        }
        $this->flush();
    }

    public function fail_writes(): void {
        $i = 0;
        $n = count($this->pending);
        while ($i < $n) {
            $r = $this->pending[$i];
            $r["code"] = 500;
            $r["body"] = '{"error":"internal server error"}';
            $this->pending[$i] = $r;
            $i = $i + 1;
        }
    }

    public function flush(): void {
        foreach ($this->pending as $r) {
            $this->write_response($r["fd"], $r["code"], $r["body"]);
            arr_free($r);
        }
        arr_clear($this->pending);
    }

    /* ------------------------------------------------------ send side */

    public function send_json(int $fd, int $code, string $body): void {
        $this->write_response($fd, $code, $body);
    }

    public function write_response(int $fd, int $code, string $body): void {
        /* Direct mode holds one fd per user. Shed only when the process is
         * really running out of descriptors: the limit is read once at
         * startup (getrlimit), so a box with a higher LimitNOFILE keeps
         * every connection instead of closing one per response. */
        $shed = $this->nconn >= $this->shedAt;
        $blen = strlen($body);
        /* The status line and the fixed headers are prebuilt per code, so a
         * response costs three concatenations instead of ten. */
        $h = $this->hdr[$code] . $blen . ($shed
            ? "\r\nConnection: close\r\n\r\n"
            : "\r\nConnection: keep-alive\r\n\r\n");
        $total = strlen($h) + $blen;
        if (isset($this->out[$fd])) {
            /* A previous response is still being written: queue behind it so a
             * pipelining client does not lose one. Cap the queue: a peer that
             * pipelines megabytes without reading must not grow the process. */
            if (strlen($this->out[$fd]) > 1048576) { $this->close_fd($fd); return; }
            $this->out[$fd] = $this->out[$fd] . $h . $body;
            return;
        }
        $sent = stream_send2_nb($fd, $h, $body);
        if ($sent == -2) { $this->close_fd($fd); return; }
        if ($sent < 0) { $sent = 0; }   /* EAGAIN: buffer the whole response */
        if ($sent == $total) {
            if ($shed) { $this->close_fd($fd); }
            return;
        }
        $data = $h . $body;
        /* The socket buffer is full: keep the rest and let epoll report the
         * socket writable. Sleeping here would stall every other connection. */
        $this->out[$fd] = substr($data, $sent);
        if ($shed) { $this->closing[$fd] = 1; }
        if (!epoll_mod($fd, 3)) { $this->close_fd($fd); }
    }
}

/* ---------------------------------------------------------------- main */

$port = 3000;
$p = getenv("PORT");
if ($p !== false && $p != "") { $port = intval($p); }

$host = "0.0.0.0";
$h = getenv("HOST");
if ($h !== false && $h != "") { $host = $h; }

$server = new Server();
if (!$server->open($host, $port)) { exit(1); }
$server->run();
