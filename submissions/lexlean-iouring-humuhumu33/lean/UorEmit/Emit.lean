module
public import Init
public import LexLeanRuntime.Portable
set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 1000000000
set_option linter.constructorNameAsVariable false
namespace UorEmit.Emit

public inductive Phase where
  | idle
  | reading
  | committing

public inductive Event where
  | request
  | batchEnd
  | commitOk
  | commitFail

public inductive Action where
  | nothing
  | begin
  | commit
  | sendAll
  | failAll

@[expose] public def nextPhase (phase : Phase) (event : Event) : Phase := (match phase with | Phase.idle => (match event with | Event.request => Phase.reading | Event.batchEnd => Phase.idle | Event.commitOk => Phase.idle | Event.commitFail => Phase.idle) | Phase.reading => (match event with | Event.request => Phase.reading | Event.batchEnd => Phase.committing | Event.commitOk => Phase.reading | Event.commitFail => Phase.reading) | Phase.committing => (match event with | Event.request => Phase.committing | Event.batchEnd => Phase.committing | Event.commitOk => Phase.idle | Event.commitFail => Phase.idle))

@[expose] public def actionOf (phase : Phase) (event : Event) : Action := (match phase with | Phase.idle => (match event with | Event.request => Action.begin | Event.batchEnd => Action.nothing | Event.commitOk => Action.nothing | Event.commitFail => Action.nothing) | Phase.reading => (match event with | Event.request => Action.nothing | Event.batchEnd => Action.commit | Event.commitOk => Action.nothing | Event.commitFail => Action.nothing) | Phase.committing => (match event with | Event.request => Action.nothing | Event.batchEnd => Action.nothing | Event.commitOk => Action.sendAll | Event.commitFail => Action.failAll))

@[expose] public def sendAllowed (phase : Phase) (event : Event) : Bool := (match actionOf (phase) (event) with | Action.sendAll => (match phase with | Phase.committing => (match event with | Event.commitOk => true | Event.request => false | Event.batchEnd => false | Event.commitFail => false) | Phase.idle => false | Phase.reading => false) | Action.nothing => true | Action.begin => true | Action.commit => true | Action.failAll => true)

@[expose] public def failAllowed (phase : Phase) (event : Event) : Bool := (match actionOf (phase) (event) with | Action.failAll => (match phase with | Phase.committing => (match event with | Event.commitFail => true | Event.request => false | Event.batchEnd => false | Event.commitOk => false) | Phase.idle => false | Phase.reading => false) | Action.nothing => true | Action.begin => true | Action.commit => true | Action.sendAll => true)

@[expose] public def checkCommitting (phase : Phase) (next : Phase) (action : Action) : Bool := (match next with | Phase.committing => (match phase with | Phase.committing => true | Phase.idle => false | Phase.reading => (match action with | Action.commit => true | Action.nothing => false | Action.begin => false | Action.sendAll => false | Action.failAll => false)) | Phase.idle => true | Phase.reading => true)

@[expose] public def committingFollowsCommit (phase : Phase) (event : Event) : Bool := checkCommitting (phase) (nextPhase (phase) (event)) (actionOf (phase) (event))

public theorem send_only_after_commit (phase : Phase) (event : Event) : (sendAllowed (phase) (event) = true) := by
  induction phase with
  | idle =>
    induction event with
    | request =>
      simp only [actionOf, sendAllowed]
    | batchEnd =>
      simp only [actionOf, sendAllowed]
    | commitOk =>
      simp only [actionOf, sendAllowed]
    | commitFail =>
      simp only [actionOf, sendAllowed]
  | reading =>
    induction event with
    | request =>
      simp only [actionOf, sendAllowed]
    | batchEnd =>
      simp only [actionOf, sendAllowed]
    | commitOk =>
      simp only [actionOf, sendAllowed]
    | commitFail =>
      simp only [actionOf, sendAllowed]
  | committing =>
    induction event with
    | request =>
      simp only [actionOf, sendAllowed]
    | batchEnd =>
      simp only [actionOf, sendAllowed]
    | commitOk =>
      simp only [actionOf, sendAllowed]
    | commitFail =>
      simp only [actionOf, sendAllowed]

public theorem fail_only_after_failed_commit (phase : Phase) (event : Event) : (failAllowed (phase) (event) = true) := by
  induction phase with
  | idle =>
    induction event with
    | request =>
      simp only [actionOf, failAllowed]
    | batchEnd =>
      simp only [actionOf, failAllowed]
    | commitOk =>
      simp only [actionOf, failAllowed]
    | commitFail =>
      simp only [actionOf, failAllowed]
  | reading =>
    induction event with
    | request =>
      simp only [actionOf, failAllowed]
    | batchEnd =>
      simp only [actionOf, failAllowed]
    | commitOk =>
      simp only [actionOf, failAllowed]
    | commitFail =>
      simp only [actionOf, failAllowed]
  | committing =>
    induction event with
    | request =>
      simp only [actionOf, failAllowed]
    | batchEnd =>
      simp only [actionOf, failAllowed]
    | commitOk =>
      simp only [actionOf, failAllowed]
    | commitFail =>
      simp only [actionOf, failAllowed]

public theorem committing_follows_commit (phase : Phase) (event : Event) : (committingFollowsCommit (phase) (event) = true) := by
  induction phase with
  | idle =>
    induction event with
    | request =>
      rfl
    | batchEnd =>
      rfl
    | commitOk =>
      rfl
    | commitFail =>
      rfl
  | reading =>
    induction event with
    | request =>
      rfl
    | batchEnd =>
      rfl
    | commitOk =>
      rfl
    | commitFail =>
      rfl
  | committing =>
    induction event with
    | request =>
      rfl
    | batchEnd =>
      rfl
    | commitOk =>
      rfl
    | commitFail =>
      rfl

public inductive Method where
  | get
  | post
  | other

public inductive Shape where
  | feed
  | health
  | posts
  | postId
  | postLike
  | unknown

public inductive Route where
  | notFound
  | feed
  | health
  | post
  | create
  | like

@[expose] public def routeOf (method : Method) (shape : Shape) : Route := (match method with | Method.get => (match shape with | Shape.feed => Route.feed | Shape.health => Route.health | Shape.posts => Route.notFound | Shape.postId => Route.post | Shape.postLike => Route.notFound | Shape.unknown => Route.notFound) | Method.post => (match shape with | Shape.feed => Route.notFound | Shape.health => Route.notFound | Shape.posts => Route.create | Shape.postId => Route.notFound | Shape.postLike => Route.like | Shape.unknown => Route.notFound) | Method.other => Route.notFound)

@[expose] public def isWrite (route : Route) : Bool := (match route with | Route.notFound => false | Route.feed => false | Route.health => false | Route.post => false | Route.create => true | Route.like => true)

@[expose] public def needsAuth (route : Route) : Bool := (match route with | Route.create => true | Route.like => true | Route.notFound => false | Route.feed => false | Route.health => false | Route.post => false)

@[expose] public def checkWriteMethod (method : Method) (route : Route) : Bool := (match route with | Route.create => (match method with | Method.post => true | Method.get => false | Method.other => false) | Route.like => (match method with | Method.post => true | Method.get => false | Method.other => false) | Route.notFound => true | Route.feed => true | Route.health => true | Route.post => true)

@[expose] public def writeComesFromPost (method : Method) (shape : Shape) : Bool := checkWriteMethod (method) (routeOf (method) (shape))

public theorem every_write_needs_a_token (route : Route) : (isWrite (route) = needsAuth (route)) := by
  induction route with
  | notFound =>
    simp only [isWrite, needsAuth]
  | feed =>
    simp only [isWrite, needsAuth]
  | health =>
    simp only [isWrite, needsAuth]
  | post =>
    simp only [isWrite, needsAuth]
  | create =>
    simp only [isWrite, needsAuth]
  | like =>
    simp only [isWrite, needsAuth]

public theorem only_post_writes (method : Method) (shape : Shape) : (writeComesFromPost (method) (shape) = true) := by
  induction method with
  | get =>
    induction shape with
    | feed =>
      simp only [checkWriteMethod, routeOf, writeComesFromPost]
    | health =>
      simp only [checkWriteMethod, routeOf, writeComesFromPost]
    | posts =>
      simp only [checkWriteMethod, routeOf, writeComesFromPost]
    | postId =>
      simp only [checkWriteMethod, routeOf, writeComesFromPost]
    | postLike =>
      simp only [checkWriteMethod, routeOf, writeComesFromPost]
    | unknown =>
      simp only [checkWriteMethod, routeOf, writeComesFromPost]
  | post =>
    induction shape with
    | feed =>
      simp only [checkWriteMethod, routeOf, writeComesFromPost]
    | health =>
      simp only [checkWriteMethod, routeOf, writeComesFromPost]
    | posts =>
      simp only [checkWriteMethod, routeOf, writeComesFromPost]
    | postId =>
      simp only [checkWriteMethod, routeOf, writeComesFromPost]
    | postLike =>
      simp only [checkWriteMethod, routeOf, writeComesFromPost]
    | unknown =>
      simp only [checkWriteMethod, routeOf, writeComesFromPost]
  | other =>
    induction shape with
    | feed =>
      simp only [checkWriteMethod, routeOf, writeComesFromPost]
    | health =>
      simp only [checkWriteMethod, routeOf, writeComesFromPost]
    | posts =>
      simp only [checkWriteMethod, routeOf, writeComesFromPost]
    | postId =>
      simp only [checkWriteMethod, routeOf, writeComesFromPost]
    | postLike =>
      simp only [checkWriteMethod, routeOf, writeComesFromPost]
    | unknown =>
      simp only [checkWriteMethod, routeOf, writeComesFromPost]

public theorem unknown_methods_are_not_found (shape : Shape) : (routeOf (Method.other) (shape) = Route.notFound) := by
  simp only [routeOf]

public inductive Flag where
  | yes
  | no

@[expose] public def shouldHold (room : Flag) (gateClosed : Flag) (write : Flag) (connectionHeld : Flag) : Flag := (match room with | Flag.no => Flag.no | Flag.yes => (match connectionHeld with | Flag.yes => Flag.yes | Flag.no => (match gateClosed with | Flag.yes => write | Flag.no => Flag.no)))

public theorem reads_go_on_while_writes_wait (room : Flag) (gateClosed : Flag) : (shouldHold (room) (gateClosed) (Flag.no) (Flag.no) = Flag.no) := by
  induction room with
  | yes =>
    induction gateClosed with
    | yes =>
      simp only [shouldHold]
    | no =>
      simp only [shouldHold]
  | no =>
    induction gateClosed with
    | yes =>
      simp only [shouldHold]
    | no =>
      simp only [shouldHold]

public theorem a_held_connection_keeps_its_order (gateClosed : Flag) (write : Flag) : (shouldHold (Flag.yes) (gateClosed) (write) (Flag.yes) = Flag.yes) := by
  induction gateClosed with
  | yes =>
    induction write with
    | yes =>
      simp only [shouldHold]
    | no =>
      simp only [shouldHold]
  | no =>
    induction write with
    | yes =>
      simp only [shouldHold]
    | no =>
      simp only [shouldHold]

public theorem a_closed_gate_holds_writes (connectionHeld : Flag) : (shouldHold (Flag.yes) (Flag.yes) (Flag.yes) (connectionHeld) = Flag.yes) := by
  induction connectionHeld with
  | yes =>
    simp only [shouldHold]
  | no =>
    simp only [shouldHold]

public theorem an_open_gate_holds_nothing_new (room : Flag) (write : Flag) : (shouldHold (room) (Flag.no) (write) (Flag.no) = Flag.no) := by
  induction room with
  | yes =>
    induction write with
    | yes =>
      simp only [shouldHold]
    | no =>
      simp only [shouldHold]
  | no =>
    induction write with
    | yes =>
      simp only [shouldHold]
    | no =>
      simp only [shouldHold]

public theorem a_full_hold_queue_holds_nothing (gateClosed : Flag) (write : Flag) (connectionHeld : Flag) : (shouldHold (Flag.no) (gateClosed) (write) (connectionHeld) = Flag.no) := by
  induction gateClosed with
  | yes =>
    induction write with
    | yes =>
      induction connectionHeld with
      | yes =>
        simp only [shouldHold]
      | no =>
        simp only [shouldHold]
    | no =>
      induction connectionHeld with
      | yes =>
        simp only [shouldHold]
      | no =>
        simp only [shouldHold]
  | no =>
    induction write with
    | yes =>
      induction connectionHeld with
      | yes =>
        simp only [shouldHold]
      | no =>
        simp only [shouldHold]
    | no =>
      induction connectionHeld with
      | yes =>
        simp only [shouldHold]
      | no =>
        simp only [shouldHold]

@[expose] public def gateNext (closed : Flag) (overLimit : Flag) (copied : Flag) (timedOut : Flag) : Flag := (match closed with | Flag.no => overLimit | Flag.yes => (match copied with | Flag.yes => Flag.no | Flag.no => (match timedOut with | Flag.yes => Flag.no | Flag.no => Flag.yes)))

public theorem the_gate_stays_closed_until_the_log_is_copied (overLimit : Flag) : (gateNext (Flag.yes) (overLimit) (Flag.no) (Flag.no) = Flag.yes) := by
  induction overLimit with
  | yes =>
    simp only [gateNext]
  | no =>
    simp only [gateNext]

public theorem the_gate_closes_at_the_limit (copied : Flag) (timedOut : Flag) : (gateNext (Flag.no) (Flag.yes) (copied) (timedOut) = Flag.yes) := by
  induction copied with
  | yes =>
    induction timedOut with
    | yes =>
      simp only [gateNext]
    | no =>
      simp only [gateNext]
  | no =>
    induction timedOut with
    | yes =>
      simp only [gateNext]
    | no =>
      simp only [gateNext]

public theorem the_gate_opens_when_the_log_is_copied (overLimit : Flag) (timedOut : Flag) : (gateNext (Flag.yes) (overLimit) (Flag.yes) (timedOut) = Flag.no) := by
  induction overLimit with
  | yes =>
    induction timedOut with
    | yes =>
      simp only [gateNext]
    | no =>
      simp only [gateNext]
  | no =>
    induction timedOut with
    | yes =>
      simp only [gateNext]
    | no =>
      simp only [gateNext]

public theorem a_timeout_always_opens_the_gate (overLimit : Flag) (copied : Flag) : (gateNext (Flag.yes) (overLimit) (copied) (Flag.yes) = Flag.no) := by
  induction overLimit with
  | yes =>
    induction copied with
    | yes =>
      simp only [gateNext]
    | no =>
      simp only [gateNext]
  | no =>
    induction copied with
    | yes =>
      simp only [gateNext]
    | no =>
      simp only [gateNext]

public inductive Status where
  | badRequest
  | unauthorized
  | notFound
  | serverError

public inductive Failure where
  | notFound
  | badId
  | postMissing
  | noBearer
  | badToken
  | badPayload
  | badJson
  | noBody
  | longBody
  | internal

@[expose] public def statusOf (failure : Failure) : Status := (match failure with | Failure.notFound => Status.notFound | Failure.badId => Status.badRequest | Failure.postMissing => Status.notFound | Failure.noBearer => Status.unauthorized | Failure.badToken => Status.unauthorized | Failure.badPayload => Status.unauthorized | Failure.badJson => Status.badRequest | Failure.noBody => Status.badRequest | Failure.longBody => Status.badRequest | Failure.internal => Status.serverError)

@[expose] public def isServerStatus (status : Status) : Bool := (match status with | Status.serverError => true | Status.badRequest => false | Status.unauthorized => false | Status.notFound => false)

@[expose] public def isInternal (failure : Failure) : Bool := (match failure with | Failure.internal => true | Failure.notFound => false | Failure.badId => false | Failure.postMissing => false | Failure.noBearer => false | Failure.badToken => false | Failure.badPayload => false | Failure.badJson => false | Failure.noBody => false | Failure.longBody => false)

public theorem only_an_internal_failure_is_a_server_error (failure : Failure) : (isServerStatus (statusOf (failure)) = isInternal (failure)) := by
  induction failure with
  | notFound =>
    simp only [isInternal, isServerStatus, statusOf]
  | badId =>
    simp only [isInternal, isServerStatus, statusOf]
  | postMissing =>
    simp only [isInternal, isServerStatus, statusOf]
  | noBearer =>
    simp only [isInternal, isServerStatus, statusOf]
  | badToken =>
    simp only [isInternal, isServerStatus, statusOf]
  | badPayload =>
    simp only [isInternal, isServerStatus, statusOf]
  | badJson =>
    simp only [isInternal, isServerStatus, statusOf]
  | noBody =>
    simp only [isInternal, isServerStatus, statusOf]
  | longBody =>
    simp only [isInternal, isServerStatus, statusOf]
  | internal =>
    simp only [isInternal, isServerStatus, statusOf]

public inductive EscapeClass where
  | plain
  | backslash
  | unicode

@[expose] public def escapeClass (octet : UInt8) : EscapeClass := (if (LexLeanRuntime.equal (octet) ((34 : UInt8)) : Bool) then EscapeClass.backslash else (if (LexLeanRuntime.equal (octet) ((92 : UInt8)) : Bool) then EscapeClass.backslash else (if (LexLeanRuntime.equal ((LexLeanRuntime.bitAnd (octet) ((224 : UInt8)) : UInt8)) ((0 : UInt8)) : Bool) then EscapeClass.unicode else EscapeClass.plain)))

public theorem a_quote_is_escaped : (escapeClass ((34 : UInt8)) = EscapeClass.backslash) := by
  rfl

public theorem a_backslash_is_escaped : (escapeClass ((92 : UInt8)) = EscapeClass.backslash) := by
  rfl

public theorem the_first_control_byte_is_escaped : (escapeClass ((0 : UInt8)) = EscapeClass.unicode) := by
  rfl

public theorem the_last_control_byte_is_escaped : (escapeClass ((31 : UInt8)) = EscapeClass.unicode) := by
  rfl

public theorem a_space_is_plain : (escapeClass ((32 : UInt8)) = EscapeClass.plain) := by
  rfl

public theorem the_top_byte_is_plain : (escapeClass ((255 : UInt8)) = EscapeClass.plain) := by
  rfl

@[expose] public def cat3 (a : ByteArray) (b : ByteArray) (c : ByteArray) : ByteArray := (LexLeanRuntime.append ((LexLeanRuntime.append (a) (b) : ByteArray)) (c) : ByteArray)

@[expose] public def cat4 (a : ByteArray) (b : ByteArray) (c : ByteArray) (d : ByteArray) : ByteArray := (LexLeanRuntime.append (cat3 (a) (b) (c)) (d) : ByteArray)

@[expose] public def define (name : ByteArray) (value : ByteArray) : ByteArray := cat4 ((LexLeanRuntime.utf8Encode ("#define ") : ByteArray)) (name) ((LexLeanRuntime.utf8Encode (" ") : ByteArray)) ((LexLeanRuntime.append (value) ((LexLeanRuntime.utf8Encode ("\n") : ByteArray)) : ByteArray))

@[expose] public def row2 (a : ByteArray) (b : ByteArray) : ByteArray := cat4 (a) ((LexLeanRuntime.utf8Encode (", ") : ByteArray)) (b) ((LexLeanRuntime.utf8Encode (", ") : ByteArray))

@[expose] public def phaseText (phase : Phase) : ByteArray := (match phase with | Phase.idle => (LexLeanRuntime.utf8Encode ("0") : ByteArray) | Phase.reading => (LexLeanRuntime.utf8Encode ("1") : ByteArray) | Phase.committing => (LexLeanRuntime.utf8Encode ("2") : ByteArray))

@[expose] public def eventText (event : Event) : ByteArray := (match event with | Event.request => (LexLeanRuntime.utf8Encode ("0") : ByteArray) | Event.batchEnd => (LexLeanRuntime.utf8Encode ("1") : ByteArray) | Event.commitOk => (LexLeanRuntime.utf8Encode ("2") : ByteArray) | Event.commitFail => (LexLeanRuntime.utf8Encode ("3") : ByteArray))

@[expose] public def actionText (action : Action) : ByteArray := (match action with | Action.nothing => (LexLeanRuntime.utf8Encode ("0") : ByteArray) | Action.begin => (LexLeanRuntime.utf8Encode ("1") : ByteArray) | Action.commit => (LexLeanRuntime.utf8Encode ("2") : ByteArray) | Action.sendAll => (LexLeanRuntime.utf8Encode ("3") : ByteArray) | Action.failAll => (LexLeanRuntime.utf8Encode ("4") : ByteArray))

@[expose] public def methodText (method : Method) : ByteArray := (match method with | Method.get => (LexLeanRuntime.utf8Encode ("0") : ByteArray) | Method.post => (LexLeanRuntime.utf8Encode ("1") : ByteArray) | Method.other => (LexLeanRuntime.utf8Encode ("2") : ByteArray))

@[expose] public def shapeText (shape : Shape) : ByteArray := (match shape with | Shape.feed => (LexLeanRuntime.utf8Encode ("0") : ByteArray) | Shape.health => (LexLeanRuntime.utf8Encode ("1") : ByteArray) | Shape.posts => (LexLeanRuntime.utf8Encode ("2") : ByteArray) | Shape.postId => (LexLeanRuntime.utf8Encode ("3") : ByteArray) | Shape.postLike => (LexLeanRuntime.utf8Encode ("4") : ByteArray) | Shape.unknown => (LexLeanRuntime.utf8Encode ("5") : ByteArray))

@[expose] public def routeText (route : Route) : ByteArray := (match route with | Route.notFound => (LexLeanRuntime.utf8Encode ("0") : ByteArray) | Route.feed => (LexLeanRuntime.utf8Encode ("1") : ByteArray) | Route.health => (LexLeanRuntime.utf8Encode ("2") : ByteArray) | Route.post => (LexLeanRuntime.utf8Encode ("3") : ByteArray) | Route.create => (LexLeanRuntime.utf8Encode ("4") : ByteArray) | Route.like => (LexLeanRuntime.utf8Encode ("5") : ByteArray))

@[expose] public def boolText (value : Bool) : ByteArray := (if value then (LexLeanRuntime.utf8Encode ("1") : ByteArray) else (LexLeanRuntime.utf8Encode ("0") : ByteArray))

@[expose] public def escapeText («class» : EscapeClass) : ByteArray := (match «class» with | EscapeClass.plain => (LexLeanRuntime.utf8Encode ("0") : ByteArray) | EscapeClass.backslash => (LexLeanRuntime.utf8Encode ("1") : ByteArray) | EscapeClass.unicode => (LexLeanRuntime.utf8Encode ("2") : ByteArray))

@[expose] public def batchNames : ByteArray := cat4 (cat3 (define ((LexLeanRuntime.utf8Encode ("PHASE_IDLE") : ByteArray)) (phaseText (Phase.idle))) (define ((LexLeanRuntime.utf8Encode ("PHASE_READING") : ByteArray)) (phaseText (Phase.reading))) (define ((LexLeanRuntime.utf8Encode ("PHASE_COMMITTING") : ByteArray)) (phaseText (Phase.committing)))) (cat4 (define ((LexLeanRuntime.utf8Encode ("EVENT_REQUEST") : ByteArray)) (eventText (Event.request))) (define ((LexLeanRuntime.utf8Encode ("EVENT_BATCH_END") : ByteArray)) (eventText (Event.batchEnd))) (define ((LexLeanRuntime.utf8Encode ("EVENT_COMMIT_OK") : ByteArray)) (eventText (Event.commitOk))) (define ((LexLeanRuntime.utf8Encode ("EVENT_COMMIT_FAIL") : ByteArray)) (eventText (Event.commitFail)))) (cat3 (define ((LexLeanRuntime.utf8Encode ("ACTION_NOTHING") : ByteArray)) (actionText (Action.nothing))) (define ((LexLeanRuntime.utf8Encode ("ACTION_BEGIN") : ByteArray)) (actionText (Action.begin))) (define ((LexLeanRuntime.utf8Encode ("ACTION_COMMIT") : ByteArray)) (actionText (Action.commit)))) ((LexLeanRuntime.append (define ((LexLeanRuntime.utf8Encode ("ACTION_SEND_ALL") : ByteArray)) (actionText (Action.sendAll))) (define ((LexLeanRuntime.utf8Encode ("ACTION_FAIL_ALL") : ByteArray)) (actionText (Action.failAll))) : ByteArray))

@[expose] public def phaseRow (phase : Phase) : ByteArray := cat3 ((LexLeanRuntime.utf8Encode ("    {") : ByteArray)) ((LexLeanRuntime.append (row2 (phaseText (nextPhase (phase) (Event.request))) (phaseText (nextPhase (phase) (Event.batchEnd)))) (row2 (phaseText (nextPhase (phase) (Event.commitOk))) (phaseText (nextPhase (phase) (Event.commitFail)))) : ByteArray)) ((LexLeanRuntime.utf8Encode ("},\n") : ByteArray))

@[expose] public def actionRow (phase : Phase) : ByteArray := cat3 ((LexLeanRuntime.utf8Encode ("    {") : ByteArray)) ((LexLeanRuntime.append (row2 (actionText (actionOf (phase) (Event.request))) (actionText (actionOf (phase) (Event.batchEnd)))) (row2 (actionText (actionOf (phase) (Event.commitOk))) (actionText (actionOf (phase) (Event.commitFail)))) : ByteArray)) ((LexLeanRuntime.utf8Encode ("},\n") : ByteArray))

