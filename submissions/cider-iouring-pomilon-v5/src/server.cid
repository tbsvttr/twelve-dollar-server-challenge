const SYS_IO_URING_SETUP: i64 = 425;
const SYS_IO_URING_ENTER: i64 = 426;
const SYS_IO_URING_REGISTER: i64 = 427;

const IORING_OP_POLL_ADD: u8 = 6 as u8;
const IORING_OP_ACCEPT: u8 = 13 as u8;
const IORING_OP_ASYNC_CANCEL: u8 = 14 as u8;
const IORING_OP_CLOSE: u8 = 19 as u8;
const IORING_OP_SEND: u8 = 26 as u8;
const IORING_OP_RECV: u8 = 27 as u8;

const IOSQE_FIXED_FILE: u8 = 0x01 as u8;
const IOSQE_BUFFER_SELECT: u8 = 0x20 as u8;
const IOSQE_CQE_SKIP_SUCCESS: u8 = 0x40 as u8;

const IORING_REGISTER_FILES: i64 = 2;
const IORING_REGISTER_EVENTFD: i64 = 4;
const IORING_REGISTER_PBUF_RING: i64 = 22;
const IORING_ENTER_GETEVENTS: i64 = 1;
const IORING_ENTER_EXT_ARG: i64 = 8;
const IORING_ACCEPT_MULTISHOT: u16 = 1 as u16;
const IORING_RECV_MULTISHOT: u16 = 2 as u16;
const IORING_POLL_ADD_MULTI: u32 = 1 as u32;
const IORING_FILE_INDEX_ALLOC: u32 = 0xffffffff as u32;
const POLLIN: u32 = 1 as u32;
const POLLERR: u32 = 8 as u32;
const POLLHUP: u32 = 16 as u32;
const POLLRDHUP: u32 = 8192 as u32;

const IORING_SQ_TASKRUN: u32 = 2 as u32;
const IORING_SQ_CQ_OVERFLOW: u32 = 4 as u32;
const IORING_SETUP_TASKRUN_FLAG: u32 = 512 as u32;

// v4's idle model: every connection keeps a multishot receive armed. A
// pending multishot receive holds no provided buffer until data arrives.
const NBUFS: i64 = 1024;
const BUF_SZ: i64 = 2048;
const RESP_BUF_SZ: i64 = 8192;

// Response arenas: 1 MiB each, eight preallocated and retained (8 MiB), more
// allocated for an unusually large batch and freed once their sends finish.
const ARENA_CAP: i64 = 1048576 as i64;
const ARENA_HDR: i64 = 24 as i64;
const ARENA_POOL: int = 8;
const ARENA_PREWARM: int = 8;
const ARENA_MAX_BATCH: int = 256;
const MAX_REPLIES: int = 8192;

const CQE_BUDGET: int = 2048;
const MAX_JOBS: int = 65536;
const JOB_ARENA_SZ: i64 = 8388608 as i64;
const WAL_CKPT_FRAMES: int = 1000;
const WAL_HIGH_BYTES: i64 = 67108864 as i64;

// Drain first: the multishot receives keep reading, but answers are capped so
// one turn stays short enough for replies to leave while the backlog is read.
const ANSWERS_PER_BATCH: int = 2048;

// Eight SO_REUSEPORT listening sockets share the port. Their separate
// accept queues hold ~8 * somaxconn connections through a stall. All eight
// are created at startup, as in the #1 server; rings are created lazily.
const N_LISTEN: int = 8;
const RING_MAX: int = 8;

// #1 accept thresholds: make the next ring 8192 slots before the last is
// full, arm the next ring then, and stop a ring 4096 slots before its table
// is full (an accept that finds the table full resets the client).
const ACCEPT_NEXT: int = 8192;
const ACCEPT_STOP: int = 4096;

const SWEEP_SEC: int = 2;
const IDLE_SECONDS: int = 90;

const EPOLLIN: u32 = 1 as u32;
const EPOLLET: u32 = 2147483648 as u32;
const EPOLL_CTL_ADD: int = 1;
const EPOLL_CLOEXEC: int = 524288;
const EFD_NONBLOCK: int = 2048;
const EFD_CLOEXEC: int = 524288;

struct KernelTimespec {
    var tv_sec: i64;
    var tv_nsec: i64;
}

struct IoUringGeteventsArg {
    var sigmask: u64;
    var sigmask_sz: u32;
    var min_wait_usec: u32;
    var ts: u64;
}

struct RLimit {
    var rlim_cur: u64;
    var rlim_max: u64;
}

struct SockAddrIn {
    var sin_family: u16;
    var sin_port: u16;
    var sin_addr: u32;
    var sin_zero: [u8; 8];
}

struct SQRingOffsets {
    var head: u32;
    var tail: u32;
    var ring_mask: u32;
    var ring_entries: u32;
    var flags: u32;
    var dropped: u32;
    var array: u32;
    var resv1: u32;
    var user_addr: u64;
}

struct CQRingOffsets {
    var head: u32;
    var tail: u32;
    var ring_mask: u32;
    var ring_entries: u32;
    var overflow: u32;
    var cqes: u32;
    var flags: u32;
    var resv1: u32;
    var user_addr: u64;
}

struct IoUringParams {
    var sq_entries: u32;
    var cq_entries: u32;
    var flags: u32;
    var sq_thread_cpu: u32;
    var sq_thread_idle: u32;
    var features: u32;
    var wq_fd: u32;
    var resv0: u32;
    var resv1: u32;
    var resv2: u32;
    var sq_off: SQRingOffsets;
    var cq_off: CQRingOffsets;
}

struct IoUringBufReg {
    var ring_addr: u64;
    var ring_entries: u32;
    var bgid: u16;
    var flags: u16;
    var resv1: u64;
    var resv2: u64;
    var resv3: u64;
}

struct IoUringBuf {
    var addr: u64;
    var len: u32;
    var bid: u16;
    var resv: u16;
}

struct IoUringSqe {
    var opcode: u8;
    var flags: u8;
    var ioprio: u16;
    var fd: i32;
    var off: u64;
    var addr: u64;
    var len: u32;
    var rw_flags: u32;
    var user_data: u64;
    var buf_index: u16;
    var personality: u16;
    var file_index: u32;
    var opt1: u64;
    var opt2: u64;
}

struct IoUringCqe {
    var user_data: u64;
    var res: i32;
    var flags: u32;
}

// Linux x86-64 struct epoll_event is packed: 4-byte events + 8-byte data.
@packed struct EpollEvent {
    var events: u32;
    var data: u64;
}

// OpenSSL SHA256_CTX (SHA_LONG is 32-bit on x86-64).
struct SHA256Ctx {
    var h: [u32; 8];
    var nl: u32;
    var nh: u32;
    var data: [u32; 16];
    var num: u32;
    var md_len: u32;
}

struct Buffer {
    var ptr: *u8;
    var len: u32;
    var cap: u32;
}

// Per-batch response arena. A response is written once into arena data and
// sent straight from it; the arena is not reused until every send that points
// into it has completed (refs reaches zero).
struct Arena {
    var next: *Arena;
    var refs: u32;
    var used: u32;
    var cap: u32;
    var pad: u32;
}

// One response waiting for this batch's commit.
struct Reply {
    var arena: *Arena;
    var off: u32;
    var len: u32;
    var fd: i32;
    var ring: i32;
    var gen: u32;
}

struct Conn {
    var input: Buffer;
    var send_arena: *Arena; // held until the send completes
    var send_off: u32;
    var send_len: u32;
    var sent: u32;
    var gen: u32;
    var state: u32;
    var last_active: u32;
}

var CONN_LIVE: u32 = 1 as u32;
var CONN_RECEIVING: u32 = 2 as u32;
var CONN_SENDING: u32 = 4 as u32;
var CONN_CLOSING: u32 = 8 as u32;
var CONN_DIRTY: u32 = 16 as u32;
var CONN_REARM: u32 = 32 as u32; // multishot receive ended with ENOBUFS
var CONN_HOLD: u32 = 64 as u32;
var CONN_REPLIED: u32 = 512 as u32; // response waiting for commit/send
var CONN_READY: u32 = 1024 as u32;  // buffered request waiting to be parsed

// A connection with already-read pipelined bytes waiting for its turn.
struct ConnRef {
    var fd: i32;
    var ring: i32;
    var gen: u32;
}

struct WorkerState {
    var id: int;
    var ring_fd: int;
    var efd: int;
    var hot: int;
    var sq_ptr: *u8;
    var cq_ptr: *u8;
    var sqes: *IoUringSqe;
    var sq_head: *u32;
    var sq_tail: *u32;
    var sq_mask: *u32;
    var sq_array: *u32;
    var sq_flags: *u32;
    var cq_head: *u32;
    var cq_tail: *u32;
    var cq_mask: *u32;
    var cqes: *IoUringCqe;
    var pbuf_ring_mem: *u8;
    var pbuf_buf_mem: *u8;
    var ptail_ptr: *u16;
    var conns: *Conn;
    var open_conns: int;
    var accept_gen: u32;
    var body_buf: *char;
    var dirty_fds: [i32; 4096];
    var dirty_count: int;
    var held_fds: [i32; 4096];
    var held_count: int;
    var rearm_fds: *i32;
    var rearm_head: int;
    var rearm_tail: int;
    var rearm_cap: int;
    var nslots: int;
    var accept_armed: int;
    var accept_cancelling: int;
}

// One request decoded from a receive buffer. The bytes live in g_job_arena
// until the end of the global batch, so a provided buffer can be recycled
// immediately after its CQE is handled.
struct Job {
    var ring: int;
    var fd: int;
    var gen: u32;
    var is_write: u8;
    var close_after: u8;
    var preset: u8;
    var status: int;
    var method: *char;
    var path: *char;
    var auth: *char;
    var body: *char;
    var body_len: int;
}

struct AuthClaims {
    var user_id: i64;
    var username: [char; 256];
}

struct BufWriter {
    var buf: *char;
    var len: int;
    var cap: int;
}

// Global server state
var g_listen_fds: [i32; 8] = [-1 as i32, ...];
var g_listener_count: int = 0;
var g_host_ptr: *char = nil;
var g_port: int = 80;
var g_nr_max: int = 1;
var g_ring_grow_failed: int = 0;
var g_db: *void = nil;
var g_db_mutex: *void = nil;
var g_secret_ptr: *char = nil;
var g_start_time: i64 = 0 as i64;
var g_last_ckpt: i64 = 0 as i64;
var g_nr_files: i64 = 65535 as i64;
var g_nworkers: int = 1;
var g_in_txn: int = 0;
var g_wal_frames: int = 0;
var g_wal_high_frames: int = 16384;
var g_epfd: int = -1;
var g_states: *WorkerState = nil;

// Global batch budget: answers are capped so a burst leaves replies going
// out while the rest waits in the connection's own buffer for the next turn.
var g_answers_left: int = 0;

// Connections with already-read pipelined bytes waiting to be parsed after
// their previous response has been sent. Also processed by the batch.
var g_ready: *ConnRef = nil;
var g_ready_head: int = 0;
var g_ready_tail: int = 0;
var g_ready_cap: int = 0;

// Per-batch response arenas and the replies that point into them.
var g_arena_pool: *Arena = nil;
var g_arena_pool_n: int = 0;
var g_cur_arena: *Arena = nil;
var g_batch_head: *Arena = nil;
var g_n_batch_arenas: int = 0;
var g_replies: *Reply = nil;
var g_nreplies: int = 0;

// Idle keepalive sweep.
var g_last_sweep: i64 = 0 as i64;

// Global batch: decode CQEs from every ring, then one transaction for all jobs.
var g_jobs: *Job = nil;
var g_njobs: int = 0;
var g_job_arena: *char = nil;
var g_job_arena_used: u32 = 0 as u32;

// Off-loop checkpoint. The event loop owns g_db; this thread owns g_ckpt_db.
var g_ckpt_db: *void = nil;
var g_ckpt_mu: *void = nil;
var g_ckpt_cv: *void = nil;
var g_ckpt_wanted: int = 0;

// Precomputed HMAC-SHA256 key pads. Every request is still verified.
var g_hmac_ipad: *u8 = nil;
var g_hmac_opad: *u8 = nil;
var g_hmac_ready: int = 0;

// Global SQLite statements
var g_stmt_feed: *void = nil;
var g_stmt_feed_ids: *void = nil;
var g_stmt_feed_likes: *void = nil;
var g_stmt_feed_rows: *void = nil;
var g_stmt_post: *void = nil;
var g_stmt_health: *void = nil;
var g_stmt_check_post: *void = nil;
var g_stmt_like_exists: *void = nil;
var g_stmt_insert_like: *void = nil;
var g_stmt_insert_post: *void = nil;
var g_stmt_begin: *void = nil;
var g_stmt_commit: *void = nil;
var g_stmt_rollback: *void = nil;
var g_feed_scratch: *char = nil;

func on_wal_hook(arg: *void, db: *void, zDb: *char, nEntry: int) -> int {
    g_wal_frames = nEntry;
    if (nEntry >= WAL_CKPT_FRAMES) {
        pthread_mutex_lock(g_ckpt_mu);
        if (g_ckpt_wanted == 0) {
            g_ckpt_wanted = 1;
            pthread_cond_signal(g_ckpt_cv);
        }
        pthread_mutex_unlock(g_ckpt_mu);
    }
    return 0;
}

func checkpoint_main(arg: *void) -> *void {
    var main_db: string = "main\0";
    // A checkpoint pass at the default priority can hold the single event
    // loop off the CPU for its whole length at the memory wall.
    nice(19);
    while (1 == 1) {
        pthread_mutex_lock(g_ckpt_mu);
        while (g_ckpt_wanted == 0) {
            pthread_cond_wait(g_ckpt_cv, g_ckpt_mu);
        }
        pthread_mutex_unlock(g_ckpt_mu);

        sqlite3_wal_checkpoint_v2(g_ckpt_db, &main_db[0] as *char, 0, nil, nil);
        g_ckpt_wanted = 0;
    }
    return nil;
}

func checkpoint_start(path: *char) -> void {
    var vfs_name: string = "unix-excl\0";
    var rc: int = sqlite3_open_v2(path, &g_ckpt_db, 2 | 16384, &vfs_name[0] as *char);
    if (rc != 0) {
        var err_m: string = "Failed to open SQLite checkpoint connection\0";
        puts(&err_m[0] as *char);
        exit(1);
    }
    sqlite3_busy_timeout(g_ckpt_db, 5000);
    var pragma_ck: string = "PRAGMA journal_mode=WAL; PRAGMA synchronous=NORMAL; PRAGMA wal_autocheckpoint=0;\0";
    sqlite3_exec(g_ckpt_db, &pragma_ck[0] as *char, nil, nil, nil);

    g_ckpt_mu = malloc(64);
    g_ckpt_cv = malloc(64);
    pthread_mutex_init(g_ckpt_mu, nil);
    pthread_cond_init(g_ckpt_cv, nil);

    var t: u64 = 0 as u64;
    if (pthread_create(&t, nil, &checkpoint_main as *void, nil) != 0) {
        var err_t: string = "Failed to start checkpoint thread\0";
        puts(&err_t[0] as *char);
        exit(1);
    }
    pthread_detach(t);
}

// Safety valve: if background checkpoints keep missing the restart point and
// the WAL passes 64 MiB, checkpoint once here between batches. Responses never
// wait for this; writes are already durable in the WAL.
func wal_bound_check() -> void {
    if (g_wal_frames < g_wal_high_frames) { return; }
    if (g_ckpt_wanted != 0) { return; }
    var main_db: string = "main\0";
    var rc: int = sqlite3_wal_checkpoint_v2(g_db, &main_db[0] as *char, 0, nil, nil);
    if (rc == 0) {
        g_wal_frames = 0;
    }
}

func ensure_db_txn() -> void {
    if (g_in_txn == 0) {
        var stmt_b: *void = g_stmt_begin;
        sqlite3_step(stmt_b);
        sqlite3_reset(stmt_b);
        g_in_txn = 1;
    }
}

func buf_append(w: *BufWriter, s: *char, slen: int) -> void {
    if (w->len + slen >= w->cap) { return; }
    memcpy((w->buf as i64 + w->len as i64) as *void, s as *void, slen as i64);
    w->len = w->len + slen;
    var term: *char = (w->buf as i64 + w->len as i64) as *char;
    *term = 0 as char;
}

func buf_append_str(w: *BufWriter, s: *char) -> void {
    var slen: int = strlen(s) as int;
    buf_append(w, s, slen);
}

// Same as buf_append, but without the trailing NUL store. Used for hot JSON
// serialization where callers always pass an explicit length.
func buf_append_fast(w: *BufWriter, s: *char, slen: int) -> void {
    if (w->len + slen >= w->cap) { return; }
    memcpy((w->buf as i64 + w->len as i64) as *void, s as *void, slen as i64);
    w->len = w->len + slen;
}

func buf_append_int(w: *BufWriter, val: i64) -> void {
    fast_append_i64(w as *void, val);
}

func buf_append_json_escaped(w: *BufWriter, s: *char, slen: int) -> void {
    fast_append_json_string(w as *void, s, slen);
}

func write_error(out_buf: *char, max_len: int, msg: *char) -> int {
    var writer: BufWriter = BufWriter { buf: out_buf, len: 0, cap: max_len };
    var pre: string = "{\"error\":\0";
    buf_append_str(&writer, &pre[0] as *char);
    buf_append_json_escaped(&writer, msg, strlen(msg) as int);
    var suf: string = "}\0";
    buf_append_str(&writer, &suf[0] as *char);
    return writer.len;
}

func write_post_json_with_likes(w: *BufWriter, stmt: *void, like_count: i64) -> void {
    var p0: string = "{\"id\":\0";
    buf_append_fast(w, &p0[0] as *char, 6);
    var id: i64 = sqlite3_column_int64(stmt, 0);
    buf_append_int(w, id);

    var p1: string = ",\"body\":\0";
    buf_append_fast(w, &p1[0] as *char, 8);
    var body_ptr: *char = sqlite3_column_text(stmt, 1);
    var body_len: int = sqlite3_column_bytes(stmt, 1);
    buf_append_json_escaped(w, body_ptr, body_len);

    var p2: string = ",\"created_at\":\"\0";
    buf_append_fast(w, &p2[0] as *char, 15);
    var created_ptr: *char = sqlite3_column_text(stmt, 2);
    var created_len: int = sqlite3_column_bytes(stmt, 2);
    buf_append_fast(w, created_ptr, created_len);
    var q: string = "\"\0";
    buf_append_fast(w, &q[0] as *char, 1);

    var p3: string = ",\"author\":\0";
    buf_append_fast(w, &p3[0] as *char, 10);
    var author_ptr: *char = sqlite3_column_text(stmt, 3);
    var author_len: int = sqlite3_column_bytes(stmt, 3);
    buf_append_json_escaped(w, author_ptr, author_len);

    var p4: string = ",\"like_count\":\0";
    buf_append_fast(w, &p4[0] as *char, 14);
    buf_append_int(w, like_count);

    var p5: string = "}\0";
    buf_append_fast(w, &p5[0] as *char, 1);
}

func write_post_json(w: *BufWriter, stmt: *void) -> void {
    var like_count: i64 = sqlite3_column_int64(stmt, 4);
    write_post_json_with_likes(w, stmt, like_count);
}

func parse_positive_id(s: *char, out_val: *i64) -> int {
    var slen: int = strlen(s) as int;
    if (slen == 0) { return 0; }
    var val: i64 = 0 as i64;
    var i: int = 0;
    while (i < slen) {
        var c: char = s[i];
        if (c < 48 as char || c > 57 as char) { return 0; }
        val = val * (10 as i64) + ((c as i64) - (48 as i64));
        if (val > 999999999999 as i64) { return 0; }
        i = i + 1;
    }
    if (val <= 0 as i64) { return 0; }
    *out_val = val;
    return 1;
}

// Base64URL decoder in pure Cider
func b64_val(c: char) -> int {
    if (c >= 65 as char && c <= 90 as char) { return (c as int) - 65; }
    if (c >= 97 as char && c <= 122 as char) { return (c as int) - 97 + 26; }
    if (c >= 48 as char && c <= 57 as char) { return (c as int) - 48 + 52; }
    if (c == 45 as char || c == 43 as char) { return 62; }
    if (c == 95 as char || c == 47 as char) { return 63; }
    return -1;
}

func b64url_decode(src: *char, slen: int, dst: *char, max_dst: int) -> int {
    var out_len: int = 0;
    var i: int = 0;
    while (i < slen) {
        var remain: int = slen - i;
        if (remain == 1) { return -1; }

        var v0: int = b64_val(src[i]);
        var v1: int = b64_val(src[i + 1]);
        if (v0 < 0 || v1 < 0) { return -1; }

        var v2: int = 0;
        var v3: int = 0;
        if (remain >= 3) {
            v2 = b64_val(src[i + 2]);
            if (v2 < 0) { return -1; }
        }
        if (remain >= 4) {
            v3 = b64_val(src[i + 3]);
            if (v3 < 0) { return -1; }
        }

        if (out_len >= max_dst) { return -1; }
        dst[out_len] = (((v0 << 2) | (v1 >> 4)) & 255) as char;
        out_len = out_len + 1;

        if (remain >= 3) {
            if (out_len >= max_dst) { return -1; }
            dst[out_len] = ((((v1 & 15) << 4) | (v2 >> 2)) & 255) as char;
            out_len = out_len + 1;
        }

        if (remain >= 4) {
            if (out_len >= max_dst) { return -1; }
            dst[out_len] = ((((v2 & 3) << 6) | v3) & 255) as char;
            out_len = out_len + 1;
            i = i + 4;
        } else {
            i = slen;
        }
    }
    if (out_len < max_dst) {
        dst[out_len] = 0 as char;
    }
    return out_len;
}

// HMAC-SHA256 key schedule, computed once at startup. Only the key pads are
// cached; every request still verifies its own signature and claims.
func jwt_hmac_init(secret: *char) -> void {
    var key: [u8; 64] = uninit;
    var ipad: [u8; 64] = uninit;
    var opad: [u8; 64] = uninit;
    var i: int = 0;
    while (i < 64) { key[i] = 0 as u8; i = i + 1; }

    var n: int = strlen(secret) as int;
    if (n > 64) {
        var c: SHA256Ctx = uninit;
        SHA256_Init(&c as *void);
        SHA256_Update(&c as *void, secret as *void, n as i64);
        SHA256_Final(&key[0] as *void, &c as *void);
    } else {
        memcpy(&key[0] as *void, secret as *void, n as i64);
    }

    i = 0;
    while (i < 64) {
        ipad[i] = key[i] ^ (54 as u8);
        opad[i] = key[i] ^ (92 as u8);
        i = i + 1;
    }
    g_hmac_ipad = malloc(64) as *u8;
    g_hmac_opad = malloc(64) as *u8;
    memcpy(g_hmac_ipad as *void, &ipad[0] as *void, 64 as i64);
    memcpy(g_hmac_opad as *void, &opad[0] as *void, 64 as i64);
    OPENSSL_cleanse(&key[0] as *void, 64 as i64);
    OPENSSL_cleanse(&ipad[0] as *void, 64 as i64);
    OPENSSL_cleanse(&opad[0] as *void, 64 as i64);
    g_hmac_ready = 1;
}

func jwt_hmac_sha256(data: *void, len: i64, out: *void) -> int {
    if (g_hmac_ready == 0) { return -1; }
    var inner: [u8; 32] = uninit;
    var c: SHA256Ctx = uninit;
    SHA256_Init(&c as *void);
    SHA256_Update(&c as *void, g_hmac_ipad as *void, 64 as i64);
    SHA256_Update(&c as *void, data, len);
    SHA256_Final(&inner[0] as *void, &c as *void);
    SHA256_Init(&c as *void);
    SHA256_Update(&c as *void, g_hmac_opad as *void, 64 as i64);
    SHA256_Update(&c as *void, &inner[0] as *void, 32 as i64);
    SHA256_Final(out, &c as *void);
    return 0;
}

func verify_jwt(auth_header: *char, secret: *char, claims: *AuthClaims) -> int {
    if (auth_header == nil) { return 1; }
    if (strncmp(auth_header, "Bearer \0", 7 as i64) != 0) { return 1; }

    var token: *char = (auth_header as i64 + 7 as i64) as *char;
    while (*token == 32 as char) { token = (token as i64 + 1 as i64) as *char; }
    if (*token == 0 as char) { return 1; }

    var p1: *char = strchr(token, 46); // '.'
    if (p1 == nil) { return 2; }
    var p2: *char = strchr((p1 as i64 + 1 as i64) as *char, 46);
    if (p2 == nil) { return 2; }
    if (strchr((p2 as i64 + 1 as i64) as *char, 46) != nil) { return 2; } // extra dot

    var h_len: int = (p1 as i64 - token as i64) as int;
    var p_len: int = (p2 as i64 - p1 as i64 - 1 as i64) as int;
    var sig_str: *char = (p2 as i64 + 1 as i64) as *char;
    var s_len: int = strlen(sig_str) as int;
    if (h_len == 0 || p_len == 0 || s_len == 0) { return 2; }

    // 1. Decode signature
    var sig_decoded: [char; 64] = uninit;
    var sig_len: int = b64url_decode(sig_str, s_len, &sig_decoded[0] as *char, 64);
    if (sig_len != 32) { return 2; }

    // 2. Verify HMAC-SHA256 signature (key pads precomputed at startup)
    var expected_sig: [char; 64] = uninit;
    var sign_len: i64 = (p2 as i64 - token as i64);
    if (jwt_hmac_sha256(token as *void, sign_len, &expected_sig[0] as *void) != 0) { return 2; }
    if (CRYPTO_memcmp(&sig_decoded[0] as *void, &expected_sig[0] as *void, 32 as i64) != 0) {
        return 2;
    }

    // 3. Decode Header and verify "alg":"HS256"
    var h_decoded: [char; 512] = uninit;
    var h_dec_len: int = b64url_decode(token, h_len, &h_decoded[0] as *char, 512);
    if (h_dec_len <= 0) { return 2; }

    var needle_hs256: string = "\"alg\":\"HS256\"\0";
    if (strstr(&h_decoded[0] as *char, &needle_hs256[0] as *char) == nil) {
        return 2; // Not HS256
    }

    // 4. Decode Payload and verify claims
    var p_decoded: [char; 2048] = uninit;
    var p_dec_len: int = b64url_decode((p1 as i64 + 1 as i64) as *char, p_len, &p_decoded[0] as *char, 2048);
    if (p_dec_len <= 0) { return 2; }

    // Verify "exp"
    var needle_exp: string = "\"exp\":\0";
    var exp_ptr: *char = strstr(&p_decoded[0] as *char, &needle_exp[0] as *char);
    if (exp_ptr == nil) { return 2; }
    exp_ptr = (exp_ptr as i64 + 6 as i64) as *char;
    while (*exp_ptr == 32 as char) { exp_ptr = (exp_ptr as i64 + 1 as i64) as *char; }
    var exp_val: i64 = 0 as i64;
    while (*exp_ptr >= 48 as char && *exp_ptr <= 57 as char) {
        exp_val = exp_val * (10 as i64) + ((*exp_ptr as i64) - (48 as i64));
        exp_ptr = (exp_ptr as i64 + 1 as i64) as *char;
    }
    var now: i64 = time(nil);
    if (exp_val <= now) { return 2; } // Expired

    // Verify "sub":"<user_id>"
    var needle_sub: string = "\"sub\":\0";
    var sub_ptr: *char = strstr(&p_decoded[0] as *char, &needle_sub[0] as *char);
    if (sub_ptr == nil) { return 3; }
    sub_ptr = (sub_ptr as i64 + 6 as i64) as *char;
    while (*sub_ptr == 32 as char) { sub_ptr = (sub_ptr as i64 + 1 as i64) as *char; }
    if (*sub_ptr != 34 as char) { return 3; } // Must be a string
    sub_ptr = (sub_ptr as i64 + 1 as i64) as *char;

    var uid: i64 = 0 as i64;
    var uid_digits: int = 0;
    while (*sub_ptr >= 48 as char && *sub_ptr <= 57 as char) {
        uid = uid * (10 as i64) + ((*sub_ptr as i64) - (48 as i64));
        uid_digits = uid_digits + 1;
        sub_ptr = (sub_ptr as i64 + 1 as i64) as *char;
    }
    if (uid_digits == 0 || *sub_ptr != 34 as char || uid <= 0 as i64) {
        return 3;
    }
    claims->user_id = uid;

    // Verify "username":"<name>"
    var needle_user: string = "\"username\":\0";
    var user_ptr: *char = strstr(&p_decoded[0] as *char, &needle_user[0] as *char);
    if (user_ptr == nil) { return 3; }
    user_ptr = (user_ptr as i64 + 11 as i64) as *char;
    while (*user_ptr == 32 as char) { user_ptr = (user_ptr as i64 + 1 as i64) as *char; }
    if (*user_ptr != 34 as char) { return 3; }
    user_ptr = (user_ptr as i64 + 1 as i64) as *char;

    var u_len: int = 0;
    while (*user_ptr != 0 as char && *user_ptr != 34 as char && u_len < 255) {
        claims->username[u_len] = *user_ptr;
        u_len = u_len + 1;
        user_ptr = (user_ptr as i64 + 1 as i64) as *char;
    }
    if (*user_ptr != 34 as char || u_len == 0) { return 3; }
    claims->username[u_len] = 0 as char;

    return 0; // Success
}

func is_whitespace(c: char) -> int {
    if (c == 32 as char || c == 9 as char || c == 10 as char || c == 13 as char) {
        return 1;
    }
    return 0;
}

func count_utf8(s: *char, len: int) -> int {
    var count: int = 0;
    var i: int = 0;
    while (i < len) {
        var b: int = (s[i] as int) & 255;
        if ((b & 192) != 128) {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}


func set_json_error(out_err: **char, msg: *char) -> int {
    *out_err = msg;
    return 400;
}

func json_hex4(raw: *char, start: int, end: int) -> int {
    if (start + 4 > end) { return -1; }
    var v: int = 0;
    var k: int = 0;
    while (k < 4) {
        var c: char = raw[start + k];
        var d: int = -1;
        if (c >= 48 as char && c <= 57 as char) { d = (c as int) - 48; }
        else if (c >= 65 as char && c <= 70 as char) { d = (c as int) - 55; }
        else if (c >= 97 as char && c <= 102 as char) { d = (c as int) - 87; }
        if (d < 0) { return -1; }
        v = v * 16 + d;
        k = k + 1;
    }
    return v;
}

func parse_post_json_body(raw: *char, rlen: int, out_buf: *char, max_out: int, out_len: *int, out_err: **char) -> int {
    var err_json: string = "malformed JSON body\0";
    var err_long: string = "body must be at most 500 characters\0";
    var i: int = 0;
    while (i < rlen && is_whitespace(raw[i]) == 1) { i = i + 1; }
    if (i >= rlen || raw[i] != 123 as char) { // '{'
        var err_m: string = "malformed JSON body\0";
        *out_err = &err_m[0] as *char;
        return 400;
    }
    i = i + 1;

    var found_body: int = 0;
    var raw_str_start: int = 0;
    var raw_str_len: int = 0;

    while (i < rlen) {
        while (i < rlen && is_whitespace(raw[i]) == 1) { i = i + 1; }
        if (i < rlen && raw[i] == 125 as char) { // '}'
            i = i + 1;
            break;
        }
        if (i >= rlen || raw[i] != 34 as char) { // '"'
            var err_m: string = "malformed JSON body\0";
            *out_err = &err_m[0] as *char;
            return 400;
        }
        i = i + 1;

        var k_start: int = i;
        while (i < rlen && raw[i] != 34 as char) { i = i + 1; }
        if (i >= rlen) {
            var err_m: string = "malformed JSON body\0";
            *out_err = &err_m[0] as *char;
            return 400;
        }
        var k_len: int = i - k_start;
        i = i + 1;

        while (i < rlen && is_whitespace(raw[i]) == 1) { i = i + 1; }
        if (i >= rlen || raw[i] != 58 as char) { // ':'
            var err_m: string = "malformed JSON body\0";
            *out_err = &err_m[0] as *char;
            return 400;
        }
        i = i + 1;

        while (i < rlen && is_whitespace(raw[i]) == 1) { i = i + 1; }
        if (i >= rlen) {
            var err_m: string = "malformed JSON body\0";
            *out_err = &err_m[0] as *char;
            return 400;
        }

        var is_body_key: int = 0;
        if (k_len == 4 && raw[k_start] == 98 as char && raw[k_start + 1] == 111 as char &&
            raw[k_start + 2] == 100 as char && raw[k_start + 3] == 121 as char) {
            is_body_key = 1;
        }

        if (raw[i] == 34 as char) {
            i = i + 1;
            var v_start: int = i;
            var in_esc: int = 0;
            while (i < rlen) {
                if (in_esc == 1) {
                    in_esc = 0;
                } else if (raw[i] == 92 as char) {
                    in_esc = 1;
                } else if (raw[i] == 34 as char) {
                    break;
                }
                i = i + 1;
            }
            if (i >= rlen) {
                var err_m: string = "malformed JSON body\0";
                *out_err = &err_m[0] as *char;
                return 400;
            }
            var v_len: int = i - v_start;
            i = i + 1;

            if (is_body_key == 1) {
                found_body = 1;
                raw_str_start = v_start;
                raw_str_len = v_len;
            }
        } else {
            if (is_body_key == 1) {
                var err_m: string = "body is required\0";
                *out_err = &err_m[0] as *char;
                return 400;
            }
            while (i < rlen && raw[i] != 44 as char && raw[i] != 125 as char) { i = i + 1; }
        }

        while (i < rlen && is_whitespace(raw[i]) == 1) { i = i + 1; }
        if (i < rlen && raw[i] == 44 as char) { i = i + 1; }
    }

    // The top-level object must be closed and followed only by whitespace.
    if (i == 0 || raw[i - 1] != 125 as char) {
        return set_json_error(out_err, &err_json[0] as *char);
    }
    while (i < rlen && is_whitespace(raw[i]) == 1) { i = i + 1; }
    if (i != rlen) {
        return set_json_error(out_err, &err_json[0] as *char);
    }

    if (found_body == 0) {
        var err_m: string = "body is required\0";
        *out_err = &err_m[0] as *char;
        return 400;
    }

    // Unescape JSON string
    var dec_buf: [char; 2048] = uninit;
    var dec_len: int = 0;
    var idx: int = raw_str_start;
    var end_idx: int = raw_str_start + raw_str_len;
    var simple: int = 1;
    var scan: int = raw_str_start;
    while (scan < end_idx) {
        var sc: char = raw[scan];
        var su: int = (sc as int) & 255;
        if (su < 32) {
            return set_json_error(out_err, &err_json[0] as *char);
        }
        if (sc == 92 as char) {
            simple = 0;
            break;
        }
        scan = scan + 1;
    }
    if (simple == 1) {
        var lo_s: int = raw_str_start;
        while (lo_s < end_idx && is_whitespace(raw[lo_s]) == 1) { lo_s = lo_s + 1; }
        var hi_s: int = end_idx;
        while (hi_s > lo_s && is_whitespace(raw[hi_s - 1]) == 1) { hi_s = hi_s - 1; }
        if (lo_s == hi_s) {
            var err_m: string = "body is required\0";
            *out_err = &err_m[0] as *char;
            return 400;
        }
        var tlen_s: int = hi_s - lo_s;
        if (count_utf8((raw as i64 + lo_s as i64) as *char, tlen_s) > 500) {
            var err_m: string = "body must be at most 500 characters\0";
            *out_err = &err_m[0] as *char;
            return 400;
        }
        if (tlen_s >= max_out) {
            return set_json_error(out_err, &err_long[0] as *char);
        }
        memcpy(out_buf as *void, (raw as i64 + lo_s as i64) as *void, tlen_s as i64);
        out_buf[tlen_s] = 0 as char;
        *out_len = tlen_s;
        return 0;
    }
    while (idx < end_idx) {
        var c: char = raw[idx];
        if (c == 92 as char) {
            if (idx + 1 >= end_idx) {
                return set_json_error(out_err, &err_json[0] as *char);
            }
            idx = idx + 1;
            var ec: char = raw[idx];
            if (ec == 117 as char) { // \uXXXX
                if (idx + 4 >= end_idx) {
                    return set_json_error(out_err, &err_json[0] as *char);
                }
                var cp: int = json_hex4(raw, idx + 1, end_idx);
                if (cp < 0) {
                    return set_json_error(out_err, &err_json[0] as *char);
                }
                idx = idx + 4;
                if (cp >= 55296 && cp <= 56319) {
                    if (idx + 6 >= end_idx) {
                        return set_json_error(out_err, &err_json[0] as *char);
                    }
                    if (raw[idx + 1] != 92 as char || raw[idx + 2] != 117 as char) {
                        return set_json_error(out_err, &err_json[0] as *char);
                    }
                    var low: int = json_hex4(raw, idx + 3, end_idx);
                    if (low < 56320 || low > 57343) {
                        return set_json_error(out_err, &err_json[0] as *char);
                    }
                    cp = 65536 + ((cp - 55296) * 1024) + (low - 56320);
                    idx = idx + 6;
                } else if (cp >= 56320 && cp <= 57343) {
                    return set_json_error(out_err, &err_json[0] as *char);
                }
                if (cp == 0) {
                    return set_json_error(out_err, &err_json[0] as *char);
                }
                if (cp < 128) {
                    if (dec_len + 1 > 2047) { return set_json_error(out_err, &err_long[0] as *char); }
                    dec_buf[dec_len] = cp as char;
                    dec_len = dec_len + 1;
                } else if (cp < 2048) {
                    if (dec_len + 2 > 2047) { return set_json_error(out_err, &err_long[0] as *char); }
                    dec_buf[dec_len] = (192 + (cp >> 6)) as char;
                    dec_buf[dec_len + 1] = (128 + (cp & 63)) as char;
                    dec_len = dec_len + 2;
                } else if (cp < 65536) {
                    if (dec_len + 3 > 2047) { return set_json_error(out_err, &err_long[0] as *char); }
                    dec_buf[dec_len] = (224 + (cp >> 12)) as char;
                    dec_buf[dec_len + 1] = (128 + ((cp >> 6) & 63)) as char;
                    dec_buf[dec_len + 2] = (128 + (cp & 63)) as char;
                    dec_len = dec_len + 3;
                } else {
                    if (cp > 1114111) { return set_json_error(out_err, &err_json[0] as *char); }
                    if (dec_len + 4 > 2047) { return set_json_error(out_err, &err_long[0] as *char); }
                    dec_buf[dec_len] = (240 + (cp >> 18)) as char;
                    dec_buf[dec_len + 1] = (128 + ((cp >> 12) & 63)) as char;
                    dec_buf[dec_len + 2] = (128 + ((cp >> 6) & 63)) as char;
                    dec_buf[dec_len + 3] = (128 + (cp & 63)) as char;
                    dec_len = dec_len + 4;
                }
                idx = idx + 1;
                continue;
            }
            if (dec_len >= 2047) { return set_json_error(out_err, &err_long[0] as *char); }
            if (ec == 34 as char) { dec_buf[dec_len] = 34 as char; }
            else if (ec == 92 as char) { dec_buf[dec_len] = 92 as char; }
            else if (ec == 110 as char) { dec_buf[dec_len] = 10 as char; }
            else if (ec == 114 as char) { dec_buf[dec_len] = 13 as char; }
            else if (ec == 116 as char) { dec_buf[dec_len] = 9 as char; }
            else if (ec == 98 as char) { dec_buf[dec_len] = 8 as char; }
            else if (ec == 102 as char) { dec_buf[dec_len] = 12 as char; }
            else { return set_json_error(out_err, &err_json[0] as *char); }
            dec_len = dec_len + 1;
            idx = idx + 1;
        } else {
            if (((c as int) & 255) < 32) { return set_json_error(out_err, &err_json[0] as *char); }
            if (dec_len >= 2047) { return set_json_error(out_err, &err_long[0] as *char); }
            dec_buf[dec_len] = c;
            dec_len = dec_len + 1;
            idx = idx + 1;
        }
    }

    // Trim whitespace
    var lo: int = 0;
    while (lo < dec_len && is_whitespace(dec_buf[lo]) == 1) { lo = lo + 1; }
    var hi: int = dec_len;
    while (hi > lo && is_whitespace(dec_buf[hi - 1]) == 1) { hi = hi - 1; }

    if (lo == hi) {
        var err_m: string = "body is required\0";
        *out_err = &err_m[0] as *char;
        return 400;
    }

    var tlen: int = hi - lo;
    if (count_utf8((&dec_buf[0] as i64 + lo as i64) as *char, tlen) > 500) {
        var err_m: string = "body must be at most 500 characters\0";
        *out_err = &err_m[0] as *char;
        return 400;
    }
    if (tlen >= max_out) {
        return set_json_error(out_err, &err_long[0] as *char);
    }

    memcpy(out_buf as *void, (&dec_buf[0] as i64 + lo as i64) as *void, tlen as i64);
    out_buf[tlen] = 0 as char;
    *out_len = tlen;
    return 0;
}


func run_reference_feed(out_buf: *char, max_out_len: int, out_status: *int) -> int {
    var stmt_f: *void = g_stmt_feed;
    var writer: BufWriter = BufWriter { buf: out_buf, len: 0, cap: max_out_len };
    var pre: string = "{\"posts\":[\0";
    buf_append_str(&writer, &pre[0] as *char);

    var count: int = 0;
    var rc: int = sqlite3_step(stmt_f);
    while (rc == 100) {
        if (count > 0) {
            var comma: string = ",\0";
            buf_append_str(&writer, &comma[0] as *char);
        }
        write_post_json(&writer, stmt_f);
        count = count + 1;
        rc = sqlite3_step(stmt_f);
    }
    sqlite3_reset(stmt_f);

    if (rc != 101) {
        *out_status = 500;
        return write_error(out_buf, max_out_len, "internal server error\0");
    }

    var suf: string = "]}\0";
    buf_append_str(&writer, &suf[0] as *char);
    *out_status = 200;
    return writer.len;
}

func handle_feed(out_buf: *char, max_out_len: int, out_status: *int) -> int {
    // Native B-tree plan: last 20 posts by rowid + one likes index scan.
    // If anything does not match the expected schema/invariant, fall back to
    // the reference SQL below.
    ensure_db_txn();
    var bt_len: int = bt_feed_json(out_buf, max_out_len, out_status);
    if (bt_len >= 0) { return bt_len; }

    var ids: [i64; 20] = [0 as i64, ...];
    var n: int = 0;
    var stmt_fids: *void = g_stmt_feed_ids;
    var rc: int = sqlite3_step(stmt_fids);
    while (rc == 100 && n < 20) {
        ids[n] = sqlite3_column_int64(stmt_fids, 0);
        n = n + 1;
        rc = sqlite3_step(stmt_fids);
    }
    sqlite3_reset(stmt_fids);
    if (n < 20 && rc != 101) {
        *out_status = 500;
        return write_error(out_buf, max_out_len, "internal server error\0");
    }
    if (n == 0) {
        var writer: BufWriter = BufWriter { buf: out_buf, len: 0, cap: max_out_len };
        var empty_feed: string = "{\"posts\":[]}\0";
        buf_append_str(&writer, &empty_feed[0] as *char);
        *out_status = 200;
        return writer.len;
    }

    var mn: i64 = ids[0];
    var mx: i64 = ids[0];
    var k: int = 1;
    while (k < n) {
        if (ids[k] < mn) { mn = ids[k]; }
        if (ids[k] > mx) { mx = ids[k]; }
        k = k + 1;
    }

    var diff: i64 = mx - mn;
    if (diff >= (256 as i64)) {
        return run_reference_feed(out_buf, max_out_len, out_status);
    }

    var slots: [int; 256] = [-1, ...];
    k = 0;
    while (k < n) {
        var offset: int = (ids[k] - mn) as int;
        if (offset >= 0 && offset < 256) {
            slots[offset] = k;
        }
        k = k + 1;
    }

    var likes: [i64; 20] = [0 as i64, ...];
    var stmt_flikes: *void = g_stmt_feed_likes;
    sqlite3_bind_int64(stmt_flikes, 1, mn);
    sqlite3_bind_int64(stmt_flikes, 2, mx);
    rc = sqlite3_step(stmt_flikes);
    while (rc == 100) {
        var p_id: i64 = sqlite3_column_int64(stmt_flikes, 0);
        var off: int = (p_id - mn) as int;
        if (off >= 0 && off < 256) {
            var s_idx: int = slots[off];
            if (s_idx >= 0 && s_idx < 20) {
                likes[s_idx] = likes[s_idx] + (1 as i64);
            }
        }
        rc = sqlite3_step(stmt_flikes);
    }
    sqlite3_reset(stmt_flikes);

    if (rc != 101) {
        *out_status = 500;
        return write_error(out_buf, max_out_len, "internal server error\0");
    }

    var seg_pos: [int; 20] = [0, ...];
    var seg_len: [int; 20] = [0, ...];
    var found: int = 0;

    var scratch_writer: BufWriter = BufWriter { buf: g_feed_scratch, len: 0, cap: 32768 };
    var stmt_frows: *void = g_stmt_feed_rows;
    sqlite3_bind_int64(stmt_frows, 1, mn);
    sqlite3_bind_int64(stmt_frows, 2, mx);
    rc = sqlite3_step(stmt_frows);
    while (rc == 100) {
        var p_id: i64 = sqlite3_column_int64(stmt_frows, 0);
        var off: int = (p_id - mn) as int;
        if (off >= 0 && off < 256) {
            var s_idx: int = slots[off];
            if (s_idx >= 0 && s_idx < 20) {
                seg_pos[s_idx] = scratch_writer.len;
                write_post_json_with_likes(&scratch_writer, stmt_frows, likes[s_idx]);
                seg_len[s_idx] = scratch_writer.len - seg_pos[s_idx];
                found = found + 1;
            }
        }
        rc = sqlite3_step(stmt_frows);
    }
    sqlite3_reset(stmt_frows);

    if (rc != 101) {
        *out_status = 500;
        return write_error(out_buf, max_out_len, "internal server error\0");
    }

    if (found != n) {
        return run_reference_feed(out_buf, max_out_len, out_status);
    }

    var writer: BufWriter = BufWriter { buf: out_buf, len: 0, cap: max_out_len };
    var pre: string = "{\"posts\":[\0";
    buf_append_str(&writer, &pre[0] as *char);

    k = 0;
    while (k < n) {
        if (k > 0) {
            var comma: string = ",\0";
            buf_append_str(&writer, &comma[0] as *char);
        }
        var s_ptr: *char = (g_feed_scratch as i64 + seg_pos[k] as i64) as *char;
        buf_append_fast(&writer, s_ptr, seg_len[k]);
        k = k + 1;
    }

    var suf: string = "]}\0";
    buf_append_str(&writer, &suf[0] as *char);
    if (writer.len >= max_out_len) {
        *out_status = 500;
        return write_error(out_buf, max_out_len, "internal server error\0");
    }
    *out_status = 200;
    return writer.len;
}

func handle_request(method: *char, path: *char, auth: *char, body: *char, body_len: int, out_buf: *char, max_out_len: int, out_status: *int, out_is_write: *int) -> int {
    *out_is_write = 0;

    // 1. GET /health
    if (strcmp(path, "/health\0") == 0) {
        if (strcmp(method, "GET\0") != 0) {
            *out_status = 404;
            return write_error(out_buf, max_out_len, "not found\0");
        }
        var stmt_h: *void = g_stmt_health;
        var rc: int = sqlite3_step(stmt_h);
        sqlite3_reset(stmt_h);
        if (rc != 100 && rc != 101) {
            *out_status = 503;
            var writer: BufWriter = BufWriter { buf: out_buf, len: 0, cap: max_out_len };
            var p0: string = "{\"status\":\"degraded\",\"db\":\"unreachable\",\"error\":\0";
            buf_append_str(&writer, &p0[0] as *char);
            var err: *char = sqlite3_errmsg(g_db);
            buf_append_json_escaped(&writer, err, strlen(err) as int);
            var p1: string = "}\0";
            buf_append_str(&writer, &p1[0] as *char);
            return writer.len;
        }
        var now_s: i64 = time(nil);
        var uptime: i64 = now_s - g_start_time;
        var writer: BufWriter = BufWriter { buf: out_buf, len: 0, cap: max_out_len };
        var p0: string = "{\"status\":\"ok\",\"db\":\"ok\",\"uptime_s\":\0";
        buf_append_str(&writer, &p0[0] as *char);
        buf_append_int(&writer, uptime);
        var p1: string = "}\0";
        buf_append_str(&writer, &p1[0] as *char);
        *out_status = 200;
        return writer.len;
    }

    // 2. GET /feed
    if (strcmp(path, "/feed\0") == 0) {
        if (strcmp(method, "GET\0") != 0) {
            *out_status = 404;
            return write_error(out_buf, max_out_len, "not found\0");
        }
        return handle_feed(out_buf, max_out_len, out_status);
    }

    // 3. POST /posts
    if (strcmp(path, "/posts\0") == 0) {
        if (strcmp(method, "POST\0") != 0) {
            *out_status = 404;
            return write_error(out_buf, max_out_len, "not found\0");
        }

        var claims: AuthClaims = uninit;
        claims.user_id = 0 as i64;
        claims.username[0] = 0 as char;
        var auth_rc: int = verify_jwt(auth, g_secret_ptr, &claims);
        if (auth_rc == 1) {
            *out_status = 401;
            return write_error(out_buf, max_out_len, "missing bearer token\0");
        }
        if (auth_rc == 2) {
            *out_status = 401;
            return write_error(out_buf, max_out_len, "invalid or expired token\0");
        }
        if (auth_rc == 3) {
            *out_status = 401;
            return write_error(out_buf, max_out_len, "invalid token payload\0");
        }

        var trimmed_buf: [char; 2048] = uninit;
        var trimmed_len: int = 0;
        var err_msg_ptr: *char = nil;
        var body_rc: int = parse_post_json_body(body, body_len, &trimmed_buf[0] as *char, 2048, &trimmed_len, &err_msg_ptr);
        if (body_rc != 0) {
            *out_status = body_rc;
            return write_error(out_buf, max_out_len, err_msg_ptr);
        }

        ensure_db_txn();

        var stmt_ip: *void = g_stmt_insert_post;
        sqlite3_bind_int64(stmt_ip, 1, claims.user_id);
        sqlite3_bind_text(stmt_ip, 2, &trimmed_buf[0] as *char, trimmed_len, nil);
        var rc: int = sqlite3_step(stmt_ip);
        if (rc != 100) {
            sqlite3_reset(stmt_ip);
    
            *out_status = 500;
            return write_error(out_buf, max_out_len, "internal server error\0");
        }

        var new_id: i64 = sqlite3_column_int64(stmt_ip, 0);
        var created_ptr: *char = sqlite3_column_text(stmt_ip, 1);
        var created_len: int = sqlite3_column_bytes(stmt_ip, 1);

        var writer: BufWriter = BufWriter { buf: out_buf, len: 0, cap: max_out_len };
        var p0: string = "{\"post\":{\"id\":\0";
        buf_append_str(&writer, &p0[0] as *char);
        buf_append_int(&writer, new_id);

        var p1: string = ",\"body\":\0";
        buf_append_str(&writer, &p1[0] as *char);
        buf_append_json_escaped(&writer, &trimmed_buf[0] as *char, trimmed_len);

        var p2: string = ",\"created_at\":\0";
        buf_append_str(&writer, &p2[0] as *char);
        buf_append_json_escaped(&writer, created_ptr, created_len);

        var p3: string = ",\"author\":\0";
        buf_append_str(&writer, &p3[0] as *char);
        buf_append_json_escaped(&writer, &claims.username[0] as *char, strlen(&claims.username[0] as *char) as int);

        var p4: string = ",\"like_count\":0}}}}\0";
        buf_append_str(&writer, &p4[0] as *char);

        sqlite3_step(stmt_ip);
        sqlite3_reset(stmt_ip);

        *out_status = 201;
        *out_is_write = 1;
        return writer.len;
    }

    // 4. Routes under /posts/
    if (strncmp(path, "/posts/\0", 7 as i64) == 0) {
        var subpath: *char = (path as i64 + 7 as i64) as *char;
        var sublen: int = strlen(subpath) as int;

        if (sublen > 5 && strcmp((subpath as i64 + (sublen - 5) as i64) as *char, "/like\0") == 0) {
            if (strcmp(method, "POST\0") != 0) {
                *out_status = 404;
                return write_error(out_buf, max_out_len, "not found\0");
            }

            // AUTH CHECKED FIRST!
            var claims: AuthClaims = uninit;
            claims.user_id = 0 as i64;
            claims.username[0] = 0 as char;
            var auth_rc: int = verify_jwt(auth, g_secret_ptr, &claims);
            if (auth_rc == 1) {
                *out_status = 401;
                return write_error(out_buf, max_out_len, "missing bearer token\0");
            }
            if (auth_rc == 2) {
                *out_status = 401;
                return write_error(out_buf, max_out_len, "invalid or expired token\0");
            }
            if (auth_rc == 3) {
                *out_status = 401;
                return write_error(out_buf, max_out_len, "invalid token payload\0");
            }

            var id_len: int = sublen - 5;
            var id_str: [char; 64] = uninit;
            if (id_len >= 64) {
                *out_status = 400;
                return write_error(out_buf, max_out_len, "invalid post id\0");
            }
            memcpy(&id_str[0] as *void, subpath as *void, id_len as i64);
            id_str[id_len] = 0 as char;

            var post_id: i64 = 0 as i64;
            if (parse_positive_id(&id_str[0] as *char, &post_id) == 0) {
                *out_status = 400;
                return write_error(out_buf, max_out_len, "invalid post id\0");
            }

            var already_liked: int = 0;
            var stmt_le: *void = g_stmt_like_exists;
            sqlite3_bind_int64(stmt_le, 1, claims.user_id);
            sqlite3_bind_int64(stmt_le, 2, post_id);
            var le_rc: int = sqlite3_step(stmt_le);
            sqlite3_reset(stmt_le);

            if (le_rc == 100) {
                already_liked = 1;
                *out_status = 200;
            } else {
                if (le_rc != 101) {
                    *out_status = 500;
                    return write_error(out_buf, max_out_len, "internal server error\0");
                }

                ensure_db_txn();

                var stmt_l: *void = g_stmt_insert_like;
                sqlite3_bind_int64(stmt_l, 1, claims.user_id);
                sqlite3_bind_int64(stmt_l, 2, post_id);
                var l_rc: int = sqlite3_step(stmt_l);
                sqlite3_reset(stmt_l);

                if (l_rc != 101) {
                    *out_status = 500;
                    return write_error(out_buf, max_out_len, "internal server error\0");
                }

                var changes: int = sqlite3_changes(g_db);
                if (changes > 0) {
                    already_liked = 0;
                    *out_status = 201;
                } else {
                    // Check if post actually exists or was not found
                    var stmt_c: *void = g_stmt_check_post;
                    sqlite3_bind_int64(stmt_c, 1, post_id);
                    var chk_rc: int = sqlite3_step(stmt_c);
                    sqlite3_reset(stmt_c);

                    if (chk_rc != 100) {
                        if (chk_rc == 101) {
                            *out_status = 404;
                            return write_error(out_buf, max_out_len, "post not found\0");
                        }
                        *out_status = 500;
                        return write_error(out_buf, max_out_len, "internal server error\0");
                    }
                    already_liked = 1;
                    *out_status = 200;
                }
            }

            var writer: BufWriter = BufWriter { buf: out_buf, len: 0, cap: max_out_len };
            var p0: string = "{\"liked\":true,\"already_liked\":\0";
            buf_append_str(&writer, &p0[0] as *char);
            if (already_liked == 1) {
                var t: string = "true\0";
                buf_append_str(&writer, &t[0] as *char);
            } else {
                var f: string = "false\0";
                buf_append_str(&writer, &f[0] as *char);
            }
            var p1: string = ",\"post_id\":\0";
            buf_append_str(&writer, &p1[0] as *char);
            buf_append_int(&writer, post_id);
            var p2: string = "}\0";
            buf_append_str(&writer, &p2[0] as *char);
            if (already_liked == 1) {
                *out_is_write = 0;
            } else {
                *out_is_write = 1;
            }
            return writer.len;
        }

        // GET /posts/:id
        if (strcmp(method, "GET\0") != 0) {
            *out_status = 404;
            return write_error(out_buf, max_out_len, "not found\0");
        }

        var post_id: i64 = 0 as i64;
        if (parse_positive_id(subpath, &post_id) == 0) {
            *out_status = 400;
            return write_error(out_buf, max_out_len, "invalid post id\0");
        }

        // Native B-tree plan: rowid seek + one likes index point lookup.
        ensure_db_txn();
        var bt_post_len: int = bt_post_json(post_id, out_buf, max_out_len, out_status);
        if (bt_post_len >= 0) { return bt_post_len; }

        var stmt_p: *void = g_stmt_post;
        sqlite3_bind_int64(stmt_p, 1, post_id);
        var rc: int = sqlite3_step(stmt_p);
        if (rc == 100) {
            var writer: BufWriter = BufWriter { buf: out_buf, len: 0, cap: max_out_len };
            var pre: string = "{\"post\":\0";
            buf_append_str(&writer, &pre[0] as *char);
            write_post_json(&writer, stmt_p);
            var suf: string = "}\0";
            buf_append_str(&writer, &suf[0] as *char);

            sqlite3_reset(stmt_p);
            *out_status = 200;
            return writer.len;
        }
        sqlite3_reset(stmt_p);

        if (rc == 101) {
            *out_status = 404;
            return write_error(out_buf, max_out_len, "post not found\0");
        }

        *out_status = 500;
        return write_error(out_buf, max_out_len, "internal server error\0");
    }

    *out_status = 404;
    return write_error(out_buf, max_out_len, "not found\0");
}

func status_reason(code: int) -> *char {
    if (code == 200) { var s: string = "OK\0"; return &s[0] as *char; }
    if (code == 201) { var s: string = "Created\0"; return &s[0] as *char; }
    if (code == 400) { var s: string = "Bad Request\0"; return &s[0] as *char; }
    if (code == 401) { var s: string = "Unauthorized\0"; return &s[0] as *char; }
    if (code == 404) { var s: string = "Not Found\0"; return &s[0] as *char; }
    if (code == 503) { var s: string = "Service Unavailable\0"; return &s[0] as *char; }
    var s: string = "Internal Server Error\0";
    return &s[0] as *char;
}


func arena_data(a: *Arena) -> *char {
    return (a as i64 + ARENA_HDR) as *char;
}

func arena_get() -> *Arena {
    var a: *Arena = g_arena_pool;
    if (a != nil) {
        g_arena_pool = (*a).next;
        g_arena_pool_n = g_arena_pool_n - 1;
    } else {
        a = malloc(ARENA_HDR + ARENA_CAP) as *Arena;
        if (a == nil) {
            var err_a: string = "Failed to allocate response arena\0";
            puts(&err_a[0] as *char);
            exit(1);
        }
        (*a).cap = ARENA_CAP as u32;
    }
    (*a).next = nil;
    (*a).refs = 0;
    (*a).used = 0;
    return a;
}

func arena_unref(a: *Arena) -> void {
    if (a == nil) { return; }
    (*a).refs = (*a).refs - 1;
    if ((*a).refs > (0 as u32)) { return; }
    if (g_arena_pool_n < ARENA_POOL) {
        (*a).next = g_arena_pool;
        g_arena_pool = a;
        g_arena_pool_n = g_arena_pool_n + 1;
    } else {
        free(a as *void);
    }
}

// Reserve room in the current batch arena; the caller advances `used` by the
// bytes it actually writes. A new arena takes the batch's own reference.
func arena_reserve(n: u32) -> *char {
    if (g_cur_arena == nil || (*g_cur_arena).used + n > (*g_cur_arena).cap) {
        var a: *Arena = arena_get();
        (*a).refs = 1;
        if (g_n_batch_arenas >= ARENA_MAX_BATCH) {
            var err_b: string = "Too many response arenas in one batch\0";
            puts(&err_b[0] as *char);
            exit(1);
        }
        (*a).next = g_batch_head;
        g_batch_head = a;
        g_n_batch_arenas = g_n_batch_arenas + 1;
        g_cur_arena = a;
    }
    return arena_data(g_cur_arena) + ((*g_cur_arena).used as i64);
}

func arena_advance(n: u32) -> void {
    (*g_cur_arena).used = (*g_cur_arena).used + n;
}

// The batch's references go away only after flush_replies has taken a
// reference for every send. An arena with sends still in flight stays out of
// the pool until the last send completes.
func arena_batch_release() -> void {
    var a: *Arena = g_batch_head;
    while (a != nil) {
        var next: *Arena = (*a).next;
        arena_unref(a);
        a = next;
    }
    g_batch_head = nil;
    g_n_batch_arenas = 0;
    g_cur_arena = nil;
}

func arenas_prewarm() -> void {
    var i: int = 0;
    while (i < ARENA_PREWARM) {
        var a: *Arena = malloc(ARENA_HDR + ARENA_CAP) as *Arena;
        if (a == nil) {
            var err_a: string = "Failed to prewarm response arenas\0";
            puts(&err_a[0] as *char);
            exit(1);
        }
        memset(a as *void, 0, ARENA_HDR + ARENA_CAP);
        (*a).cap = ARENA_CAP as u32;
        (*a).next = g_arena_pool;
        g_arena_pool = a;
        g_arena_pool_n = g_arena_pool_n + 1;
        i = i + 1;
    }
}


func buffer_reserve(b: *Buffer, needed: u32) -> void {
    if (needed <= (*b).cap) { return; }
    var new_cap: u32 = 512 as u32;
    while (new_cap < needed) {
        new_cap = new_cap * (2 as u32);
    }
    if ((*b).cap == (0 as u32)) {
        (*b).ptr = malloc(new_cap as i64) as *u8;
    } else {
        (*b).ptr = realloc((*b).ptr as *void, new_cap as i64) as *u8;
    }
    (*b).cap = new_cap;
}

func buffer_extend(b: *Buffer, src: *u8, len: u32) -> void {
    if (len == (0 as u32)) { return; }
    buffer_reserve(b, (*b).len + len);
    memcpy(((*b).ptr + ((*b).len as i64)) as *void, src as *void, len as i64);
    (*b).len = (*b).len + len;
}

func buffer_consume(b: *Buffer, n: u32) -> void {
    if (n >= (*b).len) {
        (*b).len = 0 as u32;
        return;
    }
    var left: u32 = (*b).len - n;
    memmove((*b).ptr as *void, ((*b).ptr + (n as i64)) as *void, left as i64);
    (*b).len = left;
}

func retire_buffer(w: *WorkerState, b: *Buffer) -> void {
    if ((*b).cap > (0 as u32)) {
        free((*b).ptr as *void);
        (*b).ptr = nil;
        (*b).len = 0 as u32;
        (*b).cap = 0 as u32;
    }
}

// Frames one complete response (headers + body) into `out_p`; `cap` bounds
// only the header writer. Returns the total bytes written.
func build_response(out_p: *char, cap: int, status: int, keep_alive: int, body_ptr: *char, body_len: int) -> int {
    var writer: BufWriter = BufWriter { buf: out_p, len: 0, cap: cap };

    if (status == 200 && keep_alive == 1) {
        var h: string = "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: \0";
        buf_append_str(&writer, &h[0] as *char);
        buf_append_int(&writer, body_len as i64);
        var k_str: string = "\r\nConnection: keep-alive\r\n\r\n\0";
        buf_append_str(&writer, &k_str[0] as *char);
    } else if (status == 201 && keep_alive == 1) {
        var h: string = "HTTP/1.1 201 Created\r\nContent-Type: application/json\r\nContent-Length: \0";
        buf_append_str(&writer, &h[0] as *char);
        buf_append_int(&writer, body_len as i64);
        var k_str: string = "\r\nConnection: keep-alive\r\n\r\n\0";
        buf_append_str(&writer, &k_str[0] as *char);
    } else {
        var p0: string = "HTTP/1.1 \0";
        buf_append_str(&writer, &p0[0] as *char);
        buf_append_int(&writer, status as i64);
        var sp: string = " \0";
        buf_append_str(&writer, &sp[0] as *char);
        buf_append_str(&writer, status_reason(status));
        var p1: string = "\r\nContent-Type: application/json\r\nContent-Length: \0";
        buf_append_str(&writer, &p1[0] as *char);
        buf_append_int(&writer, body_len as i64);
        if (keep_alive == 0) {
            var p2: string = "\r\nConnection: close\r\n\r\n\0";
            buf_append_str(&writer, &p2[0] as *char);
        } else {
            var p3: string = "\r\nConnection: keep-alive\r\n\r\n\0";
            buf_append_str(&writer, &p3[0] as *char);
        }
    }

    var hdr_len: int = writer.len;
    if (body_len > 0) {
        memcpy((out_p as i64 + hdr_len as i64) as *void, body_ptr as *void, body_len as i64);
    }
    return hdr_len + body_len;
}

// Build one response into the current batch arena and put it on the reply
// list. The connection owns no response buffer.
func append_response(w: *WorkerState, direct_fd: int, status: int, keep_alive: int, body_ptr: *char, body_len: int) -> void {
    var c: *Conn = (*w).conns + (direct_fd as i64);
    var need: u32 = (256 as u32) + (body_len as u32);
    var p: *char = arena_reserve(need);
    var a: *Arena = g_cur_arena;
    var total: int = build_response(p, 256, status, keep_alive, body_ptr, body_len);
    arena_advance(total as u32);

    if (g_nreplies >= MAX_REPLIES) {
        var err_r: string = "Too many replies in one batch\0";
        puts(&err_r[0] as *char);
        exit(1);
    }
    var rp: *Reply = g_replies + (g_nreplies as i64);
    g_nreplies = g_nreplies + 1;
    (*rp).arena = a;
    (*rp).off = (p as i64 - arena_data(a) as i64) as u32;
    (*rp).len = total as u32;
    (*rp).fd = direct_fd;
    (*rp).ring = (*w).id;
    (*rp).gen = (*c).gen;
}

func mark_conn_dirty(w: *WorkerState, direct_fd: int) -> void {
    var c: *Conn = (*w).conns + (direct_fd as i64);
    if (((*c).state & CONN_DIRTY) == (0 as u32)) {
        (*c).state = (*c).state | CONN_DIRTY;
        if ((*w).dirty_count < 4096) {
            (*w).dirty_fds[(*w).dirty_count] = direct_fd;
            (*w).dirty_count = (*w).dirty_count + 1;
        }
    }
}

func hold_conn(w: *WorkerState, direct_fd: int) -> void {
    var c: *Conn = (*w).conns + (direct_fd as i64);
    if (((*c).state & CONN_HOLD) == (0 as u32)) {
        (*c).state = (*c).state | CONN_HOLD;
        if ((*w).held_count < 4096) {
            (*w).held_fds[(*w).held_count] = direct_fd;
            (*w).held_count = (*w).held_count + 1;
        }
    }
}

func arena_reset() -> void {
    g_job_arena_used = 0 as u32;
    g_njobs = 0;
}

func arena_alloc(n: u32) -> *char {
    var at: u32 = ((g_job_arena_used + (7 as u32)) / (8 as u32)) * (8 as u32);
    if (at + n > (JOB_ARENA_SZ as u32)) { return nil; }
    var p: *char = (g_job_arena as i64 + at as i64) as *char;
    g_job_arena_used = at + n;
    return p;
}

// Copy the parts of one parsed request that must outlive the provided buffer.
// Returns 0 on success, -1 if this connection should retry after the batch.
func enqueue_job(w: *WorkerState, direct_fd: int, method: *char, path: *char,
                 auth: *char, body: *char, body_len: int, close_after: int) -> int {
    if (g_njobs >= MAX_JOBS || g_answers_left <= 0) { return -1; }
    var mlen: u32 = (strlen(method) as u32) + (1 as u32);
    var plen: u32 = (strlen(path) as u32) + (1 as u32);
    var alen: u32 = 0 as u32;
    if (auth != nil) { alen = (strlen(auth) as u32) + (1 as u32); }
    var blen: u32 = (body_len as u32) + (1 as u32);
    var aligned_m: u32 = ((mlen + (7 as u32)) / (8 as u32)) * (8 as u32);
    var aligned_p: u32 = ((plen + (7 as u32)) / (8 as u32)) * (8 as u32);
    var aligned_a: u32 = ((alen + (7 as u32)) / (8 as u32)) * (8 as u32);
    var aligned_b: u32 = ((blen + (7 as u32)) / (8 as u32)) * (8 as u32);
    var need: u32 = aligned_m + aligned_p + aligned_a + aligned_b;
    if ((g_job_arena_used + need) > (JOB_ARENA_SZ as u32)) { return -1; }

    var m: *char = arena_alloc(mlen);
    var p: *char = arena_alloc(plen);
    var a: *char = nil;
    if (auth != nil) { a = arena_alloc(alen); }
    var b: *char = arena_alloc(blen);
    if (m == nil || p == nil || b == nil || (auth != nil && a == nil)) { return -1; }
    memcpy(m as *void, method as *void, mlen as i64);
    memcpy(p as *void, path as *void, plen as i64);
    if (auth != nil) { memcpy(a as *void, auth as *void, alen as i64); }
    if (body_len > 0) { memcpy(b as *void, body as *void, body_len as i64); }
    b[body_len] = 0 as char;

    var c: *Conn = (*w).conns + (direct_fd as i64);
    var j: *Job = g_jobs + (g_njobs as i64);
    g_njobs = g_njobs + 1;
    j->ring = (*w).id;
    j->fd = direct_fd;
    j->gen = (*c).gen;
    j->is_write = 0 as u8;
    if (strcmp(method, "POST\0") == 0) { j->is_write = 1 as u8; }
    j->close_after = close_after as u8;
    j->preset = 0 as u8;
    j->status = 0;
    j->method = m;
    j->path = p;
    j->auth = a;
    j->body = b;
    j->body_len = body_len;
    (*c).state = (*c).state | CONN_REPLIED;
    g_answers_left = g_answers_left - 1;
    return 0;
}

func enqueue_bad_request(w: *WorkerState, direct_fd: int) -> int {
    if (g_njobs >= MAX_JOBS || g_answers_left <= 0) { return -1; }
    var msg: string = "{\"error\":\"malformed request\"}\0";
    var blen: int = strlen(&msg[0] as *char) as int;
    var b: *char = arena_alloc((blen as u32) + (1 as u32));
    if (b == nil) { return -1; }
    memcpy(b as *void, &msg[0] as *void, (blen as i64) + (1 as i64));
    var c: *Conn = (*w).conns + (direct_fd as i64);
    var j: *Job = g_jobs + (g_njobs as i64);
    g_njobs = g_njobs + 1;
    j->ring = (*w).id;
    j->fd = direct_fd;
    j->gen = (*c).gen;
    j->is_write = 0 as u8;
    j->close_after = 1 as u8;
    j->preset = 1 as u8;
    j->status = 400;
    j->method = nil;
    j->path = nil;
    j->auth = nil;
    j->body = b;
    j->body_len = blen;
    (*c).state = (*c).state | CONN_REPLIED;
    g_answers_left = g_answers_left - 1;
    return 0;
}

func queue_accept_sqe(w: *WorkerState, listener: int) -> void {
    var tail: u32 = *((*w).sq_tail);
    var idx: u32 = tail & (*((*w).sq_mask));
    var s: *IoUringSqe = (*w).sqes + (idx as i64);
    var s_bytes: *u8 = s as *u8;
    var i: int = 0;
    while (i < 64) { *(s_bytes + i) = 0 as u8; i = i + 1; }
    (*s).opcode = IORING_OP_ACCEPT;
    (*s).fd = g_listen_fds[listener];
    (*s).ioprio = IORING_ACCEPT_MULTISHOT;
    (*s).file_index = IORING_FILE_INDEX_ALLOC;
    (*s).user_data = (1 as u64) | ((listener as u64) << 8) | (((*w).id as u64) << 16);
    *((*w).sq_array + (idx as i64)) = idx;
    *((*w).sq_tail) = tail + 1;
}

// One-shot receive. The idle connection is watched by a multishot poll, so a
// receive is only armed after readability, not for every idle connection.
func queue_recv_sqe(w: *WorkerState, direct_fd: int) -> void {
    var c: *Conn = (*w).conns + (direct_fd as i64);
    var tail: u32 = *((*w).sq_tail);
    var idx: u32 = tail & (*((*w).sq_mask));
    var s: *IoUringSqe = (*w).sqes + (idx as i64);
    var s_bytes: *u8 = s as *u8;
    var i: int = 0;
    while (i < 64) { *(s_bytes + i) = 0 as u8; i = i + 1; }
    (*s).opcode = IORING_OP_RECV;
    (*s).fd = direct_fd;
    (*s).len = BUF_SZ as u32;
    (*s).ioprio = 0 as u16;
    (*s).flags = (IOSQE_FIXED_FILE | IOSQE_BUFFER_SELECT);
    (*s).buf_index = 0 as u16;
    (*s).user_data = (2 as u64) | ((direct_fd as u64) << 8) | (((*c).gen as u64) << 32);
    *((*w).sq_array + (idx as i64)) = idx;
    *((*w).sq_tail) = tail + 1;
    (*c).state = (*c).state | CONN_RECEIVING;
}

// Multishot poll is the idle wait. It costs no provided buffer and, unlike a
// multishot receive, cannot accumulate a pending receive (and its kernel skb)
// for every connection during an accept burst.
func queue_poll_sqe(w: *WorkerState, direct_fd: int) -> void {
    var c: *Conn = (*w).conns + (direct_fd as i64);
    var tail: u32 = *((*w).sq_tail);
    var idx: u32 = tail & (*((*w).sq_mask));
    var s: *IoUringSqe = (*w).sqes + (idx as i64);
    var s_bytes: *u8 = s as *u8;
    var i: int = 0;
    while (i < 64) { *(s_bytes + i) = 0 as u8; i = i + 1; }
    (*s).opcode = IORING_OP_POLL_ADD;
    (*s).fd = direct_fd;
    (*s).flags = IOSQE_FIXED_FILE;
    (*s).len = IORING_POLL_ADD_MULTI;
    (*s).rw_flags = (POLLIN | POLLRDHUP);
    (*s).user_data = (4 as u64) | ((direct_fd as u64) << 8) | (((*c).gen as u64) << 32);
    *((*w).sq_array + (idx as i64)) = idx;
    *((*w).sq_tail) = tail + 1;
}

// Cancel a request by its user_data (an accept, or a receive when closing).
func queue_cancel_sqe(w: *WorkerState, target: u64) -> void {
    var tail: u32 = *((*w).sq_tail);
    var idx: u32 = tail & (*((*w).sq_mask));
    var s: *IoUringSqe = (*w).sqes + (idx as i64);
    var s_bytes: *u8 = s as *u8;
    var i: int = 0;
    while (i < 64) { *(s_bytes + i) = 0 as u8; i = i + 1; }
    (*s).opcode = IORING_OP_ASYNC_CANCEL;
    (*s).fd = -1;
    (*s).addr = target;
    (*s).flags = IOSQE_CQE_SKIP_SUCCESS;
    (*s).user_data = 6 as u64;
    *((*w).sq_array + (idx as i64)) = idx;
    *((*w).sq_tail) = tail + 1;
}

func ready_push(fd: i32, ring: int, gen: u32) -> void {
    if (g_ready_tail >= g_ready_cap) {
        if (g_ready_head > 0) {
            var left: int = g_ready_tail - g_ready_head;
            memmove(g_ready as *void, (g_ready + (g_ready_head as i64)) as *void, (left as i64) * 12);
            g_ready_tail = left;
            g_ready_head = 0;
        }
        if (g_ready_tail >= g_ready_cap) { return; }
    }
    var e: *ConnRef = g_ready + (g_ready_tail as i64);
    (*e).fd = fd;
    (*e).ring = ring;
    (*e).gen = gen;
    g_ready_tail = g_ready_tail + 1;
}

func queue_ready(w: *WorkerState, direct_fd: int) -> void {
    var c: *Conn = (*w).conns + (direct_fd as i64);
    if (((*c).state & CONN_READY) != (0 as u32)) { return; }
    (*c).state = (*c).state | CONN_READY;
    ready_push(direct_fd, (*w).id, (*c).gen);
}

func rearm_push(w: *WorkerState, fd: i32) -> void {
    var next_tail: int = (*w).rearm_tail + 1;
    if (next_tail >= (*w).rearm_cap) { next_tail = 0; }
    if (next_tail != (*w).rearm_head) {
        *((*w).rearm_fds + ((*w).rearm_tail as i64)) = fd;
        (*w).rearm_tail = next_tail;
    }
}

func rearm_pop(w: *WorkerState) -> i32 {
    if ((*w).rearm_head == (*w).rearm_tail) { return -1; }
    var fd: i32 = *((*w).rearm_fds + ((*w).rearm_head as i64));
    var next_head: int = (*w).rearm_head + 1;
    if (next_head >= (*w).rearm_cap) { next_head = 0; }
    (*w).rearm_head = next_head;
    return fd;
}

func queue_send_sqe(w: *WorkerState, direct_fd: int) -> void {
    var c: *Conn = (*w).conns + (direct_fd as i64);
    var remaining: u32 = (*c).send_len - (*c).sent;
    var send_ptr: i64 = (arena_data((*c).send_arena) as i64) + ((*c).send_off as i64) + ((*c).sent as i64);

    var tail: u32 = *((*w).sq_tail);
    var idx: u32 = tail & (*((*w).sq_mask));
    var s: *IoUringSqe = (*w).sqes + (idx as i64);
    var s_bytes: *u8 = s as *u8;
    var i: int = 0;
    while (i < 64) { *(s_bytes + i) = 0 as u8; i = i + 1; }

    (*s).opcode = IORING_OP_SEND;
    (*s).fd = direct_fd;
    (*s).flags = IOSQE_FIXED_FILE;
    (*s).addr = send_ptr as u64;
    (*s).len = remaining;
    (*s).rw_flags = 0x4000 as u32; // MSG_NOSIGNAL
    (*s).user_data = (3 as u64) | ((direct_fd as u64) << 8) | (((*c).gen as u64) << 32);

    *((*w).sq_array + (idx as i64)) = idx;
    *((*w).sq_tail) = tail + 1;
    (*c).state = (*c).state | CONN_SENDING;
}

func queue_close_sqe(w: *WorkerState, direct_fd: int) -> void {
    var c: *Conn = (*w).conns + (direct_fd as i64);
    // Cancel the armed multishot receive by user_data before closing the
    // direct descriptor, so the socket is released even if it never sees EOF.
    var recv_ud: u64 = (2 as u64) | ((direct_fd as u64) << 8) | (((*c).gen as u64) << 32);
    queue_cancel_sqe(w, recv_ud);
    var poll_ud: u64 = (4 as u64) | ((direct_fd as u64) << 8) | (((*c).gen as u64) << 32);
    queue_cancel_sqe(w, poll_ud);
    if ((*c).send_arena != nil) { // only a failed send reaches this
        arena_unref((*c).send_arena);
        (*c).send_arena = nil;
    }
    (*c).state = 0 as u32;
    (*c).gen = (*c).gen + (1 as u32);
    (*w).open_conns = (*w).open_conns - 1;
    retire_buffer(w, &(*c).input);

    var tail: u32 = *((*w).sq_tail);
    var idx: u32 = tail & (*((*w).sq_mask));
    var s: *IoUringSqe = (*w).sqes + (idx as i64);
    var s_bytes: *u8 = s as *u8;
    var i: int = 0;
    while (i < 64) { *(s_bytes + i) = 0 as u8; i = i + 1; }

    (*s).opcode = IORING_OP_CLOSE;
    (*s).fd = 0;
    (*s).file_index = (direct_fd + 1) as u32;
    (*s).flags = IOSQE_CQE_SKIP_SUCCESS;
    (*s).user_data = 0 as u64;

    *((*w).sq_array + (idx as i64)) = idx;
    *((*w).sq_tail) = tail + 1;
}

// Responses are already on their way from the batch arena. This only closes
// connections whose reply is fully sent (or that have no reply) and schedules
// buffered pipelined bytes for the next parse.
func flush_pending(w: *WorkerState) -> void {
    var k: int = 0;
    while (k < (*w).dirty_count) {
        var fd: i32 = (*w).dirty_fds[k];
        var c: *Conn = (*w).conns + (fd as i64);
        (*c).state = (*c).state & (~CONN_DIRTY);
        if (((*c).state & CONN_LIVE) != (0 as u32) && ((*c).state & CONN_SENDING) == (0 as u32)) {
            if (((*c).state & CONN_CLOSING) != (0 as u32)) {
                queue_close_sqe(w, fd);
            } else if ((*c).input.len > (0 as u32) &&
                       ((*c).state & (CONN_HOLD | CONN_READY | CONN_REPLIED)) == (0 as u32)) {
                queue_ready(w, fd);
            }
        }
        k = k + 1;
    }
    (*w).dirty_count = 0;
}

func process_one_request(w: *WorkerState, direct_fd: int, buf: *char, avail_len: int,
                         out_consumed: *int, out_keep_alive: *int) -> int {
    var needle: string = "\r\n\r\n\0";
    var hdr_end: *char = memmem(buf as *void, avail_len as i64, &needle[0] as *void, 4 as i64) as *char;
    if (hdr_end == nil) {
        return 0; // Incomplete header
    }

    var hdr_len: int = (hdr_end as i64 - buf as i64) as int + 4;

    var space1: *char = memchr(buf as *void, 32, hdr_len as i64) as *char;
    if (space1 == nil) { return -1; }
    var m_len: int = (space1 as i64 - buf as i64) as int;
    var method: [char; 16] = uninit;
    if (m_len >= 16) { return -1; }
    memcpy(&method[0] as *void, buf as *void, m_len as i64);
    method[m_len] = 0 as char;

    var path_start: *char = (space1 as i64 + 1 as i64) as *char;
    var space2: *char = memchr(path_start as *void, 32, (hdr_len - m_len - 1) as i64) as *char;
    if (space2 == nil) { return -1; }
    var p_len: int = (space2 as i64 - path_start as i64) as int;
    var path: [char; 256] = uninit;
    if (p_len >= 256) { return -1; }
    memcpy(&path[0] as *void, path_start as *void, p_len as i64);
    path[p_len] = 0 as char;

    var auth_hdr: [char; 2048] = uninit;
    var auth_found: int = 0;
    var content_length: int = 0;
    var keep_alive: int = 1;

    var cur: *char = memchr(space2 as *void, 10, (hdr_len - (space2 as i64 - buf as i64)) as i64) as *char;
    if (cur != nil) { cur = (cur as i64 + 1 as i64) as *char; }

    while (cur != nil && cur < hdr_end) {
        var next_nl: *char = memchr(cur as *void, 10, (hdr_end as i64 - cur as i64)) as *char;
        var line_len: int = 0;
        if (next_nl != nil) {
            line_len = (next_nl as i64 - cur as i64) as int;
        } else {
            line_len = (hdr_end as i64 - cur as i64) as int;
        }

        var c0: char = *cur;
        if (c0 == 65 as char || c0 == 97 as char) {
            if (strncasecmp(cur, "Authorization:\0", 14 as i64) == 0) {
                var val: *char = (cur as i64 + 14 as i64) as *char;
                while (*val == 32 as char || *val == 9 as char) { val = (val as i64 + 1 as i64) as *char; }
                var vlen: int = line_len - 14 - ((val as i64 - (cur as i64 + 14 as i64)) as int);
                while (vlen > 0 && (val[vlen - 1] == 13 as char || val[vlen - 1] == 32 as char)) { vlen = vlen - 1; }
                if (vlen > 0 && vlen < 2047) {
                    memcpy(&auth_hdr[0] as *void, val as *void, vlen as i64);
                    auth_hdr[vlen] = 0 as char;
                    auth_found = 1;
                }
            }
        } else if (c0 == 67 as char || c0 == 99 as char) {
            if (strncasecmp(cur, "Content-Length:\0", 15 as i64) == 0) {
                var val: *char = (cur as i64 + 15 as i64) as *char;
                while (*val == 32 as char || *val == 9 as char) { val = (val as i64 + 1 as i64) as *char; }
                var cl: i64 = 0 as i64;
                var digits: int = 0;
                while (*val >= 48 as char && *val <= 57 as char) {
                    cl = cl * 10 as i64 + ((*val as i64) - 48 as i64);
                    if (cl > 16384 as i64) { return -1; }
                    digits = digits + 1;
                    val = (val as i64 + 1 as i64) as *char;
                }
                if (digits == 0) { return -1; }
                content_length = cl as int;
            } else if (strncasecmp(cur, "Connection:\0", 11 as i64) == 0) {
                var val: *char = (cur as i64 + 11 as i64) as *char;
                while (*val == 32 as char || *val == 9 as char) { val = (val as i64 + 1 as i64) as *char; }
                if (strncasecmp(val, "close\0", 5 as i64) == 0) {
                    keep_alive = 0;
                }
            }
        }

        if (next_nl != nil) {
            cur = (next_nl as i64 + 1 as i64) as *char;
        } else {
            cur = nil;
        }
    }

    var req_total_i: i64 = hdr_len as i64 + content_length as i64;
    if (req_total_i > 65536 as i64) { return -1; }
    if (avail_len as i64 < req_total_i) {
        return 0; // Incomplete body
    }
    var req_total: int = req_total_i as int;

    var body: *char = (buf as i64 + hdr_len as i64) as *char;
    var auth_ptr: *char = nil;
    if (auth_found == 1) { auth_ptr = &auth_hdr[0] as *char; }

    var close_after: int = 0;
    if (keep_alive == 0) { close_after = 1; }
    if (enqueue_job(w, direct_fd, &method[0] as *char, &path[0] as *char,
                    auth_ptr, body, content_length, close_after) != 0) {
        return -2;
    }

    *out_consumed = req_total;
    *out_keep_alive = keep_alive;
    if (keep_alive == 0 || strcmp(&method[0] as *char, "POST\0") == 0) { return 2; }
    return 1;
}

func defer_close(w: *WorkerState, direct_fd: int) -> void {
    var c: *Conn = (*w).conns + (direct_fd as i64);
    (*c).state = (*c).state | CONN_CLOSING;
    mark_conn_dirty(w, direct_fd);
}

func process_incoming_data(w: *WorkerState, direct_fd: int, pkt_data: *char, pkt_len: int) -> void {
    var c: *Conn = (*w).conns + (direct_fd as i64);
    var input_bytes: *char = pkt_data;
    var total_len: int = pkt_len;

    if (((*c).state & CONN_CLOSING) != (0 as u32)) { return; }

    // #1 handles at most one request per connection per batch. While this
    // connection's reply or send is outstanding, further bytes are kept for
    // the next turn.
    if (((*c).state & (CONN_REPLIED | CONN_SENDING)) != (0 as u32)) {
        if (pkt_len > 0) {
            if (((*c).input.len as i64) + (pkt_len as i64) > (65536 as i64)) {
                defer_close(w, direct_fd);
                return;
            }
            buffer_extend(&(*c).input, pkt_data as *u8, pkt_len as u32);
        }
        return;
    }

    if (((*c).state & CONN_HOLD) != (0 as u32)) {
        if (((*c).input.len as i64) + (pkt_len as i64) > (65536 as i64)) {
            defer_close(w, direct_fd);
            return;
        }
        buffer_extend(&(*c).input, pkt_data as *u8, pkt_len as u32);
        return;
    }

    if (((*c).input.len as i64) + (pkt_len as i64) > (65536 as i64)) {
        defer_close(w, direct_fd);
        return;
    }
    if ((*c).input.len > (0 as u32)) {
        buffer_extend(&(*c).input, pkt_data as *u8, pkt_len as u32);
        input_bytes = (*c).input.ptr as *char;
        total_len = (*c).input.len as int;
    }

    var offset: int = 0;
    while (offset < total_len) {
        if (((*c).state & (CONN_REPLIED | CONN_SENDING | CONN_CLOSING)) != (0 as u32)) { break; }
        var consumed: int = 0;
        var keep_alive: int = 1;
        var cur_buf: *char = (input_bytes as i64 + offset as i64) as *char;
        var cur_len: int = total_len - offset;
        var res: int = process_one_request(w, direct_fd, cur_buf, cur_len, &consumed, &keep_alive);
        if (res == 0) {
            break;
        }
        if (res == -2) {
            hold_conn(w, direct_fd);
            break;
        }
        if (res < 0) {
            if (enqueue_bad_request(w, direct_fd) != 0) {
                hold_conn(w, direct_fd);
                break;
            }
            offset = total_len;
            break;
        }
        offset = offset + consumed;
    }

    if (((*c).state & CONN_CLOSING) == (0 as u32) && offset < total_len) {
        var remaining: int = total_len - offset;
        if ((*c).input.len == (0 as u32)) {
            buffer_extend(&(*c).input, (input_bytes as i64 + offset as i64) as *u8, remaining as u32);
        } else {
            buffer_consume(&(*c).input, offset as u32);
        }
    } else {
        if ((*c).input.cap > (0 as u32)) {
            retire_buffer(w, &(*c).input);
        }
    }
}

func init_ring(w: *WorkerState) -> int {
    var params: IoUringParams = uninit;
    var i: i64 = 0;

    // #1's CQ sizing: 65,536 entries, more than a ring's connection table, so
    // a burst of completions never spills into the kernel's overflow list
    // (which allocates per completion just when memory is shortest). Newer
    // kernels charge ring memory to RLIMIT_MEMLOCK; on ENOMEM the ring is
    // retried with half the entries, down to 8192.
    var cq: u32 = 65536 as u32;
    var ring_fd: i64 = -1;
    while (cq >= (8192 as u32)) {
        var p_ptr: *u8 = &params as *u8;
        i = 0;
        while (i < 120) { *(p_ptr + i) = 0 as u8; i = i + 1; }
        // CQSIZE | COOP_TASKRUN | SINGLE_ISSUER | DEFER_TASKRUN | TASKRUN_FLAG
        params.flags = (8 | 256 | 4096 | 8192 | 512) as u32;
        params.cq_entries = cq;
        ring_fd = syscall(SYS_IO_URING_SETUP, 8192, &params as i64, 0, 0, 0, 0);
        if (ring_fd >= 0) { break; }
        cq = cq / (2 as u32);
    }
    if (ring_fd < 0) {
        var err_m: string = "Failed io_uring_setup in worker\0";
        puts(&err_m[0] as *char);
        return -1;
    }
    (*w).ring_fd = ring_fd as int;

    var efd: int = eventfd(0 as u32, EFD_NONBLOCK | EFD_CLOEXEC);
    if (efd < 0) {
        var err_e: string = "Failed eventfd for io_uring worker\0";
        puts(&err_e[0] as *char);
        close(ring_fd as int);
        return -1;
    }
    (*w).efd = efd;
    if (syscall(SYS_IO_URING_REGISTER, ring_fd, IORING_REGISTER_EVENTFD, &efd as i64, 1, 0, 0) < 0) {
        var err_r: string = "Failed to register io_uring eventfd\0";
        puts(&err_r[0] as *char);
        close(efd);
        close(ring_fd as int);
        return -1;
    }

    var ev: EpollEvent = uninit;
    ev.events = EPOLLIN | EPOLLET;
    ev.data = (*w).id as u64;
    if (epoll_ctl(g_epfd, EPOLL_CTL_ADD, efd, &ev as *void) < 0) {
        var err_p: string = "Failed to add io_uring eventfd to epoll\0";
        puts(&err_p[0] as *char);
        close(efd);
        close(ring_fd as int);
        return -1;
    }
    (*w).hot = 1;

    var nr_files: i64 = g_nr_files;
    var files: *i32 = malloc(nr_files * 4) as *i32;
    i = 0;
    while (i < nr_files) { *(files + i) = -1; i = i + 1; }
    syscall(SYS_IO_URING_REGISTER, ring_fd, IORING_REGISTER_FILES, files as i64, nr_files, 0, 0);
    free(files as *void);

    var buf_mem: *u8 = mmap(nil, NBUFS * BUF_SZ, 3, 0x22, -1, 0) as *u8;
    var pbuf_ring_mem: *u8 = mmap(nil, NBUFS * 16, 3, 0x21, -1, 0) as *u8;
    (*w).pbuf_buf_mem = buf_mem;
    (*w).pbuf_ring_mem = pbuf_ring_mem;

    var reg: IoUringBufReg = uninit;
    reg.ring_addr = pbuf_ring_mem as u64;
    reg.ring_entries = NBUFS as u32;
    reg.bgid = 0 as u16;
    reg.flags = 0 as u16;
    reg.resv1 = 0 as u64;
    reg.resv2 = 0 as u64;
    reg.resv3 = 0 as u64;
    syscall(SYS_IO_URING_REGISTER, ring_fd, IORING_REGISTER_PBUF_RING, &reg as i64, 1, 0, 0);

    var pbufs: *IoUringBuf = pbuf_ring_mem as *IoUringBuf;
    i = 0;
    while (i < NBUFS) {
        var b: *IoUringBuf = pbufs + i;
        (*b).addr = (buf_mem + (i * BUF_SZ)) as u64;
        (*b).len = BUF_SZ as u32;
        (*b).bid = i as u16;
        (*b).resv = 0 as u16;
        i = i + 1;
    }
    var ptail: *u16 = (pbuf_ring_mem + 14) as *u16;
    *ptail = NBUFS as u16;
    (*w).ptail_ptr = ptail;

    var sq_size: i64 = (params.sq_off.array as i64) + ((params.sq_entries as i64) * 4);
    var sq_ptr: *u8 = mmap(nil, sq_size, 3, 1, ring_fd as int, 0) as *u8;
    var cq_size: i64 = (params.cq_off.cqes as i64) + ((params.cq_entries as i64) * 16);
    var cq_ptr: *u8 = mmap(nil, cq_size, 3, 1, ring_fd as int, 0x8000000) as *u8;
    var sqe_size: i64 = (params.sq_entries as i64) * 64;
    var sqes: *IoUringSqe = mmap(nil, sqe_size, 3, 1, ring_fd as int, 0x10000000) as *IoUringSqe;

    (*w).sq_ptr = sq_ptr;
    (*w).cq_ptr = cq_ptr;
    (*w).sqes = sqes;
    (*w).sq_head = (sq_ptr + (params.sq_off.head as i64)) as *u32;
    (*w).sq_tail = (sq_ptr + (params.sq_off.tail as i64)) as *u32;
    (*w).sq_mask = (sq_ptr + (params.sq_off.ring_mask as i64)) as *u32;
    (*w).sq_flags = (sq_ptr + (params.sq_off.flags as i64)) as *u32;
    (*w).sq_array = (sq_ptr + (params.sq_off.array as i64)) as *u32;
    (*w).cq_head = (cq_ptr + (params.cq_off.head as i64)) as *u32;
    (*w).cq_tail = (cq_ptr + (params.cq_off.tail as i64)) as *u32;
    (*w).cq_mask = (cq_ptr + (params.cq_off.ring_mask as i64)) as *u32;
    (*w).cqes = (cq_ptr + (params.cq_off.cqes as i64)) as *IoUringCqe;

    var conns_mem: *Conn = malloc(nr_files * (48 as i64)) as *Conn;
    i = 0;
    while (i < nr_files) {
        var c: *Conn = conns_mem + i;
        (*c).state = 0 as u32;
        (*c).gen = 1 as u32;
        (*c).send_arena = nil;
        (*c).send_off = 0 as u32;
        (*c).send_len = 0 as u32;
        (*c).sent = 0 as u32;
        (*c).input.ptr = nil; (*c).input.len = 0 as u32; (*c).input.cap = 0 as u32;
        i = i + 1;
    }
    (*w).conns = conns_mem;
    (*w).open_conns = 0;
    (*w).accept_gen = 1 as u32;
    (*w).body_buf = malloc(65536) as *char;
    (*w).dirty_count = 0;
    (*w).held_count = 0;
    (*w).rearm_cap = nr_files as int;
    (*w).rearm_fds = malloc(nr_files * 4) as *i32;
    (*w).rearm_head = 0;
    (*w).rearm_tail = 0;
    (*w).nslots = nr_files as int;
    (*w).accept_armed = 0;
    (*w).accept_cancelling = 0;
    return 0;
}

func ring_needs_enter(w: *WorkerState) -> int {
    if (*((*w).sq_tail) != *((*w).sq_head)) { return 1; }
    if ((*w).hot != 0) { return 1; }
    var sqf: u32 = *((*w).sq_flags);
    if ((sqf & (IORING_SQ_TASKRUN | IORING_SQ_CQ_OVERFLOW)) != (0 as u32)) { return 1; }
    if (*((*w).cq_head) != *((*w).cq_tail)) { return 1; }
    return 0;
}

func handle_ring_cqe(w: *WorkerState, cqe: *IoUringCqe) -> void {
    var buf_mem: *u8 = (*w).pbuf_buf_mem;
    var pbufs: *IoUringBuf = (*w).pbuf_ring_mem as *IoUringBuf;
    var udata: u64 = (*cqe).user_data;
    var res: i32 = (*cqe).res;
    var flags: u32 = (*cqe).flags;

    if ((udata & (255 as u64)) == (1 as u64)) {
        var listener: int = ((udata >> 8) & 255 as u64) as int;
        var bit: int = 1 << listener;
        if ((flags & (2 as u32)) == (0 as u32)) {
            (*w).accept_armed = (*w).accept_armed & (~bit);
            (*w).accept_cancelling = (*w).accept_cancelling & (~bit);
        }
        if (res >= 0) {
            var direct_fd: i32 = res;
            if (direct_fd >= (*w).nslots) { return; }
            var c: *Conn = (*w).conns + (direct_fd as i64);
            (*c).state = CONN_LIVE;
            (*c).gen = (*c).gen + (1 as u32);
            (*c).send_arena = nil;
            (*c).send_off = 0 as u32;
            (*c).send_len = 0 as u32;
            (*c).sent = 0 as u32;
            (*c).last_active = time(nil) as u32;
            (*c).input.ptr = nil; (*c).input.len = 0 as u32; (*c).input.cap = 0 as u32;
            (*w).open_conns = (*w).open_conns + 1;
            // Watch for readability; arm a one-shot receive only after poll.
            queue_poll_sqe(w, direct_fd);
        } else if (res != -23 && res != -24 && res != -125) {
        }
    } else if ((udata & (255 as u64)) == (4 as u64)) {
        var direct_fd: i32 = ((udata >> 8) & 0xffffff) as i32;
        var gen: u32 = (udata >> 32) as u32;
        var c: *Conn = (*w).conns + (direct_fd as i64);
        var live: int = (((*c).state & CONN_LIVE) != (0 as u32)) as int;
        if (live == 1 && (*c).gen != gen) { live = 0; }
        if (live == 0) { return; }
        if (res < 0) {
            (*c).state = (*c).state | CONN_CLOSING;
            mark_conn_dirty(w, direct_fd);
            return;
        }
        var mask: u32 = res as u32;
        if ((mask & (POLLERR | POLLHUP | POLLRDHUP)) != (0 as u32)) {
            (*c).state = (*c).state | CONN_CLOSING;
            mark_conn_dirty(w, direct_fd);
            return;
        }
        if ((mask & POLLIN) != (0 as u32) &&
            ((*c).state & (CONN_RECEIVING | CONN_REARM | CONN_CLOSING)) == (0 as u32)) {
            queue_recv_sqe(w, direct_fd);
        }
        if ((flags & (2 as u32)) == (0 as u32) &&
            ((*c).state & CONN_CLOSING) == (0 as u32)) {
            queue_poll_sqe(w, direct_fd);
        }
    } else if ((udata & (255 as u64)) == (2 as u64)) {
        var direct_fd: i32 = ((udata >> 8) & 0xffffff) as i32;
        var gen: u32 = (udata >> 32) as u32;
        var c: *Conn = (*w).conns + (direct_fd as i64);
        var has_buf: int = ((flags & (1 as u32)) != (0 as u32)) as int;
        var bid: u16 = 0 as u16;
        if (has_buf == 1) {
            var flag_int: int = flags as int;
            bid = ((flag_int >> 16) & 65535) as u16;
        }

        var live: int = (((*c).state & CONN_LIVE) != (0 as u32)) as int;
        if (live == 1 && (*c).gen != gen) { live = 0; }
        if (live == 1) {
            if ((flags & (2 as u32)) == (0 as u32)) {
                (*c).state = (*c).state & (~CONN_RECEIVING);
            }
            if (res > 0) {
                (*c).last_active = time(nil) as u32;
                if (((*c).state & CONN_CLOSING) == (0 as u32)) {
                    process_incoming_data(w, direct_fd, (buf_mem + ((bid as i64) * BUF_SZ)) as *char, res);
                }
            }
        }

        if (has_buf == 1) {
            var cur_tail: u16 = *((*w).ptail_ptr);
            var b: *IoUringBuf = pbufs + ((cur_tail as i64) & ((NBUFS - 1) as i64));
            (*b).addr = (buf_mem + ((bid as i64) * BUF_SZ)) as u64;
            (*b).len = BUF_SZ as u32;
            (*b).bid = bid;
            (*b).resv = 0 as u16;
            *((*w).ptail_ptr) = (cur_tail + 1 as u16);
        }
        if (live == 0) { return; }
        if (res > 0) {
            // One-shot receive: the poll stays armed and will announce new
            // bytes. If the provided buffer filled, drain immediately.
            if (res == (BUF_SZ as i32) &&
                ((*c).state & CONN_LIVE) != (0 as u32) &&
                ((*c).state & (CONN_CLOSING | CONN_REARM)) == (0 as u32)) {
                queue_recv_sqe(w, direct_fd);
            }
            return;
        }
        if (res == -105) { // ENOBUFS: retry after this batch's buffers return
            if (((*c).state & CONN_REARM) == (0 as u32)) {
                (*c).state = (*c).state | CONN_REARM;
                rearm_push(w, direct_fd);
            }
            return;
        }
        // EOF or a socket error. Defer the close until after the batch: a
        // request decoded from an earlier CQE may still need its response.
        (*c).state = (*c).state | CONN_CLOSING;
        mark_conn_dirty(w, direct_fd);
    } else if ((udata & (255 as u64)) == (3 as u64)) {
        var direct_fd: i32 = ((udata >> 8) & 0xffffff) as i32;
        var gen: u32 = (udata >> 32) as u32;
        var c: *Conn = (*w).conns + (direct_fd as i64);
        if (((*c).state & CONN_LIVE) != (0 as u32) && (*c).gen == gen) {
            (*c).state = (*c).state & (~CONN_SENDING);
            if (res <= 0) {
                (*c).state = (*c).state | CONN_CLOSING;
                if ((*c).send_arena != nil) {
                    arena_unref((*c).send_arena);
                    (*c).send_arena = nil;
                }
                queue_close_sqe(w, direct_fd);
            } else {
                (*c).sent = (*c).sent + (res as u32);
                if ((*c).sent < (*c).send_len) {
                    queue_send_sqe(w, direct_fd);
                } else {
                    // The whole response left the arena; only now may the
                    // arena be reused.
                    if ((*c).send_arena != nil) {
                        arena_unref((*c).send_arena);
                        (*c).send_arena = nil;
                    }
                    (*c).sent = 0 as u32;
                    (*c).send_off = 0 as u32;
                    (*c).send_len = 0 as u32;
                    if (((*c).state & CONN_CLOSING) != (0 as u32)) {
                        queue_close_sqe(w, direct_fd);
                    } else if ((*c).input.len > (0 as u32) &&
                               ((*c).state & (CONN_HOLD | CONN_READY | CONN_REPLIED)) == (0 as u32)) {
                        queue_ready(w, direct_fd);
                    }
                    // Poll remains armed; no receive is needed for idle time.
                }
            }
        }
    }
}

func reap_ring(w: *WorkerState) -> int {
    var head: u32 = *((*w).cq_head);
    var tail: u32 = *((*w).cq_tail);
    var mask: u32 = *((*w).cq_mask);
    var cqes_arr: *IoUringCqe = (*w).cqes;
    var n: int = 0;
    while (head != tail && n < CQE_BUDGET) {
        var idx: i64 = (head & mask) as i64;
        handle_ring_cqe(w, cqes_arr + idx);
        head = head + 1;
        n = n + 1;
        if (head == tail) {
            tail = *((*w).cq_tail);
        }
    }
    *((*w).cq_head) = head;
    return n;
}

// Submit pending SQEs and collect CQEs. This is where DEFER_TASKRUN work runs.
func service_ring(w: *WorkerState) -> int {
    if (ring_needs_enter(w) == 0) { return 0; }
    var to_sub: u32 = *((*w).sq_tail) - *((*w).sq_head);
    syscall(SYS_IO_URING_ENTER, (*w).ring_fd as i64, to_sub as i64, 0 as i64, IORING_ENTER_GETEVENTS, 0, 0);
    (*w).hot = 0;
    return reap_ring(w);
}

func execute_job(j: *Job) -> void {
    var w: *WorkerState = g_states + (j->ring as i64);
    var c: *Conn = (*w).conns + (j->fd as i64);
    if (((*c).state & CONN_LIVE) == (0 as u32) || (*c).gen != j->gen) { return; }

    if (j->preset != (0 as u8)) {
        append_response(w, j->fd, j->status, 0, j->body, j->body_len);
        (*c).state = (*c).state | CONN_CLOSING;
        mark_conn_dirty(w, j->fd);
        return;
    }

    var status_code: int = 200;
    var is_write: int = 0;
    var resp_len: int = handle_request(j->method, j->path, j->auth, j->body, j->body_len,
                                       (*w).body_buf, 65536, &status_code, &is_write);
    var keep_alive: int = 1;
    if (j->close_after != (0 as u8)) { keep_alive = 0; }
    append_response(w, j->fd, status_code, keep_alive, (*w).body_buf, resp_len);
    if (j->close_after != (0 as u8)) {
        (*c).state = (*c).state | CONN_CLOSING;
        mark_conn_dirty(w, j->fd);
    }
}

// After the commit, hand every reply to its ring straight from the batch
// arena. Each send takes an arena reference, so an arena is not reused until
// the kernel has sent every byte that points into it.
func flush_replies(commit_failed: int) -> void {
    var body500: [char; 256] = uninit;
    var b500: int = 0;
    if (commit_failed != 0) {
        var msg: string = "internal server error\0";
        b500 = write_error(&body500[0] as *char, 256, &msg[0] as *char);
    }
    var i: int = 0;
    while (i < g_nreplies) {
        var rp: *Reply = g_replies + (i as i64);
        var w: *WorkerState = g_states + ((*rp).ring as i64);
        var c: *Conn = (*w).conns + ((*rp).fd as i64);
        if (((*c).state & CONN_LIVE) != (0 as u32) && (*c).gen == (*rp).gen) {
            var a: *Arena = (*rp).arena;
            var off: u32 = (*rp).off;
            var len: u32 = (*rp).len;
            if (commit_failed != 0) {
                var p: *char = arena_reserve(512 as u32);
                var n: int = build_response(p, 512, 500, 1, &body500[0] as *char, b500);
                arena_advance(n as u32);
                a = g_cur_arena;
                off = (p as i64 - arena_data(a) as i64) as u32;
                len = n as u32;
            }
            (*c).send_arena = a;
            (*a).refs = (*a).refs + 1;
            (*c).send_off = off;
            (*c).send_len = len;
            (*c).sent = 0 as u32;
            (*c).state = (*c).state & (~CONN_REPLIED);
            queue_send_sqe(w, (*rp).fd);
        }
        i = i + 1;
    }
    g_nreplies = 0;
    arena_batch_release();
}

func rearm_ring(w: *WorkerState) -> void {
    var budget: int = CQE_BUDGET;
    while (budget > 0) {
        var r_fd: i32 = rearm_pop(w);
        if (r_fd < 0) { break; }
        var c: *Conn = (*w).conns + (r_fd as i64);
        if (((*c).state & CONN_REARM) != (0 as u32)) {
            (*c).state = (*c).state & (~CONN_REARM);
            if (((*c).state & CONN_LIVE) != (0 as u32) &&
                ((*c).state & CONN_CLOSING) == (0 as u32) &&
                ((*c).state & CONN_RECEIVING) == (0 as u32)) {
                queue_recv_sqe(w, r_fd);
            }
        }
        budget = budget - 1;
    }
}

// One global batch: every CQE from every ring has already been decoded into
// g_jobs. Reads run first from one snapshot, then writes, then exactly one
// bt_end_batch() and one COMMIT. Responses are released only afterwards.
func run_global_batch() -> void {
    if (g_njobs > 0) {
        ensure_db_txn();
        var pass: int = 0;
        while (pass < 2) {
            var i: int = 0;
            while (i < g_njobs) {
                var j: *Job = g_jobs + (i as i64);
                if ((j->is_write as int) == pass) { execute_job(j); }
                i = i + 1;
            }
            pass = pass + 1;
        }

        bt_end_batch();

        var commit_rc: int = 101;
        if (g_in_txn == 1) {
            var stmt_c: *void = g_stmt_commit;
            commit_rc = sqlite3_step(stmt_c);
            sqlite3_reset(stmt_c);
            g_in_txn = 0;
            if (commit_rc != 101) {
                var stmt_rb: *void = g_stmt_rollback;
                sqlite3_step(stmt_rb);
                sqlite3_reset(stmt_rb);
            }
        }

        var k: int = 0;
        flush_replies((commit_rc != 101) as int);
        while (k < g_nworkers) {
            var w: *WorkerState = g_states + (k as i64);
            flush_pending(w);
            rearm_ring(w);
            k = k + 1;
        }
    } else {
        flush_replies(0);
        var k: int = 0;
        while (k < g_nworkers) {
            var w: *WorkerState = g_states + (k as i64);
            flush_pending(w);
            rearm_ring(w);
            k = k + 1;
        }
    }
    arena_reset();
    wal_bound_check();
}

// Connections held at a write (or at a full arena) continue only after the
// batch committed and its responses were released.
func release_holds(w: *WorkerState) -> void {
    var n: int = (*w).held_count;
    if (n == 0) { return; }
    var fds: [i32; 4096] = uninit;
    memcpy(&fds[0] as *void, &(*w).held_fds[0] as *void, (n as i64) * 4);
    (*w).held_count = 0;
    var k: int = 0;
    while (k < n) {
        var fd: i32 = fds[k];
        var c: *Conn = (*w).conns + (fd as i64);
        if (((*c).state & CONN_HOLD) != (0 as u32)) {
            (*c).state = (*c).state & (~CONN_HOLD);
            if (((*c).state & CONN_LIVE) != (0 as u32) &&
                ((*c).state & (CONN_CLOSING | CONN_SENDING | CONN_REPLIED)) == (0 as u32)) {
                process_incoming_data(w, fd, nil, 0);
            }
        }
        k = k + 1;
    }
}

// Buffered pipelined bytes from an earlier send are parsed in the next batch,
// one request per connection.
func run_ready() -> void {
    var end: int = g_ready_tail;
    while (g_ready_head < end) {
        var e: *ConnRef = g_ready + (g_ready_head as i64);
        var fd: i32 = (*e).fd;
        var ring: int = (*e).ring;
        var gen: u32 = (*e).gen;
        g_ready_head = g_ready_head + 1;
        if (ring < 0 || ring >= g_nworkers) { continue; }
        var w: *WorkerState = g_states + (ring as i64);
        var c: *Conn = (*w).conns + (fd as i64);
        if ((*c).gen != gen || ((*c).state & CONN_LIVE) == (0 as u32) ||
            ((*c).state & (CONN_CLOSING | CONN_SENDING | CONN_HOLD | CONN_REPLIED)) != (0 as u32)) {
            continue;
        }
        (*c).state = (*c).state & (~CONN_READY);
        if ((*c).input.len > (0 as u32)) { process_incoming_data(w, fd, nil, 0); }
    }
    if (g_ready_head == g_ready_tail) {
        g_ready_head = 0;
        g_ready_tail = 0;
    } else if (g_ready_head > 0) {
        var left: int = g_ready_tail - g_ready_head;
        memmove(g_ready as *void, (g_ready + (g_ready_head as i64)) as *void, (left as i64) * 12);
        g_ready_tail = left;
        g_ready_head = 0;
    }
}

// ---------- listeners, rings and idle sweep ----------

func create_listener() -> int {
    if (g_listener_count >= N_LISTEN) { return -1; }
    var sfd: int = socket(2, 1, 0);
    if (sfd < 0) { return -1; }
    var opt: int = 1;
    setsockopt(sfd, 1, 2, &opt as *void, 4);
    setsockopt(sfd, 1, 15, &opt as *void, 4);
    setsockopt(sfd, 6, 1, &opt as *void, 4);

    var addr: SockAddrIn = uninit;
    addr.sin_family = 2 as u16;
    addr.sin_port = htons(g_port as u16);
    if (g_host_ptr != nil && strcmp(g_host_ptr, "0.0.0.0\0") != 0) {
        inet_pton(2, g_host_ptr, &addr.sin_addr as *void);
    } else {
        addr.sin_addr = 0 as u32;
    }
    var sin_i: int = 0;
    while (sin_i < 8) { addr.sin_zero[sin_i] = 0 as u8; sin_i = sin_i + 1; }

    if (bind(sfd, &addr as *void, 16) < 0) { close(sfd); return -1; }
    if (listen(sfd, 65535) < 0) { close(sfd); return -1; }
    g_listen_fds[g_listener_count] = sfd;
    g_listener_count = g_listener_count + 1;
    return 0;
}

func arm_accepts(w: *WorkerState) -> void {
    var l: int = 0;
    while (l < g_listener_count) {
        var bit: int = 1 << l;
        if (((*w).accept_armed & bit) == 0 && ((*w).accept_cancelling & bit) == 0) {
            queue_accept_sqe(w, l);
            (*w).accept_armed = (*w).accept_armed | bit;
        }
        l = l + 1;
    }
}

func cancel_accepts(w: *WorkerState) -> void {
    var ring_id: int = (*w).id;
    var l: int = 0;
    while (l < g_listener_count) {
        var bit: int = 1 << l;
        if (((*w).accept_armed & bit) != 0 && ((*w).accept_cancelling & bit) == 0) {
            var target: u64 = (1 as u64) | ((l as u64) << 8) | ((ring_id as u64) << 16);
            queue_cancel_sqe(w, target);
            (*w).accept_cancelling = (*w).accept_cancelling | bit;
        }
        l = l + 1;
    }
}

// #1's accept policy exactly: make the next ring when the last is within
// ACCEPT_NEXT slots of full; accept on the lowest ring with room, and also on
// the next ring once the lowest is within ACCEPT_NEXT of full; cancel a
// ring's accepts ACCEPT_STOP slots before its table is full.
func accept_policy() -> void {
    if (g_nworkers < g_nr_max && g_ring_grow_failed == 0) {
        var last: *WorkerState = g_states + ((g_nworkers - 1) as i64);
        if ((*last).open_conns + ACCEPT_NEXT >= (*last).nslots) {
            var nw: *WorkerState = g_states + (g_nworkers as i64);
            (*nw).id = g_nworkers;
            if (init_ring(nw) == 0) {
                g_nworkers = g_nworkers + 1;
            } else {
                g_ring_grow_failed = 1;
            }
        }
    }

    var lowest: int = -1;
    var i: int = 0;
    while (i < g_nworkers) {
        var w: *WorkerState = g_states + (i as i64);
        if ((*w).open_conns + ACCEPT_STOP < (*w).nslots) { lowest = i; break; }
        i = i + 1;
    }

    i = 0;
    while (i < g_nworkers) {
        var w: *WorkerState = g_states + (i as i64);
        var room: int = (((*w).open_conns + ACCEPT_STOP) < (*w).nslots) as int;
        var want: int = 0;
        if (room == 1) {
            if (i == lowest) {
                want = 1;
            } else if (i == lowest + 1) {
                var low: *WorkerState = g_states + (lowest as i64);
                if ((*low).open_conns + ACCEPT_NEXT >= (*low).nslots) { want = 1; }
            }
        }
        if (want == 1) {
            arm_accepts(w);
        } else if (room == 0) {
            cancel_accepts(w);
        }
        i = i + 1;
    }
    if (lowest < 0) {
        i = 0;
        while (i < g_nworkers) { cancel_accepts(g_states + (i as i64)); i = i + 1; }
    }
}

func sweep_connections() {
    var now_s: i64 = time(nil);
    var i: int = 0;
    while (i < g_nworkers) {
        var w: *WorkerState = g_states + (i as i64);
        if ((*w).open_conns > 0) {
            var budget: int = 1024;
            var fd: int = 0;
            while (fd < (*w).nslots && budget > 0) {
                var c: *Conn = (*w).conns + (fd as i64);
                if (((*c).state & CONN_LIVE) != (0 as u32) &&
                    ((*c).state & (CONN_CLOSING | CONN_SENDING | CONN_HOLD | CONN_READY | CONN_REPLIED)) == (0 as u32)) {
                    if (now_s - ((*c).last_active as i64) > (IDLE_SECONDS as i64)) {
                        queue_close_sqe(w, fd);
                        budget = budget - 1;
                    }
                }
                fd = fd + 1;
            }
        }
        i = i + 1;
    }
}

func multi_worker_loop(arg: *void) -> *void {
    var states: *WorkerState = arg as *WorkerState;
    g_states = states;
    g_nworkers = 0;
    var i: int = 0;
    // Ring 0 now; later rings are made by accept_policy as connections need
    // them, so rings that never fill cost no kernel memory.
    var w0: *WorkerState = states;
    (*w0).id = 0;
    if (init_ring(w0) == 0) { g_nworkers = 1; }
    if (g_nworkers < 1) {
        var err_n: string = "Failed to create the first io_uring ring\0";
        puts(&err_n[0] as *char);
        exit(1);
    }
    accept_policy();

    var evs: [EpollEvent; 16] = uninit;
    while (1 == 1) {
        var now_s: i64 = time(nil);
        if (now_s - g_last_sweep >= (SWEEP_SEC as i64)) {
            sweep_connections();
            g_last_sweep = now_s;
        }

        g_answers_left = ANSWERS_PER_BATCH - g_njobs;
        if (g_answers_left < 0) { g_answers_left = 0; }

        var serviced: int = 0;
        i = 0;
        while (i < g_nworkers) {
            serviced = serviced + service_ring(states + (i as i64));
            i = i + 1;
        }

        // Parse buffered pipelined bytes from connections whose previous
        // response has been sent. One request per connection this batch.
        run_ready();

        // All rings have contributed their CQEs to this one batch.
        run_global_batch();

        g_answers_left = ANSWERS_PER_BATCH;
        i = 0;
        while (i < g_nworkers) {
            release_holds(states + (i as i64));
            i = i + 1;
        }
        accept_policy();

        if (serviced > 0 || g_njobs > 0) { continue; }

        var pending_submit: int = 0;
        var held_any: int = 0;
        i = 0;
        while (i < g_nworkers) {
            var sw: *WorkerState = states + (i as i64);
            if (*((*sw).sq_tail) != *((*sw).sq_head)) { pending_submit = 1; }
            if ((*sw).held_count > 0) { held_any = 1; }
            i = i + 1;
        }
        if (pending_submit == 1) { continue; }

        // Idle: clear the ring eventfds, then sleep until a ring has work or
        // the idle sweep is due. Held connections spin on a short timeout
        // rather than sleeping with a request still in their buffer.
        i = 0;
        while (i < g_nworkers) {
            var dw: *WorkerState = states + (i as i64);
            var v: u64 = 0 as u64;
            while (read((*dw).efd, &v as *void, 8 as i64) == 8 as i64) { }
            i = i + 1;
        }
        // A completion may have been posted between the last reap and the
        // drain above. If so, service it now instead of sleeping on a signal
        // that was just consumed.
        var raced: int = 0;
        i = 0;
        while (i < g_nworkers) {
            if (ring_needs_enter(states + (i as i64)) == 1) { raced = 1; }
            i = i + 1;
        }
        if (raced == 1) { continue; }

        var wait_ms: int = SWEEP_SEC * 1000;
        if (held_any == 1) { wait_ms = 1; }
        var n: int = epoll_wait(g_epfd, &evs[0] as *void, 16, wait_ms);
        if (n < 0) { continue; }
        var k: int = 0;
        while (k < n) {
            var wid: i64 = evs[k].data as i64;
            var ew: *WorkerState = states + wid;
            (*ew).hot = 1;
            var v2: u64 = 0 as u64;
            while (read((*ew).efd, &v2 as *void, 8 as i64) == 8 as i64) { }
            k = k + 1;
        }
    }
    return nil;
}

func _start() -> void {
    var host_env: *char = getenv("HOST\0");
    var port_env: *char = getenv("PORT\0");
    var db_env: *char = getenv("SQLITE_PATH\0");
    var secret_env: *char = getenv("JWT_SECRET\0");

    var port: int = 80;
    if (port_env != nil) {
        port = atoi(port_env);
    }
    if (db_env == nil) {
        var def_db: string = "db.sqlite\0";
        db_env = &def_db[0] as *char;
    }
    if (secret_env == nil) {
        var def_sec: string = "secret\0";
        secret_env = &def_sec[0] as *char;
    }
    g_secret_ptr = secret_env;
    g_start_time = time(nil);
    g_last_ckpt = g_start_time;

    var lim: RLimit = uninit;
    getrlimit(7, &lim as *void);
    if (lim.rlim_cur < lim.rlim_max) {
        lim.rlim_cur = lim.rlim_max;
        setrlimit(7, &lim as *void);
    }
    getrlimit(7, &lim as *void);
    var target_slots: i64 = 350000 as i64;
    var per_ring_cap: i64 = 65535 as i64;
    var slots: i64 = lim.rlim_cur as i64;
    if (slots > per_ring_cap) { slots = per_ring_cap; }
    if (slots > target_slots) { slots = target_slots; }
    if (slots > (256 as i64)) { slots = slots - (64 as i64); } // ordinary fds
    if (slots < (256 as i64)) { slots = 256 as i64; }

    var workers: int = ((target_slots + slots - (1 as i64)) / slots) as int;
    if (workers > RING_MAX) { workers = RING_MAX; }
    if (workers < 1) { workers = 1; }

    g_nr_files = slots;
    g_nr_max = workers;
    g_host_ptr = host_env;
    g_port = port;
    g_last_sweep = time(nil);

    // Ready list: buffered pipelined bytes waiting for their turn. The
    // response arenas are the only response storage.
    g_ready_cap = ((g_nr_max as int) * (g_nr_files as int)) + 8192;
    g_ready = malloc((g_ready_cap as i64) * 12) as *ConnRef;
    g_ready_head = 0;
    g_ready_tail = 0;
    if (g_ready == nil) {
        var err_rd: string = "Failed to allocate the ready list\0";
        puts(&err_rd[0] as *char);
        exit(1);
    }
    g_replies = malloc((MAX_REPLIES as i64) * (32 as i64)) as *Reply;
    g_nreplies = 0;
    if (g_replies == nil) {
        var err_rp: string = "Failed to allocate the reply list\0";
        puts(&err_rp[0] as *char);
        exit(1);
    }
    arenas_prewarm();

    g_epfd = epoll_create1(EPOLL_CLOEXEC);
    if (g_epfd < 0) {
        var err_ep: string = "Failed to create epoll instance\0";
        puts(&err_ep[0] as *char);
        exit(1);
    }

    jwt_hmac_init(secret_env);

    var db_ptr: *void = nil;
    var vfs_name: string = "unix-excl\0";
    var rc: int = sqlite3_open_v2(db_env, &db_ptr, 2 | 4, &vfs_name[0] as *char);
    if (rc != 0) {
        var err_m: string = "Failed to open SQLite database\0";
        puts(&err_m[0] as *char);
        exit(1);
    }
    g_db = db_ptr;

    // 8 MB page cache, no memory map: a hit returns from SQLite's own cache
    // instead of first probing the WAL index; the cache is memory the kernel
    // cannot reclaim, so it is kept small at the memory wall.
    var pragma_sql: string = "PRAGMA journal_mode=WAL; PRAGMA synchronous=NORMAL; PRAGMA locking_mode=NORMAL; PRAGMA busy_timeout=5000; PRAGMA foreign_keys=ON; PRAGMA cache_size=-8192; PRAGMA cache_spill=OFF; PRAGMA mmap_size=0; PRAGMA wal_autocheckpoint=0;\0";
    sqlite3_exec(db_ptr, &pragma_sql[0] as *char, nil, nil, nil);
    sqlite3_wal_hook(db_ptr, &on_wal_hook as *void, nil);

    var page_size: int = 4096;
    var stmt_ps: *void = nil;
    var ps_sql: string = "PRAGMA page_size;\0";
    if (sqlite3_prepare_v2(db_ptr, &ps_sql[0] as *char, -1, &stmt_ps, nil) == 0) {
        if (sqlite3_step(stmt_ps) == 100) { page_size = sqlite3_column_int(stmt_ps, 0); }
        sqlite3_finalize(stmt_ps);
    }
    if (page_size <= 0) { page_size = 4096; }
    var high_frames: i64 = WAL_HIGH_BYTES / ((page_size as i64) + (24 as i64));
    if (high_frames < (WAL_CKPT_FRAMES as i64)) { high_frames = WAL_CKPT_FRAMES as i64; }
    if (high_frames > (2147480000 as i64)) { high_frames = 2147480000 as i64; }
    g_wal_high_frames = high_frames as int;

    checkpoint_start(db_env);

    var bt_rc: int = bt_init(db_ptr);
    if (bt_rc != 0) {
        var bt_err: string = "Failed to initialize native B-tree read plans\0";
        puts(&bt_err[0] as *char);
        exit(1);
    }

    var db_fd: int = open(db_env, 0);
    if (db_fd >= 0) {
        posix_fadvise(db_fd, 0 as i64, 0 as i64, 3);
        close(db_fd);
    }
    g_feed_scratch = malloc(32768) as *char;
    g_job_arena = malloc(JOB_ARENA_SZ) as *char;
    if (g_job_arena == nil) {
        var err_ar: string = "Failed to allocate request batch arena\0";
        puts(&err_ar[0] as *char);
        exit(1);
    }
    g_jobs = malloc((MAX_JOBS as i64) * (96 as i64)) as *Job;

    var s_feed: string = "SELECT p.id, p.body, p.created_at, u.username, (SELECT count(*) FROM likes l WHERE l.post_id = p.id) FROM posts p JOIN users u ON u.id = p.user_id ORDER BY p.created_at DESC, p.id DESC LIMIT 20;\0";
    var stmt_f: *void = nil;
    sqlite3_prepare_v2(db_ptr, &s_feed[0] as *char, -1, &stmt_f, nil);
    g_stmt_feed = stmt_f;

    var s_feed_ids: string = "SELECT id FROM posts ORDER BY created_at DESC, id DESC LIMIT 20;\0";
    var stmt_fids: *void = nil;
    sqlite3_prepare_v2(db_ptr, &s_feed_ids[0] as *char, -1, &stmt_fids, nil);
    g_stmt_feed_ids = stmt_fids;

    var s_feed_likes: string = "SELECT post_id FROM likes WHERE post_id BETWEEN ?1 AND ?2;\0";
    var stmt_flikes: *void = nil;
    sqlite3_prepare_v2(db_ptr, &s_feed_likes[0] as *char, -1, &stmt_flikes, nil);
    g_stmt_feed_likes = stmt_flikes;

    var s_feed_rows: string = "SELECT p.id, p.body, p.created_at, u.username FROM posts p JOIN users u ON u.id = p.user_id WHERE p.id BETWEEN ?1 AND ?2;\0";
    var stmt_frows: *void = nil;
    sqlite3_prepare_v2(db_ptr, &s_feed_rows[0] as *char, -1, &stmt_frows, nil);
    g_stmt_feed_rows = stmt_frows;

    var s_post: string = "SELECT p.id, p.body, p.created_at, u.username, (SELECT count(*) FROM likes l WHERE l.post_id = p.id) FROM posts p JOIN users u ON u.id = p.user_id WHERE p.id = ?;\0";
    var stmt_p: *void = nil;
    sqlite3_prepare_v2(db_ptr, &s_post[0] as *char, -1, &stmt_p, nil);
    g_stmt_post = stmt_p;

    var s_health: string = "SELECT 1;\0";
    var stmt_h: *void = nil;
    sqlite3_prepare_v2(db_ptr, &s_health[0] as *char, -1, &stmt_h, nil);
    g_stmt_health = stmt_h;

    var s_chk: string = "SELECT 1 FROM posts WHERE id = ?;\0";
    var stmt_c: *void = nil;
    sqlite3_prepare_v2(db_ptr, &s_chk[0] as *char, -1, &stmt_c, nil);
    g_stmt_check_post = stmt_c;

    var s_le: string = "SELECT 1 FROM likes WHERE user_id = ?1 AND post_id = ?2 LIMIT 1;\0";
    var stmt_le: *void = nil;
    sqlite3_prepare_v2(db_ptr, &s_le[0] as *char, -1, &stmt_le, nil);
    g_stmt_like_exists = stmt_le;

    var s_insl: string = "INSERT INTO likes (user_id, post_id) SELECT ?1, ?2 WHERE EXISTS (SELECT 1 FROM posts WHERE id = ?2) ON CONFLICT (user_id, post_id) DO NOTHING;\0";
    var stmt_l: *void = nil;
    sqlite3_prepare_v2(db_ptr, &s_insl[0] as *char, -1, &stmt_l, nil);
    g_stmt_insert_like = stmt_l;

    var s_insp: string = "INSERT INTO posts (user_id, body) VALUES (?, ?) RETURNING id, created_at;\0";
    var stmt_ip: *void = nil;
    sqlite3_prepare_v2(db_ptr, &s_insp[0] as *char, -1, &stmt_ip, nil);
    g_stmt_insert_post = stmt_ip;

    var s_begin: string = "BEGIN;\0";
    var stmt_b: *void = nil;
    sqlite3_prepare_v2(db_ptr, &s_begin[0] as *char, -1, &stmt_b, nil);
    g_stmt_begin = stmt_b;

    var s_commit: string = "COMMIT;\0";
    var stmt_cm: *void = nil;
    sqlite3_prepare_v2(db_ptr, &s_commit[0] as *char, -1, &stmt_cm, nil);
    g_stmt_commit = stmt_cm;

    var s_rollback: string = "ROLLBACK;\0";
    var stmt_rb: *void = nil;
    sqlite3_prepare_v2(db_ptr, &s_rollback[0] as *char, -1, &stmt_rb, nil);
    g_stmt_rollback = stmt_rb;

    g_db_mutex = malloc(64);
    pthread_mutex_init(g_db_mutex, nil);

    // #1 creates all eight SO_REUSEPORT listeners at startup so their accept
    // queues aggregate backlog even before any ring exists. Rings are the
    // lazy part; all listeners are armed only on the ring(s) accept policy
    // selects.
    var li: int = 0;
    while (li < N_LISTEN) {
        if (create_listener() != 0) {
            var err_m: string = "Failed to bind listening socket\0";
            puts(&err_m[0] as *char);
            exit(1);
        }
        li = li + 1;
    }

    // Keep the binary's own code and data in RAM. They are file-backed and
    // are what reclaim takes first when there is no swap, which would make
    // the loop major-fault its own code while requests wait in the kernel.
    var locked: i64 = fast_lock_code();

    var worker_states: *WorkerState = malloc(((g_nr_max as i64) * (131072 as i64)) + 131072 as i64) as *WorkerState;
    if (worker_states == nil) {
        var err_ws: string = "Failed to allocate worker state\0";
        puts(&err_ws[0] as *char);
        exit(1);
    }
    var threads: [u64; 8] = [0 as u64, ...];

    pthread_create(&threads[0], nil, &multi_worker_loop as *void, worker_states as *void);

    var ready_msg: string = "Cider io_uring v4c running: multishot recv, lazy rings, arenas.\0";
    puts(&ready_msg[0] as *char);

    pthread_join(threads[0], nil);

    exit(0);
}
